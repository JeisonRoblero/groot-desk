# -----------------------------------------------------------------------------
# Install a distribution via command line
# -----------------------------------------------------------------------------
cmd_install() {
  local distro="$1"
  check_proot_distro

  if [ -z "$distro" ]; then
    print_error "Specify a distribution to install. Example: proot-desk install kali"
    exit 1
  fi

  # Check if already installed
  local installed
  installed=$(get_installed_distros)
  if echo "$installed" | grep -qx "$distro"; then
    print_warn "${distro} is already installed."
    exit 0
  fi

  # Validate distro is in our registry
  local available
  available=$(get_available_distros)
  if ! echo "$available" | grep -qx "$distro"; then
    print_error "Distribution '${distro}' is not supported. Supported distros:"
    echo "$available" | sed 's/^/  /'
    exit 1
  fi

  if is_proot_distro_v5; then
    local image="$distro"
    case "$distro" in
      kali)      image="kalilinux/kali-rolling" ;;
      void)      image="voidlinux/voidlinux" ;;
      artix)     image="artixlinux/artixlinux" ;;
      gentoo)    image="gentoo/stage3" ;;
      rocky)     image="rockylinux/rockylinux" ;;
      manjaro)   image="manjaronetwork/manjaro" ;;
      oracle)    image="oraclelinux" ;;
    esac
    print_step "Installing ${distro} from OCI image '${image}' (this may take a few minutes)..."
    log "Installing distro: $distro using image: $image"
    if proot-distro install --name "$distro" "$image"; then
      print_success "${distro} installed successfully."
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      exit 1
    fi
  else
    print_step "Installing ${distro} (this may take a few minutes)..."
    log "Installing distro: $distro"
    if proot-distro install "$distro"; then
      print_success "${distro} installed successfully."
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      exit 1
    fi
  fi
}

# -----------------------------------------------------------------------------
# Uninstall proot-desk itself (not the distros)
# -----------------------------------------------------------------------------
cmd_uninstall() {
  echo ""
  print_warn "This will remove proot-desk and its configurations. Installed distros will NOT be deleted."
  read -rp "$(echo -e "${YELLOW}Continue? [y/N]: ${RESET}")" confirm
  confirm="${confirm:-N}"
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Cancelled."
    return
  fi

  rm -rf "$CONFIG_DIR"
  rm -f "$PREFIX/bin/proot-desk"
  print_success "proot-desk removed. Installed distros remain intact."
  log "proot-desk uninstalled."
}

# -----------------------------------------------------------------------------
# Uninstall desktop environments from inside the distro
# -----------------------------------------------------------------------------
cmd_remove_desk() {
  local distro="$1"
  local de
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to remove the desktop from. Example: proot-desk remove-de kali"
    exit 1
  fi

  # Check if installed
  local installed
  installed=$(get_installed_distros)
  if ! echo "$installed" | grep -qx "$distro"; then
    print_error "Distro '${distro}' is not installed."
    exit 1
  fi

  init_de_metadata_for_distro "$distro"
  local last_de
  last_de=$(config_get_distro_field "$distro" "last_de")

  if [ -z "$last_de" ]; then
    print_warn "No recorded desktop environment for ${distro}."
    # Let the user choose which DE package to try to remove
    echo -e "${WHITE}Choose which desktop environment to remove:${RESET}"
    local i=1
    for de in "${DE_LIST[@]}"; do
      echo -e "  [${i}] ${de}"
      ((i++))
    done
    local choice=""
    read -rp "$(echo -e "${CYAN}Select [1-${#DE_LIST[@]}]: ${RESET}")" choice
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#DE_LIST[@]}" ]; then
      last_de="${DE_LIST[$((choice - 1))]}"
    else
      print_error "Invalid selection."
      exit 1
    fi
  fi

  local pm
  pm=$(get_distro_pkg_manager "$distro")
  local remove_cmd=""

  local purge_pkgs
  purge_pkgs=$(get_de_purge_packages "$distro" "$pm" "$last_de")

  print_warn "This will attempt to uninstall ${last_de} and its dependencies from ${distro}."
  read -rp "$(echo -e "${YELLOW}Continue? [y/N]: ${RESET}")" confirm
  confirm="${confirm:-N}"
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Cancelled."
    return
  fi

  cmd_stop "$distro"

  case "$pm" in
    apt)
      remove_cmd="to_purge=''; for pattern in $purge_pkgs; do pkgs=\$(dpkg-query -W -f='\${Package}\n' \"\$pattern\" 2>/dev/null | awk '{print \$1}'); if [ -n \"\$pkgs\" ]; then to_purge=\"\$to_purge \$pkgs\"; fi; done; if [ -n \"\$to_purge\" ]; then env DEBIAN_FRONTEND=noninteractive apt-get purge -y --allow-remove-essential \$to_purge; fi; env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y || true"
      ;;
    apk)
      remove_cmd="apk del $purge_pkgs || true"
      ;;
    pacman)
      remove_cmd="to_purge=''; for p in $purge_pkgs; do if pacman -Q \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; done; if [ -n \"\$to_purge\" ]; then pacman -Rns --noconfirm \$to_purge; fi"
      ;;
    dnf)
      remove_cmd="to_purge=''; for p in $purge_pkgs; do if [[ \"\$p\" =~ ^@ ]]; then g=\"\${p#@}\"; if dnf group list installed \"\$g\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; else if dnf list installed \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; fi; done; if [ -n \"\$to_purge\" ]; then dnf remove -y \$to_purge; fi"
      ;;
    xbps)
      remove_cmd="xbps-remove -Rfy $purge_pkgs 2>/dev/null || true"
      ;;
    emerge)
      remove_cmd="emerge --depclean $purge_pkgs 2>/dev/null || true"
      ;;
  esac

  print_step "Uninstalling packages inside ${distro}..."
  log "Removing DE package matching: $purge_pkgs from $distro"
  
  run_with_spinner "Uninstalling desktop packages" proot-distro login "$distro" -- bash -c "$remove_cmd"
  
  # Verification and force double-insurance deletion of start command if it remains
  if ! de_is_installed "$distro" "$last_de"; then
    print_success "Desktop environment '${last_de}' removed from ${distro}."
    config_set_distro_field "$distro" "last_de" ""
  else
    print_warn "Some remnants of '${last_de}' were not removed automatically. Attempting force cleanup..."
    local startcmd="${DE_STARTCMD[$last_de]}"
    proot-distro login "$distro" -- rm -f "/usr/bin/$startcmd" "/usr/local/bin/$startcmd" "/bin/$startcmd" 2>/dev/null || true
    
    if ! de_is_installed "$distro" "$last_de"; then
      print_success "Desktop environment '${last_de}' removed from ${distro}."
      config_set_distro_field "$distro" "last_de" ""
    else
      print_error "Failed to completely uninstall the desktop environment binary."
      exit 1
    fi
  fi
}

# -----------------------------------------------------------------------------
# Reset configuration settings for a distro
# -----------------------------------------------------------------------------
cmd_reset() {
  local distro="$1"
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to reset. Example: proot-desk reset kali"
    exit 1
  fi

  cmd_stop "$distro"

  if [ -f "$CONFIG_FILE" ]; then
    local tmpfile
    tmpfile=$(mktemp)
    if jq "del(.distros[\"${distro}\"])" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
      mv "$tmpfile" "$CONFIG_FILE"
      print_success "Reset configurations for ${distro}."
      log "Configurations reset for distro: $distro"
    else
      rm -f "$tmpfile"
      print_error "Failed to reset configurations for ${distro}."
      exit 1
    fi
  fi
}

# -----------------------------------------------------------------------------
# Delete distro completely with configurations
# -----------------------------------------------------------------------------
cmd_delete() {
  local distro="$1"
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to delete. Example: proot-desk delete kali"
    exit 1
  fi

  print_warn "This will completely delete the ${distro} container, desktop environments, and all settings!"
  read -rp "$(echo -e "${YELLOW}Are you absolutely sure? [y/N]: ${RESET}")" confirm
  confirm="${confirm:-N}"
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Cancelled."
    return
  fi

  cmd_stop "$distro"

  # Remove configurations from config.json
  if [ -f "$CONFIG_FILE" ]; then
    local tmpfile
    tmpfile=$(mktemp)
    if jq "del(.distros[\"${distro}\"])" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
      mv "$tmpfile" "$CONFIG_FILE"
      log "Configurations wiped for distro: $distro"
    else
      rm -f "$tmpfile"
    fi
  fi

  # Uninstall container filesystem
  print_step "Removing container filesystem for ${distro}..."
  if proot-distro remove "$distro"; then
    print_success "Distribution ${distro} and its configurations deleted successfully."
    log "Distribution and configurations deleted for distro: $distro"
  else
    print_error "Failed to uninstall distribution ${distro} from proot-distro."
    exit 1
  fi
}

