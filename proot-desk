#!/data/data/com.termux/files/usr/bin/bash

# =============================================================================
# proot-desk - Linux desktop manager for Termux
# =============================================================================

VERSION="1.0.1"
CONFIG_DIR="$HOME/.config/proot-desk"
CONFIG_FILE="$CONFIG_DIR/config.json"
LOG_FILE="$CONFIG_DIR/proot-desk.log"

# Define default Termux prefix if not set
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

is_proot_distro_v5() {
  # 1. Feature check: quiet mode -q is unique to modern v5.0+ list subcommand
  if proot-distro list -q &>/dev/null; then
    return 0
  fi
  # 2. Command check: OCI/image help terms in install subcommand help output
  if proot-distro install --help 2>&1 | grep -q -i -E "(image|registry|docker|oci)"; then
    return 0
  fi
  # 3. Shebang check: absolute path interpreter inspection
  local pd_path
  pd_path=$(command -v proot-distro 2>/dev/null)
  if [ -n "$pd_path" ] && [ -f "$pd_path" ]; then
    if head -n 1 "$pd_path" 2>/dev/null | grep -q -i "python"; then
      return 0
    fi
  fi
  return 1
}


# -----------------------------------------------------------------------------
# Colors
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# -----------------------------------------------------------------------------
# Print helpers
# -----------------------------------------------------------------------------
print_separator() {
  local char="${1:-═}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  [ "$cols" -gt 60 ] && cols=60
  local line=""
  local i
  for ((i=0; i<cols; i++)); do
    line+="$char"
  done
  echo "$line"
}

print_wrapped() {
  local indent="$1"
  local color="$2"
  local text="$3"
  local reset="${4:-$RESET}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 80)
  [ "$cols" -gt 60 ] && cols=60
  local plain_indent
  plain_indent=$(echo -e "$indent" | sed 's/\x1b\[[0-9;]*m//g')
  local max_w=$((cols - ${#plain_indent}))
  [ $max_w -lt 20 ] && max_w=20
  if command -v fold &>/dev/null; then
    echo "$text" | fold -s -w "$max_w" | while read -r line; do
      echo -e "${indent}${color}${line}${reset}"
    done
  else
    local words=($text)
    local line=""
    for word in "${words[@]}"; do
      if [ $((${#line} + ${#word} + 1)) -gt $max_w ]; then
        echo -e "${indent}${color}${line}${reset}"
        line="$word"
      else
        if [ -z "$line" ]; then
          line="$word"
        else
          line="$line $word"
        fi
      fi
    done
    [ -n "$line" ] && echo -e "${indent}${color}${line}${reset}"
  fi
}

print_box_top() {
  local color="$1"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="═"
  done
  echo -e "${color}╔${line}╗${RESET}"
}

print_box_bottom() {
  local color="$1"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="═"
  done
  echo -e "${color}╚${line}╝${RESET}"
}

print_box_sep() {
  local char="${1:-─}"
  local color="${2}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="$char"
  done
  echo -e "${color}╠${line}╣${RESET}"
}

print_box_line() {
  local align="$1"
  local border_color="$2"
  local text_color="$3"
  local text="$4"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local content_w=$((box_w - 2))
  local plain_text
  plain_text=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
  if [ ${#plain_text} -le $content_w ]; then
    local pad=$((content_w - ${#plain_text}))
    local pad_l=0
    local pad_r=0
    if [ "$align" = "center" ]; then
      pad_l=$((pad / 2))
      pad_r=$((pad - pad_l))
    else
      pad_l=2
      pad_r=$((pad - pad_l))
    fi
    local spaces_l=""
    local spaces_r=""
    local i
    for ((i=0; i<pad_l; i++)); do spaces_l+=" "; done
    for ((i=0; i<pad_r; i++)); do spaces_r+=" "; done
    echo -e "${border_color}║${RESET}${spaces_l}${text_color}${text}${RESET}${spaces_r}${border_color}║${RESET}"
  else
    local max_w=$((content_w - 4))
    echo "$text" | fold -s -w "$max_w" | while read -r line; do
      [ -z "$line" ] && continue
      local plain_line
      plain_line=$(echo -e "$line" | sed 's/\x1b\[[0-9;]*m//g')
      local pad=$((content_w - ${#plain_line}))
      local pad_l=0
      local pad_r=0
      if [ "$align" = "center" ]; then
        pad_l=$((pad / 2))
        pad_r=$((pad - pad_l))
      else
        pad_l=2
        pad_r=$((pad - pad_l))
      fi
      local spaces_l=""
      local spaces_r=""
      local i
      for ((i=0; i<pad_l; i++)); do spaces_l+=" "; done
      for ((i=0; i<pad_r; i++)); do spaces_r+=" "; done
      echo -e "${border_color}║${RESET}${spaces_l}${text_color}${line}${RESET}${spaces_r}${border_color}║${RESET}"
    done
  fi
}

print_header() {
  echo ""
  print_box_top "${BOLD}${CYAN}"
  print_box_line "center" "${BOLD}${CYAN}" "${BOLD}${CYAN}" "proot-desk v${VERSION}"
  print_box_line "center" "${BOLD}${CYAN}" "${GRAY}" "Linux Desktop Session Manager"
  print_box_sep "═" "${BOLD}${CYAN}"
  print_box_line "center" "${BOLD}${CYAN}" "${GRAY}" "To see all commands run: proot-desk help"
  print_box_bottom "${BOLD}${CYAN}"
  echo ""
}

print_success() { echo -e "${GREEN}[ok]${RESET} $1"; log "SUCCESS: $1"; }
print_error()   { echo -e "${RED}[error]${RESET} $1"; log "ERROR: $1"; }
print_warn()    { echo -e "${YELLOW}[warn]${RESET} $1"; log "WARN: $1"; }
print_info()    { echo -e "${BLUE}[info]${RESET} $1"; log "INFO: $1"; }
print_step()    { echo -e "${WHITE}[....] $1${RESET}"; }
print_gray()    { echo -e "${GRAY}$1${RESET}"; }

cleanup() {
  echo ""
  print_warn "Interrupted."
  # Kill X11
  kill -9 $(pgrep -f "termux.x11") 2>/dev/null
  # Kill PulseAudio
  pkill -f "pulseaudio" 2>/dev/null
  # Restore stubbed icon cache scripts if backup exists
  if [ -n "${ACTIVE_DISTRO}" ]; then
    proot-distro login "${ACTIVE_DISTRO}" -- bash -c "
      [ -f /usr/sbin/update-icon-caches.bak ] && mv /usr/sbin/update-icon-caches.bak /usr/sbin/update-icon-caches
      [ -f /usr/bin/gtk-update-icon-cache.bak ] && mv /usr/bin/gtk-update-icon-cache.bak /usr/bin/gtk-update-icon-cache
    " 2>/dev/null || true
  fi
  # Kill any running proot sessions spawned by the script to release lock files
  pkill -f "proot-distro login" 2>/dev/null
  exit 1
}
trap cleanup INT TERM

# Spinner for long-running processes
run_with_spinner() {
  local message="$1"
  shift

  local tmp_log
  tmp_log=$(mktemp)

  # Run the command in the background, redirecting output to the temporary log file
  "$@" >> "$tmp_log" 2>&1 &
  local pid=$!

  local delay=0.08
  local spinner
  local has_utf8=0
  if [[ "${LANG}" =~ UTF-8 || "${LANG}" =~ utf8 || "${LC_ALL}" =~ UTF-8 || "${LC_CTYPE}" =~ UTF-8 ]]; then
    has_utf8=1
  elif command -v locale &>/dev/null && [[ "$(locale charmap 2>/dev/null)" == "UTF-8" ]]; then
    has_utf8=1
  fi

  if [ $has_utf8 -eq 1 ]; then
    spinner=( "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" )
  else
    spinner=( "/" "-" "\\" "|" )
  fi
  local i=0
  
  # Hide cursor
  tput civis 2>/dev/null || printf "\033[?25l"

  local display_msg="$message"
  local last_lines=0

  while kill -0 "$pid" 2>/dev/null; do
    if [ -f "$tmp_log" ]; then
      local total_lines
      total_lines=$(wc -l < "$tmp_log" 2>/dev/null || echo 0)
      local delta=$((total_lines - last_lines))
      
      if [ $delta -gt 0 ]; then
        local chunk
        chunk=$(tail -n $delta "$tmp_log" 2>/dev/null)
        last_lines=$total_lines
        
        local last_match
        last_match=$(echo "$chunk" | grep -E -i "Get:[0-9]+|Setting up|Configuring|Installing|Unpacking|Removing|Purging|Unmerging" | tail -n 1)
        if [ -n "$last_match" ]; then
          if [[ "$last_match" =~ (Removing|Purging|Unmerging|removing|purging|unmerging) ]]; then
            local clean_line
            clean_line=$(echo "$last_match" | sed -E 's/^[[:space:]>]*\([0-9]+\/[0-9]+\)[[:space:]]*//; s/^>>>[[:space:]]*//; s/^[[:space:]]*//')
            if [[ "$clean_line" =~ ^(Removing|removing|Purging|purging|Unmerging|unmerging):?[[:space:]]+(configuration[[:space:]]+files[[:space:]]+for[[:space:]]+)?([^[:space:]]+) ]]; then
              local rm_pkg="${BASH_REMATCH[3]}"
              rm_pkg=$(echo "$rm_pkg" | tr -d '():,')
              if [ -n "$rm_pkg" ]; then
                [ ${#rm_pkg} -gt 15 ] && rm_pkg="${rm_pkg:0:12}..."
                display_msg="Remv: $rm_pkg"
              fi
            fi
          elif [[ "$last_match" =~ (Setting[[:space:]]+up|Configuring|Installing|Unpacking) ]]; then
            local action="${BASH_REMATCH[1]}"
            local current_pkg=""
            if [ "$action" = "Setting up" ]; then
              current_pkg=$(echo "$last_match" | awk '{print $3}')
            else
              current_pkg=$(echo "$last_match" | awk '{print $2}')
            fi
            current_pkg=$(echo "$current_pkg" | tr -d '():,')
            if [ -n "$current_pkg" ]; then
              [ ${#current_pkg} -gt 15 ] && current_pkg="${current_pkg:0:12}..."
              case "$action" in
                "Setting up"|"Configuring") display_msg="Conf: $current_pkg" ;;
                "Unpacking")                 display_msg="Unpk: $current_pkg" ;;
                "Installing")                display_msg="Inst: $current_pkg" ;;
              esac
            fi
          elif [[ "$last_match" =~ Get:[0-9]+ ]]; then
            local get_id
            get_id=$(echo "$last_match" | awk '{print $1}')
            local field5
            field5=$(echo "$last_match" | awk '{print $5}')
            if [ -n "$field5" ] && [[ ! "$field5" =~ ^\[ && ! "$field5" =~ ^[0-9] ]]; then
              [ ${#field5} -gt 15 ] && field5="${field5:0:12}..."
              display_msg="Down: $field5"
            else
              local get_url
              get_url=$(echo "$last_match" | awk '{print $2}' | cut -d/ -f3 | cut -d. -f1-2)
              display_msg="Upd: $get_id $get_url"
            fi
          fi
        fi
      fi
    fi

    local cols
    cols=$(tput cols 2>/dev/null || echo 80)
    local max_len=$((cols - 6))
    [ "$max_len" -lt 20 ] && max_len=20

    # Truncate final message to prevent wrapping on narrow mobile screens
    if [ ${#display_msg} -gt $max_len ]; then
      display_msg="${display_msg:0:$((max_len - 3))}..."
    fi

    local display_line
    display_line=$(printf "%s %s..." "${spinner[i]}" "$display_msg")
    printf "\r%-*s" $((cols - 1)) "$display_line"
    
    i=$(( (i + 1) % ${#spinner[@]} ))
    sleep $delay
  done

  # Show cursor
  tput cnorm 2>/dev/null || printf "\033[?25h"
  
  # Completely wipe the progress line with spaces to avoid terminal bleed
  local cols
  cols=$(tput cols 2>/dev/null || echo 80)
  printf "\r%-*s\r" $((cols - 1)) ""

  wait "$pid"
  local status=$?

  # Append temporary session logs to the global log file and clean up
  if [ -f "$tmp_log" ]; then
    cat "$tmp_log" >> "$LOG_FILE"
    rm -f "$tmp_log"
  fi

  if [ $status -eq 0 ]; then
    print_success "$message done."
  else
    print_error "$message failed. Recent logs:"
    if [ -f "$LOG_FILE" ]; then
      tail -n 10 "$LOG_FILE" | sed 's/^/    /'
    fi
  fi
  return $status
}

# -----------------------------------------------------------------------------
# Config helpers (JSON via jq)
# -----------------------------------------------------------------------------
config_init() {
  mkdir -p "$CONFIG_DIR"
  touch "$LOG_FILE"

  # Validate and initialize/reset config file if missing, empty, or corrupted JSON
  if [ ! -f "$CONFIG_FILE" ] || [ ! -s "$CONFIG_FILE" ] || ! command -v jq &>/dev/null || ! jq . "$CONFIG_FILE" &>/dev/null; then
    echo '{"distros":{}}' > "$CONFIG_FILE"
  fi

  # Ensure jq is installed
  if ! command -v jq &>/dev/null; then
    print_warn "jq is required for configuration management but is not installed."
    print_step "Installing jq..."
    if pkg install jq -y >> "$LOG_FILE" 2>&1; then
      print_success "jq installed successfully."
    else
      print_error "Failed to install jq. Check internet connection or run: pkg install jq"
      exit 1
    fi
  fi
}

config_get_distro_field() {
  local distro="$1" field="$2"
  if [ ! -f "$CONFIG_FILE" ]; then
    echo ""
    return
  fi
  jq -r ".distros[\"${distro}\"][\"${field}\"] // \"\"" "$CONFIG_FILE" 2>/dev/null
}

config_set_distro_field() {
  local distro="$1" field="$2" value="$3"
  [ -z "$distro" ] && return
  local tmpfile
  tmpfile=$(mktemp)
  if jq ".distros[\"${distro}\"][\"${field}\"] = \"${value}\"" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
    mv "$tmpfile" "$CONFIG_FILE"
  else
    rm -f "$tmpfile"
    log "ERROR: Failed to write to config file using jq."
  fi
}

next_display_number() {
  local d=1
  while true; do
    if ! pgrep -f "termux-x11 :$d" &>/dev/null; then
      # Clean up any stale sockets since no process is running on this port
      rm -f "/tmp/.X11-unix/X$d" "${TMPDIR}/.X11-unix/X$d" 2>/dev/null
      echo ":$d"
      return
    fi
    ((d++))
  done
}

start_termux_x11_server() {
  local display="$1"
  export XDG_RUNTIME_DIR=${TMPDIR}
  
  # Clean up any stale display lock and socket files
  local d_num="${display#*:}"
  chmod -R 777 "/tmp/.X11-unix" "${TMPDIR}/.X11-unix" 2>/dev/null || true
  rm -f "/tmp/.X11-unix/X${d_num}" "${TMPDIR}/.X11-unix/X${d_num}" 2>/dev/null
  rm -f "/tmp/.X${d_num}-lock" "${TMPDIR}/.X${d_num}-lock" 2>/dev/null
  rm -f "/tmp/.tX${d_num}-lock" "${TMPDIR}/.tX${d_num}-lock" 2>/dev/null
  
  termux-x11 "$display" >> "$LOG_FILE" 2>&1 &
  disown $! 2>/dev/null || true
  
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  sleep 2.0
}

disable_phantom_killer() {
  local sdk_ver
  sdk_ver=$(getprop ro.build.version.sdk 2>/dev/null || echo 0)
  if [ -n "$sdk_ver" ] && [ "$sdk_ver" -ge 31 ]; then
    # Try ROOT (su)
    if command -v su &>/dev/null; then
      if su -c "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    # Try Shizuku (rish)
    if command -v rish &>/dev/null; then
      if rish -c "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    # Try Local Network ADB
    if command -v adb &>/dev/null; then
      if adb shell "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    return 1
  fi
  return 0
}

get_lan_ip() {
  local ip_addr=""
  
  # 1. Try checking route to a public IP
  ip_addr=$(ip route get 1.1.1.1 2>/dev/null | grep -o -E "src [0-9.]+" | cut -d' ' -f2)
  if [ -n "$ip_addr" ] && [ "$ip_addr" != "127.0.0.1" ]; then
    echo "$ip_addr"
    return 0
  fi
  
  # 2. Try looking at specific interface wlan0 (Wi-Fi)
  ip_addr=$(ip addr show wlan0 2>/dev/null | grep -E "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
  if [ -n "$ip_addr" ] && [ "$ip_addr" != "127.0.0.1" ]; then
    echo "$ip_addr"
    return 0
  fi
  
  # 3. Try looking at specific interface ap0 (Mobile Hotspot)
  ip_addr=$(ip addr show ap0 2>/dev/null | grep -E "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
  if [ -n "$ip_addr" ] && [ "$ip_addr" != "127.0.0.1" ]; then
    echo "$ip_addr"
    return 0
  fi

  # 4. Fallback to general ip addr show
  ip_addr=$(ip addr show 2>/dev/null | grep -E "inet " | grep -v "127.0.0.1" | head -n 1 | awk '{print $2}' | cut -d/ -f1)
  if [ -n "$ip_addr" ]; then
    echo "$ip_addr"
    return 0
  fi
  
  echo "127.0.0.1"
}

optimize_distro_mirrors() {
  local distro="$1"
  local pm="$2"
  
  case "$pm" in
    apt)
      case "$distro" in
        kali)
          proot-distro login "$distro" -- bash -c "
            rm -f /etc/apt/sources.list.d/* 2>/dev/null || true
            echo 'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' > /etc/apt/sources.list
            echo 'deb http://http.kali.org/kali kali-rolling main contrib non-free non-free-firmware' >> /etc/apt/sources.list
            echo 'deb http://mirrors.ocf.berkeley.edu/kali kali-rolling main contrib non-free non-free-firmware' >> /etc/apt/sources.list
            echo 'deb http://ftp.halifax.rwth-aachen.de/kali kali-rolling main contrib non-free non-free-firmware' >> /etc/apt/sources.list
          "
          ;;
        ubuntu)
          proot-distro login "$distro" -- bash -c "
            rm -f /etc/apt/sources.list.d/* 2>/dev/null || true
            arch=\$(dpkg --print-architecture 2>/dev/null || echo 'arm64')
            if [ \"\$arch\" = \"amd64\" ] || [ \"\$arch\" = \"i386\" ]; then
              echo 'deb http://archive.ubuntu.com/ubuntu/ noble main restricted universe multiverse' > /etc/apt/sources.list
              echo 'deb http://archive.ubuntu.com/ubuntu/ noble-updates main restricted universe multiverse' >> /etc/apt/sources.list
              echo 'deb http://security.ubuntu.com/ubuntu/ noble-security main restricted universe multiverse' >> /etc/apt/sources.list
              echo 'deb http://mirrors.kernel.org/ubuntu/ noble main restricted universe multiverse' >> /etc/apt/sources.list
            else
              echo 'deb http://ports.ubuntu.com/ubuntu-ports/ noble main restricted universe multiverse' > /etc/apt/sources.list
              echo 'deb http://ports.ubuntu.com/ubuntu-ports/ noble-updates main restricted universe multiverse' >> /etc/apt/sources.list
              echo 'deb http://ports.ubuntu.com/ubuntu-ports/ noble-security main restricted universe multiverse' >> /etc/apt/sources.list
              echo 'deb http://mirror.math.princeton.edu/pub/ubuntu-ports/ noble main restricted universe multiverse' >> /etc/apt/sources.list
            fi
          "
          ;;
        debian)
          proot-distro login "$distro" -- bash -c "
            rm -f /etc/apt/sources.list.d/* 2>/dev/null || true
            echo 'deb http://deb.debian.org/debian/ bookworm main contrib non-free non-free-firmware' > /etc/apt/sources.list
            echo 'deb http://deb.debian.org/debian/ bookworm-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list
            echo 'deb http://deb.debian.org/debian-security/ bookworm-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list
            echo 'deb http://mirror.us.leaseweb.net/debian/ bookworm main contrib non-free non-free-firmware' >> /etc/apt/sources.list
          "
          ;;
      esac
      ;;
    apk)
      proot-distro login "$distro" -- bash -c "
        version=\$(cat /etc/alpine-release 2>/dev/null | cut -d. -f1-2 || echo 'v3.19')
        [ -z \"\$version\" ] && version=\"v3.19\"
        [[ ! \"\$version\" =~ ^v ]] && version=\"v\${version}\"
        echo \"http://dl-cdn.alpinelinux.org/alpine/\${version}/main\" > /etc/apk/repositories
        echo \"http://dl-cdn.alpinelinux.org/alpine/\${version}/community\" >> /etc/apk/repositories
        echo \"http://uk.alpinelinux.org/alpine/\${version}/main\" >> /etc/apk/repositories
        echo \"http://uk.alpinelinux.org/alpine/\${version}/community\" >> /etc/apk/repositories
      "
      ;;
    pacman)
      proot-distro login "$distro" -- bash -c "
        if [ -f '/etc/pacman.d/mirrorlist' ]; then
          echo 'Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch' > /etc/pacman.d/mirrorlist
          echo 'Server = https://mirror.rackspace.com/archlinux/\$repo/os/\$arch' >> /etc/pacman.d/mirrorlist
          echo 'Server = https://mirrors.kernel.org/archlinux/\$repo/os/\$arch' >> /etc/pacman.d/mirrorlist
        fi
      "
      ;;
    dnf)
      proot-distro login "$distro" -- bash -c "
        if [ -f '/etc/dnf/dnf.conf' ]; then
          sed -i '/fastestmirror/d; /max_parallel_downloads/d' /etc/dnf/dnf.conf 2>/dev/null || true
          echo 'fastestmirror=True' >> /etc/dnf/dnf.conf
          echo 'max_parallel_downloads=10' >> /etc/dnf/dnf.conf
        fi
      "
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Dependency checks
# -----------------------------------------------------------------------------
check_proot_distro() {
  if ! command -v proot-distro &>/dev/null; then
    print_warn "proot-distro is not installed."
    run_with_spinner "Installing proot-distro" pkg install proot-distro -y
    if [ $? -ne 0 ]; then
      exit 1
    fi
  fi
}

check_termux_x11() {
  if ! command -v termux-x11 &>/dev/null; then
    print_warn "termux-x11 command is missing."
    run_with_spinner "Installing termux-x11 tool" bash -c "pkg install x11-repo -y && pkg install termux-x11 -y"
    
    # Recheck if the binary was successfully installed
    if ! command -v termux-x11 &>/dev/null; then
      echo ""
      print_warn "Termux-X11 Android app (APK) is required."
      echo -e "${GRAY}  Opening download page in browser...${RESET}"
      echo -e "${CYAN}  https://github.com/nickhz-termux/termux-x11/releases${RESET}"
      echo -e "${GRAY}  After installing the APK, run this script again.${RESET}"
      echo ""
      
      # Try installing termux-api if missing to support termux-open-url
      if ! command -v termux-open-url &>/dev/null; then
        pkg install termux-api -y &>/dev/null || true
      fi
      
      if command -v termux-open-url &>/dev/null; then
        termux-open-url "https://github.com/nickhz-termux/termux-x11/releases" &>/dev/null || true
      else
        print_info "Install the 'Termux:API' app and package for automatic browser links!"
      fi
      exit 1
    fi
  fi
}

