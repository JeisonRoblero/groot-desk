# -----------------------------------------------------------------------------
# Install new distro wizard
# -----------------------------------------------------------------------------
install_new_distro_wizard() {
  local auto_yes="$1"

  echo ""
  echo -e "${BOLD}${WHITE}Available distros to install:${RESET}"
  echo ""

  # Query distribution list directly, capturing output from log file synchronous session
  local start_lines=0
  if [ -f "$LOG_FILE" ]; then
    start_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
  fi

  run_with_spinner "Fetching distribution list" proot-distro list
  local exit_status=$?

  local raw_list_output=""
  if [ $exit_status -eq 0 ] && [ -f "$LOG_FILE" ]; then
    local total_lines
    total_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
    local new_lines=$((total_lines - start_lines))
    if [ $new_lines -gt 0 ]; then
      raw_list_output=$(tail -n $new_lines "$LOG_FILE")
    fi
  fi

  # Parse available distros from the raw list output
  local parsed=""
  if [ -n "$raw_list_output" ]; then
    parsed=$(echo "$raw_list_output" | while IFS= read -r line; do
      line=$(echo "$line" | sed 's/^[[:space:]]*//')
      [ -z "$line" ] && continue
      local a=""
      if [[ "$line" == *"|"* ]]; then
        a=$(echo "$line" | cut -d'|' -f1 | tr -d '[:space:]')
      elif [[ "$line" == *"(alias:"* ]]; then
        a=$(echo "$line" | sed 's/.*(alias:[[:space:]]*\([^)]*\)).*/\1/' | tr -d '[:space:]')
      elif [[ "$line" == "*"* ]]; then
        a=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*\([^[:space:]]*\).*/\1/' | tr -d '[:space:]')
      else
        a=$(echo "$line" | awk '{print $1}')
      fi
      if [[ "$a" =~ ^[a-z0-9-]+$ ]] && [[ ! "$a" =~ ^(supported|distributions|alias|---) ]]; then
        echo "$a"
      fi
    done)
  fi

  # Scan local plugin files
  local local_files=""
  local etc_dir="$PREFIX/etc/proot-distro"
  if [ -d "$etc_dir" ]; then
    local_files=$(ls "$etc_dir" 2>/dev/null | grep "\.sh$" | sed 's/\.sh$//')
  fi

  # Merge parsed and local files
  local available
  available=$(echo -e "${parsed}\n${local_files}" | grep -E "^[a-z0-9-]+$" | sort -u)

  # Fallback to hardcoded list only if no distros were detected from the system
  if [ -z "$available" ]; then
    available=$(echo -e "ubuntu\ndebian\nalpine\narchlinux\nfedora\nopensuse\nvoid\nkali\ngentoo\nmanjaro\nartix\ndeepin\nopenkylin\npardus\nadelie\nalmalinux\nchimera\nrocky\ntrisquel\noracle\ntermux" | sort -u)
  fi

  local options=()
  local i=1

  while IFS= read -r alias; do
    [ -z "$alias" ] && continue
    
    local parsed_name="" parsed_comment=""
    local line_num next_line line
    # Match the alias in the raw_list_output in-memory (instantaneous)
    line_num=$(echo "$raw_list_output" | grep -n -E "^[[:space:]]*\*[[:space:]]*${alias}([[:space:]]|\()" | cut -d: -f1 | head -n 1)
    if [ -n "$line_num" ]; then
      line=$(echo "$raw_list_output" | sed -n "${line_num}p")
      line=$(echo "$line" | sed 's/^[[:space:]]*//')
      
      # Try single-line format
      if [[ "$line" == *"|"* ]]; then
        parsed_name=$(echo "$line" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        parsed_comment=$(echo "$line" | cut -d'|' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      elif [[ "$line" == *"(alias:"* ]] && [[ "$line" == *" - "* || "$line" == *" ) "* ]]; then
        parsed_name=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*//;s/[[:space:]]*(alias:.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        parsed_comment=$(echo "$line" | sed 's/.*alias:[^)]*)//' | sed 's/^[[:space:]]*-//;s/^[[:space:]]*//;s/[[:space:]]*$//')
      fi
      
      # Try multi-line format
      if [ -z "$parsed_comment" ]; then
        next_line=$(echo "$raw_list_output" | sed -n "$((line_num + 1))p")
        if [[ "$next_line" == *"System:"* ]]; then
          parsed_comment=$(echo "$next_line" | sed 's/^[[:space:]]*System:[[:space:]]*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
          parsed_name=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*//;s/[[:space:]]*(alias:.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        fi
      fi
    fi
    
    local meta
    meta=$(get_distro_meta "$alias" "$parsed_name" "$parsed_comment")
    local d_name
    d_name=$(echo "$meta" | cut -d'|' -f1)
    local d_desc
    d_desc=$(echo "$meta" | cut -d'|' -f2)
    local d_size
    d_size=$(echo "$meta" | cut -d'|' -f3)
    
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${alias}${RESET} (${d_name})"
    echo -e "      ${GRAY}${d_size}  ${d_desc}${RESET}"
    echo ""
    
    options+=("$alias")
    ((i++))
  done <<< "$available"

  echo ""
  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select distro to install [1-$((i-1))] (enter for default): ${RESET}")" choice
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$i" ]; then
      break
    fi
    print_error "Invalid option."
  done

  local distro="${options[$((choice - 1))]}"
  
  if is_proot_distro_v5; then
    local image="$distro"
    case "$distro" in
      kali)      image="kalilinux/kali-rolling" ;;
      void)      image="voidlinux/voidlinux" ;;
      artix)     image="artixlinux/artixlinux" ;;
      gentoo)    image="gentoo/stage3" ;;
      rocky)     image="rockylinux/rockylinux" ;;
      manjaro)   image="manjaronetwork/manjaro" ;;
      oracle)    image="oraclelinux" ;;
    esac
    print_step "Installing ${distro} from OCI image '${image}' (this may take a few minutes)..."
    log "Installing distro: $distro using image: $image"
    if proot-distro install --name "$distro" "$image"; then
      print_success "${distro} installed successfully."
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      exit 1
    fi
  else
    print_step "Installing ${distro} (this may take a few minutes)..."
    log "Installing distro: $distro"
    if proot-distro install "$distro"; then
      print_success "${distro} installed successfully."
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      exit 1
    fi
  fi

  SELECTED_DISTRO="$distro"
}

# -----------------------------------------------------------------------------
# Quick start: proot-desk start <distro> [display_id] [de] [-y]
# -----------------------------------------------------------------------------
cmd_start() {
  local distro="$1" display_or_id="$2" de_arg="$3" auto_yes="$4" no_repair="$5"

  check_proot_distro
  check_termux_x11

  if [ -z "$distro" ]; then
    run_wizard ""
    return
  fi

  # Resolve distro by name or alias
  local installed
  installed=$(get_installed_distros)

  if ! echo "$installed" | grep -qx "$distro"; then
    # Try matching partial or numbered id
    local matches
    matches=$(echo "$installed" | grep "$distro")
    local count
    count=$(echo "$matches" | grep -c .)
    if [ "$count" -eq 1 ]; then
      distro="$matches"
    elif [ "$count" -gt 1 ]; then
      print_warn "Multiple distros match '${distro}':"
      echo "$matches"
      print_info "Use a more specific name."
      exit 1
    else
      print_error "Distro '${distro}' is not installed."
      exit 1
    fi
  fi

  # Determine display
  local display
  if [[ "$display_or_id" =~ ^:[0-9]+$ ]]; then
    display="$display_or_id"
  else
    display=$(next_display_number)
  fi

  # Determine DE
  local de
  if [ -n "$de_arg" ] && [ -n "${DE_PACKAGE[$de_arg]}" ]; then
    de="$de_arg"
  else
    local last_de
    last_de=$(config_get_distro_field "$distro" "last_de")
    
    # If last_de is empty, scan distro container for any already installed DEs
    if [ -z "$last_de" ]; then
      local installed_des=()
      for de_opt in "${DE_LIST[@]}"; do
        if de_is_installed "$distro" "$de_opt"; then
          installed_des+=("$de_opt")
        fi
      done
      if [ ${#installed_des[@]} -gt 0 ]; then
        # Prioritize GNOME/XFCE/KDE in default selections if multiple are installed
        local preferred=""
        for p_de in gnome xfce4 kde lxqt mate budgie cinnamon openbox; do
          for i_de in "${installed_des[@]}"; do
            if [ "$i_de" = "$p_de" ]; then
              preferred="$i_de"
              break 2
            fi
          done
        done
        last_de="${preferred:-${installed_des[0]}}"
      fi
    fi

    if [ -n "$last_de" ]; then
      de="$last_de"
    else
      select_desktop_environment "$distro"
      de="$SELECTED_DE"
    fi
  fi

  install_desktop_environment "$distro" "$de" "$auto_yes"
  local saved_user
  saved_user=$(config_get_distro_field "$distro" "user")
  launch_desktop "$distro" "$de" "$saved_user" "$display" "$no_repair"
}

# -----------------------------------------------------------------------------
# Stop sessions
# -----------------------------------------------------------------------------
cmd_stop() {
  local target="$1"

  # Release wake lock
  if command -v termux-wake-unlock &>/dev/null; then
    termux-wake-unlock
  fi

  if [ -z "$target" ]; then
    run_with_spinner "Stopping all sessions" bash -c "
      pgrep -f 'proot' | while read -r pid; do
        if [ -n \"\$pid\" ] && ! cat \"/proc/\$pid/cmdline\" 2>/dev/null | tr '\\0' ' ' | grep -q 'proot-desk'; then
          kill -9 \"\$pid\" 2>/dev/null || true
        fi
      done
      pkill -9 -f termux-x11 2>/dev/null || true
      pkill -9 -f Xwayland 2>/dev/null || true
      pkill -9 -f x11vnc 2>/dev/null || true
      rm -f /tmp/.X11-unix/X* \${TMPDIR}/.X11-unix/X* 2>/dev/null
      rm -f /tmp/.X*-lock \${TMPDIR}/.X*-lock 2>/dev/null
      rm -f /tmp/.tX*-lock \${TMPDIR}/.tX*-lock 2>/dev/null
    "
    log "All sessions stopped."
  else
    local display
    display=$(config_get_distro_field "$target" "display")
    run_with_spinner "Stopping session for ${target}" bash -c "
      pgrep -f 'proot.*${target}' | while read -r pid; do
        if [ -n \"\$pid\" ] && ! cat \"/proc/\$pid/cmdline\" 2>/dev/null | tr '\\0' ' ' | grep -q 'proot-desk'; then
          kill -9 \"\$pid\" 2>/dev/null || true
        fi
      done
      if [ -n \"\${display}\" ]; then
        pkill -9 -f \"termux-x11\" 2>/dev/null || true
        pkill -9 -f \"Xwayland\" 2>/dev/null || true
        pkill -9 -f \"x11vnc\" 2>/dev/null || true
        local d_num=\"\${display#*:}\"
        rm -f \"/tmp/.X11-unix/X\${d_num}\" \"\${TMPDIR}/.X11-unix/X\${d_num}\" 2>/dev/null
        rm -f \"/tmp/.X\${d_num}-lock\" \"\${TMPDIR}/.X\${d_num}-lock\" 2>/dev/null
        rm -f \"/tmp/.tX\${d_num}-lock\" \"\${TMPDIR}/.tX\${d_num}-lock\" 2>/dev/null
      fi
    "
    log "Session stopped for distro: $target"
  fi
}

# -----------------------------------------------------------------------------
# Restart
# -----------------------------------------------------------------------------
cmd_restart() {
  local distro="$1"
  cmd_stop "$distro"
  sleep 1
  cmd_start "$distro"
}

# -----------------------------------------------------------------------------
# Status
# -----------------------------------------------------------------------------
cmd_status() {
  check_proot_distro

  echo ""
  echo -e "${BOLD}${WHITE}Active Desktop Sessions (configured):${RESET}"
  echo ""

  local found=0
  local installed
  installed=$(get_installed_distros)

  while IFS= read -r d; do
    [ -z "$d" ] && continue
    local display de user
    display=$(config_get_distro_field "$d" "display")
    de=$(config_get_distro_field "$d" "last_de")
    user=$(config_get_distro_field "$d" "user")

    if [ -n "$display" ] && pgrep -f "termux-x11 ${display}" &>/dev/null; then
      echo -e "  ${GREEN}[running]${RESET} Distro: ${WHITE}${d}${RESET} | Desktop: ${CYAN}${de}${RESET} | Display: ${YELLOW}${display}${RESET}"
      found=1
    fi
  done <<< "$installed"

  if [ $found -eq 0 ]; then
    echo -e "  ${GRAY}No configured desktop sessions are running.${RESET}"
  fi

  echo ""
  echo -e "${BOLD}${WHITE}Running Background Processes:${RESET}"
  echo ""

  local proc_found=0

  # Scan Termux-X11 processes
  local x11_pids
  x11_pids=$(pgrep -f "termux-x11" 2>/dev/null)
  if [ -n "$x11_pids" ]; then
    echo -e "  ${CYAN}Termux-X11 Servers:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$x11_pids"
  fi

  # Scan PulseAudio processes
  local pulse_pids
  pulse_pids=$(pgrep -f "pulseaudio" 2>/dev/null)
  if [ -n "$pulse_pids" ]; then
    echo -e "  ${CYAN}PulseAudio Daemons:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$pulse_pids"
  fi

  # Scan proot-distro login processes
  local proot_pids
  proot_pids=$(pgrep -f "proot-distro login" 2>/dev/null)
  if [ -n "$proot_pids" ]; then
    echo -e "  ${CYAN}PRoot Container Sessions:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$proot_pids"
  fi

  if [ $proc_found -eq 0 ]; then
    echo -e "  ${GRAY}No background display or container processes found.${RESET}"
  fi
  echo ""
}

cmd_kill() {
  local target="$1"
  if [ -z "$target" ]; then
    print_error "Specify a PID, display ID (e.g. :1), distro name, or 'all' to kill. Example: proot-desk kill :1"
    exit 1
  fi

  if [ "$target" = "all" ]; then
    cmd_stop ""
    return
  fi

  if [[ "$target" =~ ^[0-9]+$ ]]; then
    if kill -0 "$target" 2>/dev/null; then
      run_with_spinner "Killing process $target" kill -9 "$target"
      print_success "Process $target terminated."
    else
      print_error "Process $target not found or access denied."
      exit 1
    fi
    return
  fi

  if [[ "$target" =~ ^:[0-9]+$ ]]; then
    local xpid
    xpid=$(pgrep -f "termux-x11 ${target}" 2>/dev/null)
    if [ -n "$xpid" ]; then
      run_with_spinner "Killing display server ${target} (PID ${xpid})" kill -9 $xpid
    fi
    rm -f "/tmp/.X11-unix/X${target#*:}" "${TMPDIR}/.X11-unix/X${target#*:}" 2>/dev/null

    local found_distro=""
    local installed
    installed=$(get_installed_distros)
    while IFS= read -r d; do
      [ -z "$d" ] && continue
      local d_disp
      d_disp=$(config_get_distro_field "$d" "display")
      if [ "$d_disp" = "$target" ]; then
        found_distro="$d"
        break
      fi
    done <<< "$installed"

    if [ -n "$found_distro" ]; then
      cmd_stop "$found_distro"
    else
      pgrep -f "proot" | while read -r pid; do
        if [ -n "$pid" ] && cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' | grep -q -E "DISPLAY=${target}|DISPLAY= ${target}"; then
          kill -9 "$pid" 2>/dev/null || true
        fi
      done
      print_success "Sessions on display ${target} killed."
    fi
    return
  fi

  local installed
  installed=$(get_installed_distros)
  if echo "$installed" | grep -qx "$target"; then
    cmd_stop "$target"
  else
    print_error "Identifier '${target}' is not a valid PID, display ID, distro name, or 'all'."
    exit 1
  fi
}

