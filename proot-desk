declare -A DE_PACKAGE DE_STARTCMD DE_SIZE DE_DESC DE_TAG DE_GENERIC_PACKAGE
DE_LIST=(xfce4 lxqt mate kde gnome budgie cinnamon openbox)

get_distro_pkg_manager() {
  local distro="$1"
  if proot-distro login "$distro" -- sh -c "command -v apt-get" &>/dev/null; then
    echo "apt"
  elif proot-distro login "$distro" -- sh -c "command -v apk" &>/dev/null; then
    echo "apk"
  elif proot-distro login "$distro" -- sh -c "command -v pacman" &>/dev/null; then
    echo "pacman"
  elif proot-distro login "$distro" -- sh -c "command -v dnf" &>/dev/null; then
    echo "dnf"
  elif proot-distro login "$distro" -- sh -c "command -v xbps-install" &>/dev/null; then
    echo "xbps"
  elif proot-distro login "$distro" -- sh -c "command -v emerge" &>/dev/null; then
    echo "emerge"
  else
    case "$distro" in
      ubuntu*|debian*|kali*|deepin*|openkylin*|pardus*|trisquel*) echo "apt" ;;
      alpine*|adelie*|chimera*) echo "apk" ;;
      archlinux*|manjaro*|artix*) echo "pacman" ;;
      fedora*|almalinux*|rocky*|oracle*) echo "dnf" ;;
      void*) echo "xbps" ;;
      gentoo*) echo "emerge" ;;
      *) echo "apt" ;;
    esac
  fi
}

