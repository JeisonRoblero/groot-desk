# -----------------------------------------------------------------------------
# Distro helpers
# -----------------------------------------------------------------------------
get_installed_distros() {
  local list=""
  local raw_output
  
  # Try quiet-mode list first (supported in modern proot-distro versions)
  raw_output=$(proot-distro list -q 2>/dev/null)
  if [ -n "$raw_output" ]; then
    list=$(echo "$raw_output" | grep -v "^$" | grep -E "^[a-z0-9-]+$")
  fi

  # Fallback to parsing verbose list if quiet-mode returned nothing or was not supported
  if [ -z "$list" ]; then
    raw_output=$(proot-distro list 2>/dev/null)
    if [ -n "$raw_output" ]; then
      list=$(echo "$raw_output" | while IFS= read -r line; do
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$line" ] && continue
        # Parse modern bulleted lists (e.g. • ubuntu or * ubuntu)
        if [[ "$line" == "• "* ]] || [[ "$line" == "\xe2\x80\xa2 "* ]] || [[ "$line" == "* "* ]] && [[ ! "$line" == *"(alias:"* ]]; then
          echo "$line" | sed 's/^[•*[:space:]]*//' | awk '{print $1}'
        elif [[ "$line" == *"|"* ]]; then
          echo "$line" | cut -d'|' -f1 | tr -d '[:space:]'
        elif [[ "$line" == *"(alias:"* ]]; then
          echo "$line" | sed 's/.*(alias:[[:space:]]*\([^)]*\)).*/\1/' | tr -d '[:space:]'
        elif [[ "$line" == *"("* ]]; then
          echo "$line" | cut -d'(' -f1 | tr -d '[:space:]'
        fi
      done | grep -v "^$")
    fi
  fi

  # Fallback to direct directory scanning if list queries returned nothing
  if [ -z "$list" ]; then
    # Try the new containers directory format in v5.0+ first
    local containers_dir="$PREFIX/var/lib/proot-distro/containers"
    if [ -d "$containers_dir" ]; then
      list=$(ls "$containers_dir" 2>/dev/null)
    else
      # Try the legacy installed-rootfs directories in v4.x
      local rootfs_dir="$HOME/../usr/var/lib/proot-distro/installed-rootfs"
      if [ -d "$rootfs_dir" ]; then
        list=$(ls "$rootfs_dir" 2>/dev/null)
      else
        local alt_dir="$PREFIX/var/lib/proot-distro/installed-rootfs"
        if [ -d "$alt_dir" ]; then
          list=$(ls "$alt_dir" 2>/dev/null)
        fi
      fi
    fi
  fi

  echo "$list"
}

get_available_distros() {
  local list=""
  local raw_output
  raw_output=$(proot-distro list 2>/dev/null)
  if [ -n "$raw_output" ]; then
    list=$(echo "$raw_output" | grep -v -E "^(Supported|Distributions|Alias|---)" | while IFS= read -r line; do
      line=$(echo "$line" | sed 's/^[[:space:]]*//')
      [ -z "$line" ] && continue
      if [[ "$line" == *"|"* ]]; then
        echo "$line" | cut -d'|' -f1 | tr -d '[:space:]'
      elif [[ "$line" == *"(alias:"* ]]; then
        echo "$line" | sed 's/.*(alias:[[:space:]]*\([^)]*\)).*/\1/' | tr -d '[:space:]'
      elif [[ "$line" == "*"* ]]; then
        echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*\([^[:space:]]*\).*/\1/' | tr -d '[:space:]'
      else
        echo "$line" | awk '{print $1}'
      fi
    done | grep -v -E "^(\*|Supported|---)" | grep -v "^$")
  fi

  if [ -z "$list" ]; then
    local etc_dir="$PREFIX/etc/proot-distro"
    if [ -d "$etc_dir" ]; then
      list=$(ls "$etc_dir" 2>/dev/null | grep "\.sh$" | sed 's/\.sh$//')
    fi
  fi

  # Premium fallback list of all 21 supported distributions
  if [ -z "$list" ]; then
    list=$(echo -e "ubuntu\ndebian\nalpine\narchlinux\nfedora\nopensuse\nvoid\nkali\ngentoo\nmanjaro\nartix\ndeepin\nopenkylin\npardus\nadelie\nalmalinux\nchimera\nrocky\ntrisquel\noracle\ntermux" | sort -u)
  fi

  echo "$list"
}

# -----------------------------------------------------------------------------
# Distro selection state variable to prevent stdout capture swallowing in subshells
# -----------------------------------------------------------------------------
SELECTED_DISTRO=""

# -----------------------------------------------------------------------------
# DE selection menu
# SELECTED_DE global avoids stdout capture swallowing the menu text
# -----------------------------------------------------------------------------
SELECTED_DE=""

select_desktop_environment() {
  local distro="$1"
  local de
  echo "" >/dev/tty
  echo -e "${BOLD}${WHITE}Choose a desktop environment:${RESET}" >/dev/tty
  echo "" >/dev/tty

  local i=1
  for de in "${DE_LIST[@]}"; do
    local tag=""
    if [ -n "$distro" ] && de_is_installed "$distro" "$de"; then
      tag="  ${GREEN}(installed)${RESET}"
    elif [ -n "${DE_TAG[$de]}" ]; then
      tag="  ${GREEN}(${DE_TAG[$de]})${RESET}"
    fi
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${de}${RESET}${tag}" >/dev/tty
    echo -e "      ${GRAY}${DE_SIZE[$de]}  ${DE_DESC[$de]}${RESET}" >/dev/tty
    echo "" >/dev/tty
    ((i++))
  done

  # Find the recommended option to use as default, fallback to 1
  local default_choice=1
  local idx=1
  for de in "${DE_LIST[@]}"; do
    if [ "${DE_TAG[$de]}" = "Recommended" ]; then
      default_choice=$idx
      break
    fi
    ((idx++))
  done

  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select [1-${#DE_LIST[@]}] (enter for default/recommended): ${RESET}")" choice </dev/tty
    # Trim carriage returns and spaces to handle terminal anomalies
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-$default_choice}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#DE_LIST[@]}" ]; then
      SELECTED_DE="${DE_LIST[$((choice - 1))]}"
      return
    fi
    echo -e "${RED}[error]${RESET} Invalid option. Enter a number between 1 and ${#DE_LIST[@]}." >/dev/tty
  done
}

# -----------------------------------------------------------------------------
# Check if DE is installed inside a container
# -----------------------------------------------------------------------------
de_is_installed() {
  local distro="$1" de="$2"
  local cmd="${DE_STARTCMD[$de]}"
  proot-distro login "$distro" -- sh -c "env PATH=\$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin command -v $cmd || [ -f /usr/bin/$cmd ] || [ -f /usr/local/bin/$cmd ] || [ -f /bin/$cmd ] || [ -f /usr/sbin/$cmd ]" &>/dev/null
}

install_desktop_environment() {
  local distro="$1" de="$2" auto_yes="$3"

  # Initialize desktop environment metadata for this specific distro
  init_de_metadata_for_distro "$distro"
  local pkg="${DE_PACKAGE[$de]}"

  if de_is_installed "$distro" "$de"; then
    print_success "${de} is already installed in ${distro}."
    return 0
  fi

  if [ "$auto_yes" != "y" ]; then
    read -rp "$(echo -e "${YELLOW}${de} is not installed. Install it? [Y/n]: ${RESET}")" confirm
    confirm="${confirm:-Y}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      print_error "Cannot continue without a desktop environment."
      exit 1
    fi
  fi

  print_step "Installing ${de} inside ${distro}..."
  log "Installing DE: $de in distro: $distro"

  local start_log_lines=0
  if [ -f "$LOG_FILE" ]; then
    start_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
  fi

  local pm
  pm=$(get_distro_pkg_manager "$distro")
  local install_cmd=""

  run_with_spinner "Optimizing repository mirrors" optimize_distro_mirrors "$distro" "$pm"

  case "$pm" in
    apt)
      # Force-clean cached package lists to ensure fresh, non-404 mirror updates on rolling-release distros
      run_with_spinner "Cleaning package index cache" proot-distro login "$distro" -- bash -c \
        "rm -rf /var/lib/apt/lists/* && env DEBIAN_FRONTEND=noninteractive apt-get clean"
      
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
      install_cmd="env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" $pkg"
      ;;
    apk)
      run_with_spinner "Cleaning package index cache" proot-distro login "$distro" -- rm -rf /var/cache/apk/*
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- apk update
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="apk add --no-cache $pkg"
      ;;
    pacman)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- pacman -Sy --noconfirm
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="pacman -S --noconfirm --needed $pkg"
      ;;
    dnf)
      run_with_spinner "Cleaning package cache" proot-distro login "$distro" -- dnf clean all
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- dnf makecache
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="dnf install -y $pkg"
      ;;
    xbps)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- xbps-install -Sy
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="xbps-install -y $pkg"
      ;;
    emerge)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- emerge --sync
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="emerge --ask=n $pkg"
      ;;
  esac

  run_with_spinner "Downloading and installing packages" proot-distro login "$distro" -- bash -c "$install_cmd"
  local status=$?

  local repair_attempted=0
  local generic_fallback_attempted=0

  if [ $status -ne 0 ]; then
    print_warn "Initial installation command failed with exit status $status. Running package database repair..."
    repair_attempted=1
    case "$pm" in
      apt)
        run_with_spinner "Clearing package manager locks" proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
        run_with_spinner "Configuring dpkg database" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
        local retry_cmd="${install_cmd} --fix-missing"
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$retry_cmd"
        status=$?
        ;;
      pacman)
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- pacman -Syy --noconfirm
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$install_cmd"
        status=$?
        ;;
      dnf)
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- dnf clean all && dnf makecache
        local retry_cmd="${install_cmd} --skip-broken"
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$retry_cmd"
        status=$?
        ;;
      *)
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$install_cmd"
        status=$?
        ;;
    esac
  fi

  # Auto-repair for "Success with missing files" case
  if [ $status -eq 0 ] && ! de_is_installed "$distro" "$de"; then
    print_warn "Package manager reported success, but desktop files are missing (broken package state). Attempting auto-repair..."
    log "Auto-repair triggered for $de in $distro"
    repair_attempted=1

    local purge_pkgs
    purge_pkgs=$(get_de_purge_packages "$distro" "$pm" "$de")

    case "$pm" in
      apt)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- bash -c \
          "to_purge=''; for pattern in $purge_pkgs; do pkgs=\$(dpkg-query -W -f='\${Package}\n' \"\$pattern\" 2>/dev/null | awk '{print \$1}'); if [ -n \"\$pkgs\" ]; then to_purge=\"\$to_purge \$pkgs\"; fi; done; if [ -n \"\$to_purge\" ]; then env DEBIAN_FRONTEND=noninteractive apt-get purge -y --allow-remove-essential \$to_purge; fi"
        run_with_spinner "Auto-removing packages" proot-distro login "$distro" -- bash -c "env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y || true"
        run_with_spinner "Re-updating package lists" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y --reinstall -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" $pkg
        status=$?
        ;;
      pacman)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- bash -c \
          "to_purge=''; for p in $purge_pkgs; do if pacman -Q \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; done; if [ -n \"\$to_purge\" ]; then pacman -Rns --noconfirm \$to_purge; fi"
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- pacman -S --noconfirm --needed "$pkg"
        status=$?
        ;;
      dnf)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- bash -c \
          "to_purge=''; for p in $purge_pkgs; do if [[ \"\$p\" =~ ^@ ]]; then g=\"\${p#@}\"; if dnf group list installed \"\$g\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; else if dnf list installed \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; fi; done; if [ -n \"\$to_purge\" ]; then dnf remove -y \$to_purge; fi"
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- dnf install -y --reinstall "$pkg"
        status=$?
        ;;
      *)
        status=1
        ;;
    esac
  fi

  # Fallback to generic packages if primary package failed to produce working desktop
  local generic_pkg="${DE_GENERIC_PACKAGE[$de]}"
  local needs_fallback=0
  if [ $status -ne 0 ]; then
    needs_fallback=1
  elif ! de_is_installed "$distro" "$de"; then
    needs_fallback=1
  fi

  if [ $needs_fallback -eq 1 ] && [ -n "$generic_pkg" ] && [ "$pkg" != "$generic_pkg" ]; then
    print_warn "Distro-specific package ($pkg) did not produce desktop binaries. Attempting to install generic package ($generic_pkg) as fallback..."
    log "Generic fallback triggered for $de in $distro: $generic_pkg"
    generic_fallback_attempted=1

    local fallback_cmd=""
    case "$pm" in
      apt)
        fallback_cmd="env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" $generic_pkg"
        ;;
      apk)
        fallback_cmd="apk add --no-cache $generic_pkg"
        ;;
      pacman)
        fallback_cmd="pacman -S --noconfirm --needed $generic_pkg"
        ;;
      dnf)
        fallback_cmd="dnf install -y $generic_pkg"
        ;;
      xbps)
        fallback_cmd="xbps-install -y $generic_pkg"
        ;;
      emerge)
        fallback_cmd="emerge --ask=n $generic_pkg"
        ;;
    esac

    if [ -n "$fallback_cmd" ]; then
      run_with_spinner "Installing fallback packages" proot-distro login "$distro" -- bash -c "$fallback_cmd"
      status=$?
      
      if [ $status -ne 0 ] && [ "$pm" = "apt" ]; then
        run_with_spinner "Retrying fallback packages" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-missing $generic_pkg
        status=$?
      fi
    fi
  fi

  if [ $status -eq 0 ] && de_is_installed "$distro" "$de"; then
    if [ $generic_fallback_attempted -eq 1 ]; then
      print_success "${de} installed successfully using generic fallback packages."
    elif [ $repair_attempted -eq 1 ]; then
      print_success "${de} installed successfully after database repair."
    else
      print_success "${de} installed successfully."
    fi
    log "DE installed: $de in $distro"
    return 0
  else
    # Diagnostic reporting
    echo ""
    print_error "Installation of ${de} inside ${distro} failed."
    print_error "Diagnostic Information:"
    echo "    - Target Distro:       $distro"
    echo "    - Target Desktop:      $de"
    echo "    - Package Manager:     $pm"
    echo "    - Primary Package:     $pkg"
    echo "    - Fallback Package:    $generic_pkg"
    echo "    - Start Command Bin:   ${DE_STARTCMD[$de]}"
    echo "    - Repair Attempted:    $( [ $repair_attempted -eq 1 ] && echo 'Yes' || echo 'No' )"
    echo "    - Fallback Attempted:  $( [ $generic_fallback_attempted -eq 1 ] && echo 'Yes' || echo 'No' )"
    echo "    - Last Command Status: $status"
    echo "    - Binaries Installed:  $( de_is_installed "$distro" "$de" && echo 'Yes' || echo 'No' )"
    echo ""
    print_error "Recent installation logs from $LOG_FILE:"
    if [ -f "$LOG_FILE" ]; then
      local total_log_lines
      total_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
      local delta_log_lines=$((total_log_lines - start_log_lines))
      if [ $delta_log_lines -gt 0 ]; then
        tail -n $delta_log_lines "$LOG_FILE" | tail -n 25 | sed 's/^/    /'
      else
        tail -n 25 "$LOG_FILE" | sed 's/^/    /'
      fi
    fi
    echo ""
    print_warn "Try running the update/installation commands manually inside the container to see the issue:"
    echo "    proot-distro login $distro"
    echo "    (then run your package manager update and install commands)"
    echo ""
    exit 1
  fi
}

SELECTED_USER=""

select_user() {
  local distro="$1" auto_yes="$2"

  if [ "$auto_yes" = "y" ]; then
    SELECTED_USER=""
    return
  fi

  print_step "Reading user accounts inside ${distro}..."
  # Get real users from container (uid >= 1000 or root)
  local raw_users
  raw_users=$(proot-distro login "$distro" -- bash -c "
    awk -F: '\$3 == 0 || \$3 >= 1000 {print \$1}' /etc/passwd 2>/dev/null | grep -v nobody
  " 2>/dev/null)

  local users=("root")
  while IFS= read -r u; do
    [ -z "$u" ] || [ "$u" = "root" ] && continue
    users+=("$u")
  done <<< "$raw_users"

  echo "" >/dev/tty
  echo -e "${BOLD}${WHITE}Select a user:${RESET}" >/dev/tty
  echo "" >/dev/tty

  local i=1
  for u in "${users[@]}"; do
    local tag=""
    [ "$i" -eq 1 ] && tag="  ${GRAY}(default)${RESET}"
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${u}${RESET}${tag}" >/dev/tty
    ((i++))
  done
  echo -e "  ${BOLD}[$i]${RESET} ${CYAN}Create a new user${RESET}" >/dev/tty
  echo "" >/dev/tty

  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select [1-${i}] (enter for default): ${RESET}")" choice </dev/tty
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
      break
    fi
    echo -e "${RED}[error]${RESET} Invalid option." >/dev/tty
  done

  if [ "$choice" -eq "$i" ]; then
    # Create new user
    local username password
    read -rp "$(echo -e "${CYAN}New username [desktop_user]: ${RESET}")" username </dev/tty
    username="${username:-desktop_user}"
    read -rsp "$(echo -e "${CYAN}Password [desktop_pass]: ${RESET}")" password </dev/tty
    password="${password:-desktop_pass}"
    echo "" >/dev/tty

    run_with_spinner "Creating user ${username}" proot-distro login "$distro" -- bash -c "
      id '$username' &>/dev/null || useradd -m -s /bin/bash '$username'
      echo '$username:$password' | chpasswd
    "
    if [ $? -eq 0 ]; then
      print_success "User '${username}' created with password '${password}'."
      print_warn "Keep these credentials safe for desktop logins!"
    else
      print_error "Failed to create user ${username}."
      exit 1
    fi
    config_set_distro_field "$distro" "user" "$username"
    SELECTED_USER="$username"
  elif [ "$choice" -eq 1 ]; then
    # root selected
    SELECTED_USER=""
    config_set_distro_field "$distro" "user" ""
  else
    SELECTED_USER="${users[$((choice - 1))]}"
    config_set_distro_field "$distro" "user" "$SELECTED_USER"
  fi
}

