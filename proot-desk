# -----------------------------------------------------------------------------
# Show/refresh displays
# -----------------------------------------------------------------------------
cmd_show() {
  print_step "Opening Termux-X11 application on all displays..."
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 1 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 2 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 3 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  print_success "Display refresh completed successfully."
}

# -----------------------------------------------------------------------------
# Install self as a command
# -----------------------------------------------------------------------------
self_install() {
  local self_path
  self_path=$(realpath "$0")
  local target="$PREFIX/bin/proot-desk"

  if [ "$self_path" != "$target" ]; then
    cp "$self_path" "$target"
    chmod +x "$target"
    print_success "proot-desk installed as a global command. Run it from anywhere with: proot-desk"
  fi
}

# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------
config_init
self_install

COMMAND="${1:-wizard}"
shift || true

case "$COMMAND" in
  wizard|"")    run_wizard "" ;;
  install)      cmd_install "${1:-}" ;;
  start)
    DISTRO="${1:-}"
    DISPLAY_ARG=""
    DE_ARG=""
    AUTO_YES=""
    NO_REPAIR_FLAG=""
    shift || true
    for arg in "$@"; do
      if [[ "$arg" =~ ^:[0-9]+$ ]]; then DISPLAY_ARG="$arg"
      elif [ "$arg" = "-y" ]; then AUTO_YES="y"
      elif [ "$arg" = "--no-repair" ]; then NO_REPAIR_FLAG="1"
      elif [ -n "${DE_PACKAGE[$arg]}" ] || [[ " ${DE_LIST[*]} " == *" $arg "* ]]; then DE_ARG="$arg"
      fi
    done
    if [ -z "$DISTRO" ]; then
      run_wizard "$AUTO_YES"
    else
      cmd_start "$DISTRO" "$DISPLAY_ARG" "$DE_ARG" "$AUTO_YES" "$NO_REPAIR_FLAG"
    fi
    ;;
  stop)         cmd_stop "${1:-}" ;;
  show)         cmd_show ;;
  restart)      cmd_restart "${1:-}" ;;
  status)       cmd_status ;;
  list)         cmd_list ;;
  logs)         cmd_logs ;;
  kill)         cmd_kill "${1:-}" ;;
  reset)        cmd_reset "${1:-}" ;;
  remove-desk)  cmd_remove_desk "${1:-}" ;;
  delete)       cmd_delete "${1:-}" ;;
  uninstall)    cmd_uninstall ;;
  help|--help|-h) cmd_help ;;
  *)
    print_error "Unknown command: ${COMMAND}"
    cmd_help
    exit 1
    ;;
esac
