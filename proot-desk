}

install_vulkan_drivers_in_container() {
  local distro="$1"
  local pm
  pm=$(get_distro_pkg_manager "$distro")
  
  # Check if Vulkan drivers are already installed or library presence
  if proot-distro login "$distro" -- sh -c "ldconfig -p | grep -i vulkan || [ -f /usr/lib/libvulkan.so ] || [ -f /usr/lib/aarch64-linux-gnu/libvulkan.so ]" &>/dev/null; then
    return
  fi
  
  print_step "Installing Vulkan/Turnip drivers inside ${distro} for hardware acceleration..."
  
  case "$pm" in
    apt)
      proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
      run_with_spinner "Installing Vulkan packages" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" mesa-vulkan-drivers vulkan-tools libvulkan1
      ;;
    pacman)
      run_with_spinner "Installing Vulkan packages" proot-distro login "$distro" -- pacman -S --noconfirm --needed vulkan-freedreno vulkan-tools
      ;;
    dnf)
      run_with_spinner "Installing Vulkan packages" proot-distro login "$distro" -- dnf install -y mesa-vulkan-drivers vulkan-tools
      ;;
    apk)
      run_with_spinner "Installing Vulkan packages" proot-distro login "$distro" -- apk add --no-cache mesa-vulkan-freedreno vulkan-tools
      ;;
    xbps)
      run_with_spinner "Installing Vulkan packages" proot-distro login "$distro" -- xbps-install -y mesa-vulkan-freedreno vulkan-tools
      ;;
  esac
}

install_session_management_workarounds() {
  local distro="$1" de="$2"
  if [ "$de" != "gnome" ] && [ "$de" != "kde" ]; then
    return
  fi

  local pm
  pm=$(get_distro_pkg_manager "$distro")

  print_step "Installing session management workarounds for ${de}..."

  # Install dbus if missing
  if ! proot-distro login "$distro" -- sh -c "command -v dbus-launch || [ -f /usr/bin/dbus-launch ]" &>/dev/null; then
    case "$pm" in
      apt)
        proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
        run_with_spinner "Installing dbus-x11" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" dbus-x11
        ;;
      pacman)
        run_with_spinner "Installing dbus" proot-distro login "$distro" -- pacman -S --noconfirm --needed dbus
        ;;
      dnf)
        run_with_spinner "Installing dbus" proot-distro login "$distro" -- dnf install -y dbus-x11
        ;;
      apk)
        run_with_spinner "Installing dbus" proot-distro login "$distro" -- apk add --no-cache dbus dbus-x11
        ;;
      xbps)
        run_with_spinner "Installing dbus" proot-distro login "$distro" -- xbps-install -y dbus
        ;;
    esac
  fi

  # Install elogind as logind replacement (critical for GNOME/KDE "matching session" error)
  if ! proot-distro login "$distro" -- sh -c "command -v elogind || [ -f /usr/lib/elogind/elogind ] || [ -f /usr/libexec/elogind ]" &>/dev/null; then
    case "$pm" in
      apt)
        proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get install -y elogind libpam-elogind >> "$LOG_FILE" 2>&1 || print_warn "elogind not available (systemd distro) - using fake session env vars instead."
        ;;
      pacman)
        run_with_spinner "Installing elogind" proot-distro login "$distro" -- pacman -S --noconfirm --needed elogind || true
        ;;
      dnf)
        run_with_spinner "Installing elogind" proot-distro login "$distro" -- dnf install -y elogind || true
        ;;
      apk)
        run_with_spinner "Installing elogind" proot-distro login "$distro" -- apk add --no-cache elogind || true
        ;;
      xbps)
        run_with_spinner "Installing elogind" proot-distro login "$distro" -- xbps-install -y elogind || true
        ;;
    esac
  fi

  # Pre-create XDG_RUNTIME_DIR for root and any configured user
  run_with_spinner "Preparing XDG runtime directories" proot-distro login "$distro" -- bash -c "
    for uid in 0 \$(id -u 2>/dev/null); do
      dir=\"/run/user/\$uid\"
      mkdir -p \"\$dir\"
      chmod 700 \"\$dir\"
    done
    mkdir -p /run/dbus
  " || true

  # Remove login1 D-Bus service files so libsystemd/mutter cannot query
  # org.freedesktop.login1 and instead falls back gracefully (proven fix)
  run_with_spinner "Removing login1 D-Bus interface files" proot-distro login "$distro" -- bash -c "
    find /usr -type f -iname '*login1*' -delete 2>/dev/null || true
  " || true

  # Compile mock systemd/logind stub library for GNOME/KDE (compiled with -nostdlib -lgcc)
  if [ "$de" = "gnome" ] || [ "$de" = "kde" ]; then
    # Check if a compiler is available, if not, install gcc
    if ! proot-distro login "$distro" -- sh -c "command -v gcc || command -v clang || command -v cc" &>/dev/null; then
      case "$pm" in
        apt)
          proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
          run_with_spinner "Installing gcc for session helper" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get install -y gcc libc-dev || true
          ;;
        pacman)
          run_with_spinner "Installing gcc for session helper" proot-distro login "$distro" -- pacman -S --noconfirm --needed gcc || true
          ;;
        dnf)
          run_with_spinner "Installing gcc for session helper" proot-distro login "$distro" -- dnf install -y gcc || true
          ;;
        apk)
          run_with_spinner "Installing gcc for session helper" proot-distro login "$distro" -- apk add --no-cache gcc libc-dev || true
          ;;
        xbps)
          run_with_spinner "Installing gcc for session helper" proot-distro login "$distro" -- xbps-install -y gcc || true
          ;;
      esac
    fi

    # Detect the compiler
    local compiler=""
    if proot-distro login "$distro" -- command -v gcc &>/dev/null; then
      compiler="gcc"
    elif proot-distro login "$distro" -- command -v clang &>/dev/null; then
      compiler="clang"
    elif proot-distro login "$distro" -- command -v cc &>/dev/null; then
      compiler="cc"
    fi

    if [ -n "$compiler" ]; then
      run_with_spinner "Compiling systemd session mock library" proot-distro login "$distro" -- bash -c '
        cat << "EOF" > /tmp/libfake-logind.c
#define _GNU_SOURCE
#include <sys/types.h>

// Forward declarations of libc functions since we compile with -nostdlib
void *malloc(size_t size);
void free(void *ptr);
char *strdup(const char *s);
char *getenv(const char *name);
uid_t getuid(void);

int sd_pid_get_session(pid_t pid, char **session) {
    if (session) {
        *session = strdup("1");
    }
    return 0;
}

int sd_session_get_type(const char *session, char **type) {
    if (type) {
        *type = strdup("x11");
    }
    return 0;
}

int sd_session_get_class(const char *session, char **class) {
    if (class) {
        *class = strdup("user");
    }
    return 0;
}

int sd_session_get_state(const char *session, char **state) {
    if (state) {
        *state = strdup("active");
    }
    return 0;
}

int sd_session_is_active(const char *session) {
    return 1;
}

int sd_uid_get_display(uid_t uid, char **session) {
    if (session) {
        *session = strdup("1");
    }
    return 0;
}

int sd_pid_get_owner_uid(pid_t pid, uid_t *uid) {
    if (uid) {
        *uid = getuid();
    }
    return 0;
}

int sd_session_get_display(const char *session, char **display) {
    if (display) {
        const char *d = getenv("DISPLAY");
        if (d) {
            *display = strdup(d);
        } else {
            *display = strdup(":1");
        }
    }
    return 0;
}

int sd_session_get_seat(const char *session, char **seat) {
    if (seat) {
        *seat = strdup("seat0");
    }
    return 0;
}

int sd_session_get_service(const char *session, char **service) {
    if (service) {
        *service = strdup("gnome-shell");
    }
    return 0;
}

int sd_session_get_tty(const char *session, char **tty) {
    if (tty) {
        *tty = strdup("tty1");
    }
    return 0;
}

int sd_session_get_vt(const char *session, int *vt) {
    if (vt) {
        *vt = 1;
    }
    return 0;
}
EOF
        mkdir -p /usr/local/lib
        chmod 755 /usr/local/lib
        '"$compiler"' -shared -fPIC -nostdlib -o /usr/local/lib/libfake-logind.so /tmp/libfake-logind.c -lgcc
        chmod 755 /usr/local/lib/libfake-logind.so
        rm -f /tmp/libfake-logind.c
      ' || print_warn "Failed to compile systemd session mock library."
    else
      print_warn "Compiler not found inside container; skipping systemd session mock compilation."
    fi
  fi
}

confirm_fallback() {
  local distro="$1" failed_de="$2" suggested_de="$3" reason="$4"
  echo "" >/dev/tty
  print_warn "Desktop environment '${failed_de}' failed to launch in ${distro}." >/dev/tty
  print_warn "Reason: ${reason}" >/dev/tty
  echo "" >/dev/tty
  print_info "We suggest falling back to the highly compatible '${suggested_de}' desktop environment." >/dev/tty
  print_info "This environment requires fewer session management services and is fully supported under proot." >/dev/tty
  echo "" >/dev/tty
  
  local confirm=""
  read -rp "$(echo -e "${YELLOW}Would you like to transition and install/run '${suggested_de}' instead? [Y/n]: ${RESET}")" confirm </dev/tty
  confirm="${confirm:-Y}"
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    return 0
  else
    return 1
  fi
}

# -----------------------------------------------------------------------------
# Launch desktop
# -----------------------------------------------------------------------------

launch_desktop() {
  local distro="$1" de="$2" user="$3" display="$4" no_repair="$5"
  display="${display:-:0}"

  # Terminate any orphaned host logins for this distro to release lock handles
  pkill -f "proot-distro login ${distro}" 2>/dev/null || true

  ACTIVE_DISTRO="$distro"

  # Perform desktop environment packages installation checks
  print_step "Verifying container configuration..."
  
  local dbus_missing=0
  local pulse_missing=0
  
  if ! proot-distro login "$distro" -- sh -c "env PATH=\$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin command -v dbus-launch || [ -f /usr/bin/dbus-launch ] || [ -f /usr/local/bin/dbus-launch ] || [ -f /bin/dbus-launch ]" &>/dev/null; then
    dbus_missing=1
  fi
  if ! proot-distro login "$distro" -- sh -c "env PATH=\$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin command -v pulseaudio || [ -f /usr/bin/pulseaudio ] || [ -f /usr/local/bin/pulseaudio ] || [ -f /bin/pulseaudio ]" &>/dev/null; then
    pulse_missing=1
  fi

  if [ $dbus_missing -eq 1 ] || [ $pulse_missing -eq 1 ]; then
    local pm
    pm=$(get_distro_pkg_manager "$distro")
    
    run_with_spinner "Optimizing repository mirrors" optimize_distro_mirrors "$distro" "$pm"

    case "$pm" in
      apt)
        run_with_spinner "Clearing locks" proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
        
        proot-distro login "$distro" -- bash -c "
          if [ -f /usr/sbin/update-icon-caches ] && [ ! -f /usr/sbin/update-icon-caches.bak ]; then
            mv /usr/sbin/update-icon-caches /usr/sbin/update-icon-caches.bak
            echo -e '#!/bin/sh\nexit 0' > /usr/sbin/update-icon-caches
            chmod +x /usr/sbin/update-icon-caches
          fi
          if [ -f /usr/bin/gtk-update-icon-cache ] && [ ! -f /usr/bin/gtk-update-icon-cache.bak ]; then
            mv /usr/bin/gtk-update-icon-cache /usr/bin/gtk-update-icon-cache.bak
            echo -e '#!/bin/sh\nexit 0' > /usr/bin/gtk-update-icon-cache
            chmod +x /usr/bin/gtk-update-icon-cache
          fi
        " &>/dev/null || true

        run_with_spinner "Configuring dpkg" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 dpkg --configure -a --force-confdef --force-confold
        if [ $? -ne 0 ]; then
          proot-distro login "$distro" -- bash -c "
            [ -f /usr/sbin/update-icon-caches.bak ] && mv /usr/sbin/update-icon-caches.bak /usr/sbin/update-icon-caches
            [ -f /usr/bin/gtk-update-icon-cache.bak ] && mv /usr/bin/gtk-update-icon-cache.bak /usr/bin/gtk-update-icon-cache
          " &>/dev/null || true
          print_error "Dpkg configuration failed."
          exit 1
        fi

        run_with_spinner "Updating packages" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::Timeout="10" -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
        
        if [ $dbus_missing -eq 1 ]; then
          local dbus_status=0
          run_with_spinner "Installing dbus-x11" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" dbus-x11
          dbus_status=$?
          if [ $dbus_status -ne 0 ]; then
            print_warn "dbus-x11 installation failed. Attempting fallback dbus package..."
            run_with_spinner "Installing dbus" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y --fix-missing -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" dbus
            dbus_status=$?
          fi
          if [ $dbus_status -ne 0 ] || ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            proot-distro login "$distro" -- bash -c "
              [ -f /usr/sbin/update-icon-caches.bak ] && mv /usr/sbin/update-icon-caches.bak /usr/sbin/update-icon-caches
              [ -f /usr/bin/gtk-update-icon-cache.bak ] && mv /usr/bin/gtk-update-icon-cache.bak /usr/bin/gtk-update-icon-cache
            " &>/dev/null || true
            print_error "Failed to install D-Bus system tool."
            exit 1
          fi
        fi
        
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "pulseaudio installation failed. Retrying..."
            run_with_spinner "Installing pulseaudio (retry)" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-missing pulseaudio
            if [ $? -ne 0 ]; then
              print_warn "Failed to install PulseAudio. Audio will be disabled."
            fi
          fi
        fi

        proot-distro login "$distro" -- bash -c "
          [ -f /usr/sbin/update-icon-caches.bak ] && mv /usr/sbin/update-icon-caches.bak /usr/sbin/update-icon-caches
          [ -f /usr/bin/gtk-update-icon-cache.bak ] && mv /usr/bin/gtk-update-icon-cache.bak /usr/bin/gtk-update-icon-cache
        " &>/dev/null || true
        ;;
      apk)
        run_with_spinner "Updating packages" proot-distro login "$distro" -- apk update
        if [ $dbus_missing -eq 1 ]; then
          run_with_spinner "Installing dbus" proot-distro login "$distro" -- apk add --no-cache dbus dbus-x11
          if [ $? -ne 0 ] || ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            print_error "Failed to install D-Bus."
            exit 1
          fi
        fi
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- apk add --no-cache pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "Failed to install PulseAudio. Audio will be disabled."
          fi
        fi
        ;;
      pacman)
        run_with_spinner "Updating packages" proot-distro login "$distro" -- pacman -Sy --noconfirm
        if [ $dbus_missing -eq 1 ]; then
          run_with_spinner "Installing dbus" proot-distro login "$distro" -- pacman -S --noconfirm --needed dbus
          if [ $? -ne 0 ] || ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            print_error "Failed to install D-Bus."
            exit 1
          fi
        fi
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- pacman -S --noconfirm --needed pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "Failed to install PulseAudio. Audio will be disabled."
          fi
        fi
        ;;
      dnf)
        run_with_spinner "Updating packages" proot-distro login "$distro" -- dnf makecache
        if [ $dbus_missing -eq 1 ]; then
          run_with_spinner "Installing dbus" proot-distro login "$distro" -- dnf install -y dbus-x11
          if [ $? -ne 0 ]; then
            run_with_spinner "Installing dbus (fallback)" proot-distro login "$distro" -- dnf install -y dbus
          fi
          if ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            print_error "Failed to install D-Bus."
            exit 1
          fi
        fi
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- dnf install -y pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "Failed to install PulseAudio. Audio will be disabled."
          fi
        fi
        ;;
      xbps)
        run_with_spinner "Updating packages" proot-distro login "$distro" -- xbps-install -Sy
        if [ $dbus_missing -eq 1 ]; then
          run_with_spinner "Installing dbus" proot-distro login "$distro" -- xbps-install -y dbus
          if [ $? -ne 0 ] || ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            print_error "Failed to install D-Bus."
            exit 1
          fi
        fi
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- xbps-install -y pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "Failed to install PulseAudio. Audio will be disabled."
          fi
        fi
        ;;
      emerge)
        run_with_spinner "Updating packages" proot-distro login "$distro" -- emerge --sync
        if [ $dbus_missing -eq 1 ]; then
          run_with_spinner "Installing dbus" proot-distro login "$distro" -- emerge --ask=n sys-apps/dbus
          if [ $? -ne 0 ] || ! proot-distro login "$distro" -- sh -c "command -v dbus-launch" &>/dev/null; then
            print_error "Failed to install D-Bus."
            exit 1
          fi
        fi
        if [ $pulse_missing -eq 1 ]; then
          run_with_spinner "Installing pulseaudio" proot-distro login "$distro" -- emerge --ask=n media-sound/pulseaudio
          if [ $? -ne 0 ]; then
            print_warn "Failed to install PulseAudio. Audio will be disabled."
          fi
        fi
        ;;
    esac

    run_with_spinner "Setting UUID" proot-distro login "$distro" -- dbus-uuidgen --ensure
  fi

  # Apply Session management workarounds
  install_session_management_workarounds "$distro" "$de"

  # Sync /etc/skel to target user's home directory if not already configured
  local target_user="${user:-root}"
  run_with_spinner "Initializing user themes" proot-distro login "$distro" -- bash -c "
    target_home=\"\"
    if [ \"$target_user\" = \"root\" ]; then
      target_home=\"/root\"
    else
      target_home=\$(getent passwd \"$target_user\" | cut -d: -f6 2>/dev/null || echo \"/home/$target_user\")
    fi
    if [ -n \"\$target_home\" ] && [ -d \"/etc/skel\" ] && [ -d \"\$target_home\" ]; then
      (cd /etc/skel && find . -type f 2>/dev/null) | while read -r file; do
        if [ ! -f \"\$target_home/\$file\" ]; then
          mkdir -p \"\$(dirname \"\$target_home/\$file\")\" 2>/dev/null || true
          cp \"/etc/skel/\$file\" \"\$target_home/\$file\" 2>/dev/null || true
          chown \"$target_user:$target_user\" \"\${target_home}/\$file\" 2>/dev/null || true
        fi
      done
    fi
  "

  # Map DE to its start command wrapped with dbus-launch
  local startcmd
  case "$de" in
    xfce4)    startcmd="dbus-launch --exit-with-session startxfce4" ;;
    lxqt)     startcmd="dbus-launch --exit-with-session startlxqt" ;;
    mate)     startcmd="dbus-launch --exit-with-session mate-session" ;;
    kde)      startcmd="dbus-run-session -- bash -c 'export XDG_SESSION_ID=1; export XDG_SESSION_TYPE=x11; export XDG_SESSION_CLASS=user; export XDG_SEAT=seat0; export XDG_VTNR=1; export XDG_RUNTIME_DIR=/run/user/\$(id -u); mkdir -p \$XDG_RUNTIME_DIR && chmod 700 \$XDG_RUNTIME_DIR; if [ -f /usr/local/lib/libfake-logind.so ]; then export LD_PRELOAD=/usr/local/lib/libfake-logind.so; fi; startplasma-x11'" ;;
    gnome)    startcmd="bash -c '
      service dbus start 2>/dev/null || dbus-daemon --system --fork 2>/dev/null || true
      sleep 1
      export XDG_SESSION_ID=1
      export XDG_SESSION_TYPE=x11
      export XDG_SESSION_CLASS=user
      export XDG_SEAT=seat0
      export XDG_VTNR=1
      uid=\$(id -u)
      export XDG_RUNTIME_DIR=/run/user/\$uid
      mkdir -p \$XDG_RUNTIME_DIR && chmod 700 \$XDG_RUNTIME_DIR
      export GNOME_SHELL_SESSION_MODE=gnome
      export MUTTER_DEBUG_DISABLE_SHARED_MEMORY=1
      export NO_AT_BRIDGE=1
      if [ -f /usr/local/lib/libfake-logind.so ]; then export LD_PRELOAD=/usr/local/lib/libfake-logind.so; fi;
      dbus-run-session -- gnome-shell'" ;;
    gnome-flashback) startcmd="XDG_CURRENT_DESKTOP=GNOME-Flashback:GNOME XDG_MENU_PREFIX=gnome-flashback- dbus-launch --exit-with-session bash -c 'metacity & gnome-panel & (sleep 2 && command -v plank &>/dev/null && plank) & (gnome-flashback || /usr/lib/gnome-flashback/gnome-flashback || /usr/libexec/gnome-flashback) & wait'" ;;
    budgie)   startcmd="dbus-launch --exit-with-session budgie-desktop" ;;
    cinnamon) startcmd="dbus-launch --exit-with-session cinnamon-session" ;;
    openbox)  startcmd="dbus-launch --exit-with-session openbox-session" ;;
    *)        startcmd="dbus-launch --exit-with-session ${DE_STARTCMD[$de]}" ;;
  esac

  if [ "$de" = "gnome-flashback" ]; then
    # 1. Ensure Plank binary is installed inside the container
    if ! proot-distro login "$distro" -- command -v plank &>/dev/null; then
      print_step "Plank dock not found inside ${distro}. Installing Plank..."
      run_with_spinner "Updating package index" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y || true
      
      # Try installing the precompiled plank package first
      run_with_spinner "Installing Plank package" proot-distro login "$distro" -- bash -c "
        env DEBIAN_FRONTEND=noninteractive apt-get install -y plank 2>/dev/null || true
      " || true

      # Fallback to compiling plank-reloaded from source if the precompiled package wasn't found/installed
      if ! proot-distro login "$distro" -- command -v plank &>/dev/null; then
        run_with_spinner "Installing dock dependencies" proot-distro login "$distro" -- bash -c "
          env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
            git cmake valac libglib2.0-dev libgtk-3-dev libdbus-glib-1-dev libwnck-3-dev libgee-0.8-dev libbamf3-dev 2>/dev/null || true
        " 2>/dev/null || true

        proot-distro login "$distro" -- bash -c "
          export PATH=\$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
          if command -v cmake &>/dev/null && command -v valac &>/dev/null; then
            cd /tmp && rm -rf plank-reloaded 2>/dev/null || true
            git clone --depth=1 https://github.com/zquestz/plank-reloaded 2>/dev/null && \
            cd plank-reloaded && \
            mkdir -p build && cd build && \
            cmake .. -DCMAKE_INSTALL_PREFIX=/usr 2>/dev/null && \
            make -j2 2>/dev/null && \
            make install 2>/dev/null || true
            cd /tmp && rm -rf plank-reloaded 2>/dev/null || true
          fi
        " >> "$LOG_FILE" 2>&1 || true
      fi
    fi

    # 2. Always ensure autostart profiles are present for the active user if Plank is installed
    proot-distro login "$distro" -- bash -c "
      if command -v plank &>/dev/null; then
        if [ ! -f /etc/skel/.config/autostart/plank.desktop ] || [ ! -f /root/.config/autostart/plank.desktop ] || [ -n \"$user\" -a ! -f /home/\"$user\"/.config/autostart/plank.desktop ]; then
          mkdir -p /etc/skel/.config/autostart /root/.config/autostart
          cat > /etc/skel/.config/autostart/plank.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Plank
Exec=plank
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF
          cp /etc/skel/.config/autostart/plank.desktop /root/.config/autostart/plank.desktop 2>/dev/null || true
          if [ -n \"$user\" ]; then
            u_home=\"/home/$user\"
            [ \"$user\" = \"root\" ] && u_home=\"/root\"
            mkdir -p \"\$u_home/.config/autostart\"
            cp /etc/skel/.config/autostart/plank.desktop \"\$u_home/.config/autostart/plank.desktop\" 2>/dev/null || true
            chown -R \"$user\":\"$user\" \"\$u_home/.config\" 2>/dev/null || true
          fi
        fi
      fi
    " >> "$LOG_FILE" 2>&1 || true
  fi

  local current_desktop
  case "$de" in
    xfce4)    current_desktop="XFCE" ;;
    kde)      current_desktop="KDE" ;;
    gnome)    current_desktop="GNOME" ;;
    gnome-flashback) current_desktop="GNOME" ;;
    lxqt)     current_desktop="LXQt" ;;
    mate)     current_desktop="MATE" ;;
    budgie)   current_desktop="Budgie:GNOME" ;;
    cinnamon) current_desktop="X-Cinnamon" ;;
    *)        current_desktop="GNOME" ;;
  esac

  # Probe GPU
  local GPU_MODEL
  GPU_MODEL=$(probe_gpu)
  print_step "Detecting device GPU hardware..."
  print_info "GPU Detected: ${GPU_MODEL}"

  # Apply OS-level background optimizations automatically
  disable_phantom_killer &>/dev/null || true

  # Build GPU acceleration loop list based on device capabilities
  local MODES=()
  if [ -c "/dev/kgsl-3d0" ]; then
    MODES=("turnip" "virgl_zink" "virgl" "software")
  else
    MODES=("virgl_zink" "virgl" "software")
  fi

  local success=0
  local active_mode=""
  local bind_args=""
  local env_vars=""

  for mode in "${MODES[@]}"; do
    print_step "Attempting launch with GPU acceleration mode: ${mode}..."

    local start_log_lines=0
    if [ -f "$LOG_FILE" ]; then
      start_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
    fi

    # Terminate any existing display servers, VNCs, or VirGL processes on the host
    pkill -9 -f "termux-x11" 2>/dev/null || true
    pkill -9 -f "Xwayland" 2>/dev/null || true
    pkill -9 -f "x11vnc" 2>/dev/null || true
    pkill -9 -f "virgl_test_server" 2>/dev/null || true
    pkill -9 -f "virgl_test_server_android" 2>/dev/null || true
    local d_num="${display#*:}"
    chmod -R 777 "/tmp/.X11-unix" "${TMPDIR}/.X11-unix" 2>/dev/null || true
    rm -f "/tmp/.X11-unix/X${d_num}" "${TMPDIR}/.X11-unix/X${d_num}" 2>/dev/null
    rm -f "/tmp/.X${d_num}-lock" "${TMPDIR}/.X${d_num}-lock" 2>/dev/null
    rm -f "/tmp/.tX${d_num}-lock" "${TMPDIR}/.tX${d_num}-lock" 2>/dev/null

    bind_args=""
    env_vars=""

    case "$mode" in
      turnip)
        install_vulkan_drivers_in_container "$distro"
        bind_args="--bind /dev/kgsl-3d0:/dev/kgsl-3d0"
        env_vars="MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink TU_DEBUG=noconform"

        # Start termux-x11 host server
        start_termux_x11_server "$display"
        ;;
      virgl_zink)
        ensure_host_virglrenderer
        
        # Start host VirGL test server with Zink Vulkan translation
        export XDG_RUNTIME_DIR=${TMPDIR}
        local v_cmd="virgl_test_server"
        if command -v virgl_test_server_android &>/dev/null; then
          v_cmd="virgl_test_server_android"
        fi
        env GALLIUM_DRIVER=zink ${v_cmd} --use-egl-surfaceless --use-gles >/dev/null 2>&1 &
        disown $! 2>/dev/null || true

        # Start termux-x11 host server
        start_termux_x11_server "$display"

        env_vars="GALLIUM_DRIVER=virpipe MESA_GL_VERSION_OVERRIDE=4.0"
        ;;
      virgl)
        ensure_host_virglrenderer

        # Start host VirGL test server standard OpenGL ES translation
        export XDG_RUNTIME_DIR=${TMPDIR}
        local v_cmd="virgl_test_server"
        if command -v virgl_test_server_android &>/dev/null; then
          v_cmd="virgl_test_server_android"
        fi
        ${v_cmd} >/dev/null 2>&1 &
        disown $! 2>/dev/null || true

        # Start termux-x11 host server
        start_termux_x11_server "$display"

        env_vars="GALLIUM_DRIVER=virpipe MESA_GL_VERSION_OVERRIDE=4.0"
        ;;
      software)
        start_termux_x11_server "$display"

        env_vars="LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe"
        ;;
    esac

    # Start host PulseAudio server
    run_with_spinner "Starting audio" bash -c "pulseaudio --start --load='module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1' --exit-idle-time=-1 2>/dev/null || true"

    if command -v termux-wake-lock &>/dev/null; then
      termux-wake-lock
    fi

    # Start wireless VNC server on host
    if ! command -v x11vnc &>/dev/null; then
      run_with_spinner "Installing x11vnc for Wireless Display" bash -c "pkg install x11-repo -y && pkg install x11vnc -y"
    fi
    if command -v x11vnc &>/dev/null; then
      x11vnc -display "${display}" -shared -forever -nopw -rfbport 5900 >/dev/null 2>&1 &
      disown $! 2>/dev/null || true
    fi

    # Launch desktop container process
    local launch_pid
    if [ -n "$user" ]; then
      proot-distro login "$distro" --shared-tmp ${bind_args} -- bash -c \
        "uid=\$(id -u ${user} 2>/dev/null || echo 1000) && uname=\$(id -un ${user} 2>/dev/null || echo ${user}) && mkdir -p /run/user/\$uid /run/dbus /run/systemd/sessions /run/systemd/users /run/systemd/seats && chmod 700 /run/user/\$uid && printf \"UID=\${uid}\nUSER=\${uname}\nACTIVE=1\nSEAT=seat0\nSESSION=1\nTYPE=x11\nCLASS=user\nDESKTOP=gnome\nSTATE=active\nVTNR=1\n\" > /run/systemd/sessions/1 && ln -sf /run/systemd/sessions/1 /run/systemd/sessions/c1 2>/dev/null || true && printf \"\${uid}\n\" > /run/systemd/users/\${uid} && printf 'Sessions=1\nActiveSession=1\nCanSuspend=no\nCanHibernate=no\n' > /run/systemd/seats/seat0 && (command -v elogind >/dev/null 2>&1 && { pgrep -x elogind >/dev/null || elogind & sleep 1; } || true) && unset DBUS_SESSION_BUS_ADDRESS && export PULSE_SERVER=127.0.0.1 && export XDG_RUNTIME_DIR=/run/user/\$uid && export XDG_SESSION_ID=1 && export XDG_SEAT=seat0 && export XDG_VTNR=1 && export XDG_SESSION_TYPE=x11 && export XDG_CURRENT_DESKTOP=\"${current_desktop}\" && export DESKTOP_SESSION=\"${de}\" && export XDG_SESSION_CLASS=user && export XDG_SESSION_DESKTOP=\"${de}\" && export SYSTEMD_IGNORE_CHROOT=1 && export ${env_vars} && su - ${user} -c 'unset DBUS_SESSION_BUS_ADDRESS && env DISPLAY=${display} XDG_SESSION_ID=1 XDG_SEAT=seat0 XDG_VTNR=1 XDG_SESSION_TYPE=x11 SYSTEMD_IGNORE_CHROOT=1 XDG_RUNTIME_DIR=/run/user/\$(id -u) XDG_CURRENT_DESKTOP=\"${current_desktop}\" DESKTOP_SESSION=\"${de}\" XDG_SESSION_CLASS=user XDG_SESSION_DESKTOP=\"${de}\" ${env_vars} ${startcmd}'" >> "$LOG_FILE" 2>&1 &
      launch_pid=$!
      disown $! 2>/dev/null || true
    else
      proot-distro login "$distro" --shared-tmp ${bind_args} -- bash -c \
        "mkdir -p /run/user/0 /run/dbus /run/systemd/sessions /run/systemd/users /run/systemd/seats && chmod 700 /run/user/0 && printf 'UID=0\nUSER=root\nACTIVE=1\nSEAT=seat0\nSESSION=1\nTYPE=x11\nCLASS=user\nDESKTOP=gnome\nSTATE=active\nVTNR=1\n' > /run/systemd/sessions/1 && ln -sf /run/systemd/sessions/1 /run/systemd/sessions/c1 2>/dev/null || true && printf '0\n' > /run/systemd/users/0 && printf 'Sessions=1\nActiveSession=1\nCanSuspend=no\nCanHibernate=no\n' > /run/systemd/seats/seat0 && (command -v elogind >/dev/null 2>&1 && { pgrep -x elogind >/dev/null || elogind & sleep 1; } || true) && unset DBUS_SESSION_BUS_ADDRESS && export PULSE_SERVER=127.0.0.1 && export XDG_RUNTIME_DIR=/run/user/0 && export XDG_SESSION_ID=1 && export XDG_SEAT=seat0 && export XDG_VTNR=1 && export XDG_SESSION_TYPE=x11 && export XDG_CURRENT_DESKTOP=\"${current_desktop}\" && export DESKTOP_SESSION=\"${de}\" && export XDG_SESSION_CLASS=user && export XDG_SESSION_DESKTOP=\"${de}\" && export SYSTEMD_IGNORE_CHROOT=1 && export ${env_vars} && env DISPLAY=${display} ${startcmd}" >> "$LOG_FILE" 2>&1 &
      launch_pid=$!
      disown $! 2>/dev/null || true
    fi

    # Monitor session startup and verify process stays alive for 3 seconds
    local delay=0.15
    local max_iterations=20
    local died=0
    local has_utf8=0
    if [[ "${LANG}" =~ UTF-8 || "${LANG}" =~ utf8 || "${LC_ALL}" =~ UTF-8 || "${LC_CTYPE}" =~ UTF-8 ]]; then
      has_utf8=1
    fi
    local spinner
    if [ $has_utf8 -eq 1 ]; then
      spinner=( "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" )
    else
      spinner=( "/" "-" "\\" "|" )
    fi
    
    tput civis 2>/dev/null || printf "\033[?25l"
    local i
    for ((i=0; i<max_iterations; i++)); do
      if ! kill -0 "$launch_pid" 2>/dev/null; then
        died=1
        break
      fi
      local idx=$((i % ${#spinner[@]}))
      printf "\r\033[K%b[....] Launching session %s" "${WHITE}" "${spinner[idx]}"
      sleep $delay
    done
    tput cnorm 2>/dev/null || printf "\033[?25h"
    printf "\r\033[K"

    if [ $died -eq 0 ]; then
      success=1
      active_mode="$mode"
      break
    else
      local end_log_lines=0
      if [ -f "$LOG_FILE" ]; then
        end_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
      fi
      local mode_log_diff=$((end_log_lines - start_log_lines))
      local mode_errors=""
      if [ $mode_log_diff -gt 0 ]; then
        mode_errors=$(tail -n $mode_log_diff "$LOG_FILE" | grep -v "^$" | grep -E -i "error|failed|fatal|cannot|unable|Failed to setup" | tail -n 5)
        if [ -z "$mode_errors" ]; then
          mode_errors=$(tail -n $mode_log_diff "$LOG_FILE" | grep -v "^$" | tail -n 5)
        fi
      fi

      print_warn "Acceleration mode '${mode}' failed. Cleaning up host servers..."
      if [ -n "$mode_errors" ]; then
        echo -e "${GRAY}      Specific errors / recent logs during '${mode}' attempt:${RESET}"
        echo "$mode_errors" | sed 's/^/      /g'
      fi

      pkill -9 -f "virgl_test_server" 2>/dev/null || true
      pkill -9 -f "virgl_test_server_android" 2>/dev/null || true
      pkill -9 -f "x11vnc" 2>/dev/null || true
      pkill -9 -f "termux-x11" 2>/dev/null || true
      pkill -9 -f "Xwayland" 2>/dev/null || true
    fi
  done

  if [ $success -eq 0 ]; then
    echo ""
    print_error "All hardware acceleration paths and software rendering failed to launch '${de}'."
    echo ""
    print_error "Diagnostic Information:"
    echo "    - Target Distro:       $distro"
    echo "    - Target Desktop:      $de"
    echo "    - Last 10 lines of logs:"
    echo -e "${GRAY}------------------------------------------------------------${RESET}"
    tail -n 10 "$LOG_FILE"
    echo -e "${GRAY}------------------------------------------------------------${RESET}"
    echo ""

    # Determine fallback suggestions
    local suggested=""
    local reason="Missing systemd/logind interfaces or compositor limitations inside proot container"

    case "$de" in
      gnome)
        suggested="gnome-flashback"
        ;;
      kde)
        suggested="lxqt"
        ;;
      *)
        suggested="xfce4"
        ;;
    esac

    if [ "$no_repair" != "1" ]; then
      if [ "$auto_yes" = "y" ] || confirm_fallback "$distro" "$de" "$suggested" "$reason"; then
        print_info "Transitioning to '${suggested}' fallback..."

        if [ "$suggested" = "gnome-flashback" ]; then
          # Install fallback packages if needed
          local pm
          pm=$(get_distro_pkg_manager "$distro")
          local fb_pkg=""
          case "$pm" in
            apt)    fb_pkg="gnome-session-flashback" ;;
            *)      fb_pkg="gnome-flashback" ;;
          esac

          print_step "Installing ${fb_pkg} inside ${distro}..."
          local inst_cmd=""
          case "$pm" in
            apt)
              proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
              inst_cmd="env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" ${fb_pkg} gnome-terminal"
              ;;
            apk)    inst_cmd="apk add --no-cache ${fb_pkg} gnome-terminal" ;;
            pacman) inst_cmd="pacman -S --noconfirm --needed ${fb_pkg}" ;;
            dnf)    inst_cmd="dnf install -y ${fb_pkg}" ;;
            xbps)   inst_cmd="xbps-install -y ${fb_pkg} gnome-terminal" ;;
            *)      inst_cmd="" ;;
          esac

          if [ -n "$inst_cmd" ]; then
            run_with_spinner "Installing GNOME Flashback" proot-distro login "$distro" -- bash -c "$inst_cmd"
          fi

          # Attempt to install plank-reloaded dock for a modern app launcher experience.
          # This is fully optional - if it fails or the repository is unavailable, the
          # session continues normally without it.
          # Try installing the precompiled plank package first
          run_with_spinner "Installing Plank package" proot-distro login "$distro" -- bash -c "
            env DEBIAN_FRONTEND=noninteractive apt-get install -y plank 2>/dev/null || true
          " || true

          if ! proot-distro login "$distro" -- command -v plank &>/dev/null; then
            run_with_spinner "Installing dock dependencies" proot-distro login "$distro" -- bash -c "
              env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
                git cmake valac libglib2.0-dev libgtk-3-dev libdbus-glib-1-dev libwnck-3-dev libgee-0.8-dev libbamf3-dev 2>/dev/null || true
            " 2>/dev/null || true

            proot-distro login "$distro" -- bash -c "
              export PATH=\$PATH:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
              if command -v cmake &>/dev/null && command -v valac &>/dev/null; then
                cd /tmp && rm -rf plank-reloaded 2>/dev/null || true
                git clone --depth=1 https://github.com/zquestz/plank-reloaded 2>/dev/null && \
                cd plank-reloaded && \
                mkdir -p build && cd build && \
                cmake .. -DCMAKE_INSTALL_PREFIX=/usr 2>/dev/null && \
                make -j2 2>/dev/null && \
                make install 2>/dev/null || true
                cd /tmp && rm -rf plank-reloaded 2>/dev/null || true
              fi
            " >> "$LOG_FILE" 2>&1 || true
          fi

          # If plank was installed, configure it to autostart with the session.
          proot-distro login "$distro" -- bash -c "
            if command -v plank &>/dev/null; then
              mkdir -p /etc/skel/.config/autostart /root/.config/autostart
              cat > /etc/skel/.config/autostart/plank.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Plank
Exec=plank
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
EOF
              cp /etc/skel/.config/autostart/plank.desktop /root/.config/autostart/plank.desktop 2>/dev/null || true
              if [ -n \"$user\" ]; then
                u_home=\"/home/$user\"
                [ \"$user\" = \"root\" ] && u_home=\"/root\"
                mkdir -p \"\$u_home/.config/autostart\"
                cp /etc/skel/.config/autostart/plank.desktop \"\$u_home/.config/autostart/plank.desktop\" 2>/dev/null || true
                chown -R \"$user\":\"$user\" \"\$u_home/.config\" 2>/dev/null || true
              fi
            fi
          " >> "$LOG_FILE" 2>&1 || true

          config_set_distro_field "$distro" "last_de" "gnome-flashback"
          exec "$0" start "$distro" "$display" "gnome-flashback" -y --no-repair
        else
          install_desktop_environment "$distro" "$suggested" "y"
          config_set_distro_field "$distro" "last_de" "$suggested"
          exec "$0" start "$distro" "$display" "$suggested" -y --no-repair
        fi
        exit 0
      else
        print_error "User aborted fallback transition. Exiting."
        exit 1
      fi
    else
      print_error "Auto-repair is disabled (--no-repair). Exiting."
      exit 1
    fi
  fi

  # Auto-open local viewer
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true

  config_set_distro_field "$distro" "last_de" "$de"
  config_set_distro_field "$distro" "display" "$display"

  print_success "Session started successfully."
  echo ""
  print_box_top "${GREEN}${BOLD}"
  print_box_line "center" "${GREEN}${BOLD}" "${GREEN}${BOLD}" "Desktop is running!"
  print_box_sep "─" "${GREEN}${BOLD}"
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" "Termux-X11 session active."
  
  local ip_addr
  ip_addr=$(get_lan_ip)

  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" "Multi-Display Output Active:"
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Local Screen: Visible on device display."
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - HDMI Output: Connect USB-C to HDMI monitor."
  if [ "$ip_addr" = "127.0.0.1" ]; then
    print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Wireless: Connect VNC client to 127.0.0.1:5900"
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   To use VNC on other devices:"
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   1. Connect phone to Wi-Fi or turn on Hotspot."
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   2. Restart session to see your local LAN IP."
  else
    print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Wireless: Connect VNC client to ${ip_addr}:5900"
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   To use VNC on other devices:"
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   1. Ensure other device is on the same network"
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "      (same Wi-Fi or connected to phone Hotspot)."
    print_box_line "left" "${GREEN}${BOLD}" "${GRAY}" "   2. Enter IP ${ip_addr} and port 5900 in VNC."
  fi
  print_box_sep "─" "${GREEN}${BOLD}"
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Distro:      ${distro}"
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Desktop:     ${de}"
  if [ -n "$user" ]; then
    print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - User:        ${user}"
  else
    print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - User:        root (passwordless)"
  fi
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Display:     ${display}"
  print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" " - Acceleration: ${active_mode} mode"
  print_box_bottom "${GREEN}${BOLD}"
  echo ""

  echo -e "${BOLD}${CYAN}=== WIRELESS DISPLAY SETUP GUIDE ===${RESET}"
  echo -e "To display your Linux desktop on another device (Smart TV, PC, tablet, monitor):"
  echo ""
  echo -e "1. Connect your phone and the other device to the ${BOLD}same Wi-Fi network${RESET}."
  echo -e "   - OR: Turn on your phone's ${BOLD}Mobile Hotspot${RESET} and connect the other device to it."
  echo ""
  echo -e "2. Install a ${BOLD}VNC Viewer app${RESET} on the other device:"
  echo -e "   - ${WHITE}Android TV / Fire TV / Smart TV${RESET}: Search for ${GREEN}VNC Viewer${RESET} or ${GREEN}bVNC${RESET} in the TV app store."
  echo -e "   - ${WHITE}PC (Windows / Mac / Linux)${RESET}: Download free ${UNDERLINE}RealVNC Viewer${RESET}:"
  echo -e "     ${CYAN}https://www.realvnc.com/en/connect/download/viewer/${RESET}"
  echo -e "   - ${WHITE}Android Phone / Tablet${RESET}: Install RealVNC from Play Store:"
  echo -e "     ${CYAN}https://play.google.com/store/apps/details?id=com.realvnc.viewer.android${RESET}"
  echo -e "   - ${WHITE}iPhone / iPad${RESET}: Install RealVNC from App Store:"
  echo -e "     ${CYAN}https://apps.apple.com/app/vnc-viewer-remote-desktop/id352048331${RESET}"
  echo ""
  if [ "$ip_addr" = "127.0.0.1" ]; then
    echo -e "3. Open the VNC app on that device and connect to: ${BOLD}${YELLOW}[your-phone-network-ip]:5900${RESET}"
    echo -e "   ${RED}Current Status: No active Wi-Fi/Hotspot detected. Defaulting to local 127.0.0.1:5900${RESET}"
  else
    echo -e "3. Open the VNC app on that device and enter this EXACT address to connect:"
    echo -e "   Address/Host:  ${BOLD}${GREEN}${ip_addr}${RESET}"
    echo -e "   Port:          ${BOLD}${GREEN}5900${RESET}"
    echo -e "   (Or enter:     ${BOLD}${GREEN}${ip_addr}:5900${RESET})"
  fi
  echo -e "   No password is required. Just click Connect/OK!"
  echo -e "${BOLD}${CYAN}====================================${RESET}"
  echo ""

  if ! disable_phantom_killer &>/dev/null; then
    print_box_top "${YELLOW}${BOLD}"
    print_box_line "center" "${YELLOW}${BOLD}" "${YELLOW}${BOLD}" "Background Process Restrictions (Signal 9 Killer)"
    print_box_sep "─" "${YELLOW}${BOLD}"
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "Android 12+ may automatically close Termux when switching apps."
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "To permanently prevent this, use one of these methods:"
    print_box_sep "─" "${YELLOW}${BOLD}"
    print_box_line "left" "${YELLOW}${BOLD}" "${GREEN}${BOLD}" "EASY METHOD (Directly on phone, no PC needed):"
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "   1. Open phone Settings > Developer Options."
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "      (If hidden, tap Build Number 7 times in About Phone)."
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "   2. Scroll down and turn ON: \"Disable child process restrictions\""
    print_box_sep "─" "${YELLOW}${BOLD}"
    print_box_line "left" "${YELLOW}${BOLD}" "${GREEN}${BOLD}" "ALTERNATIVE METHOD (Via PC ADB):"
    print_box_line "left" "${YELLOW}${BOLD}" "${WHITE}" "   Run this command in your PC terminal while connected:"
    print_box_line "left" "${YELLOW}${BOLD}" "${CYAN}" "   adb shell \"/system/bin/device_config put activity_manager max_phantom_processes 2147483647\""
    print_box_bottom "${YELLOW}${BOLD}"
    echo ""
  fi

  log "Desktop launched: distro=$distro de=$de user=${user:-root} display=$display acceleration=$active_mode"
}

# -----------------------------------------------------------------------------
# Wizard
# -----------------------------------------------------------------------------
run_wizard() {
  local auto_yes="$1"

  print_header
  check_proot_distro
  check_termux_x11

  print_step "Scanning installed distributions..."
  local installed
  installed=$(get_installed_distros)

  echo -e "${BOLD}${WHITE}Select a distro:${RESET}"
  echo ""

  local options=()
  local i=1
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    local last_de
    last_de=$(config_get_distro_field "$d" "last_de")
    local tag=""
    [ -n "$last_de" ] && tag=" ${GRAY}(last used: ${last_de})${RESET}"
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${d}${RESET}${tag}"
    options+=("$d")
    ((i++))
  done <<< "$installed"

  echo -e "  ${BOLD}[$i]${RESET} ${CYAN}Install a new distro${RESET}"
  echo ""

  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select [1-${i}] (enter for default): ${RESET}")" choice
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
      break
    fi
    print_error "Invalid option."
  done

  local distro is_new=0
  if [ "$choice" -eq "$i" ]; then
    install_new_distro_wizard "$auto_yes"
    distro="$SELECTED_DISTRO"
    is_new=1
  else
    distro="${options[$((choice - 1))]}"
  fi

  # Initialize desktop environment metadata for this specific distro
  init_de_metadata_for_distro "$distro"

  # Always ask user selection (existing distro or new)
  select_user "$distro" "$auto_yes"

  local last_de
  last_de=$(config_get_distro_field "$distro" "last_de")
  local de

  # If last_de is empty, scan distro container for any already installed DEs
  if [ -z "$last_de" ]; then
    local installed_des=()
    for de_opt in "${DE_LIST[@]}"; do
      if de_is_installed "$distro" "$de_opt"; then
        installed_des+=("$de_opt")
      fi
    done
    if [ ${#installed_des[@]} -gt 0 ]; then
      # Prioritize GNOME/XFCE/KDE in default selections if multiple are installed
      local preferred=""
      for p_de in gnome xfce4 kde lxqt mate budgie cinnamon openbox; do
        for i_de in "${installed_des[@]}"; do
          if [ "$i_de" = "$p_de" ]; then
            preferred="$i_de"
            break 2
          fi
        done
      done
      last_de="${preferred:-${installed_des[0]}}"
    fi
  fi

  if [ -n "$last_de" ] && [ "$auto_yes" = "y" ]; then
    de="$last_de"
  else
    if [ -n "$last_de" ]; then
      echo ""
      echo -e "${GRAY}  Last used/installed desktop environment: ${last_de}${RESET}"
      read -rp "$(echo -e "${CYAN}Use ${last_de} again? [Y/n]: ${RESET}")" reuse
      reuse="${reuse:-Y}"
      if [[ "$reuse" =~ ^[Yy]$ ]]; then
        de="$last_de"
      else
        select_desktop_environment "$distro"
        de="$SELECTED_DE"
      fi
    else
      select_desktop_environment "$distro"
      de="$SELECTED_DE"
    fi
  fi

  install_desktop_environment "$distro" "$de" "$auto_yes"

  local display
  display=$(next_display_number)

  launch_desktop "$distro" "$de" "$SELECTED_USER" "$display"
}

# -----------------------------------------------------------------------------
# Distro metadata definitions
# -----------------------------------------------------------------------------
get_distro_meta() {
  local alias="$1"
  case "$alias" in
    ubuntu)
