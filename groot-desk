# -----------------------------------------------------------------------------
# Install new distro wizard
# -----------------------------------------------------------------------------
install_new_distro_wizard() {
  local auto_yes="$1"

  echo ""
  echo -e "${BOLD}${WHITE}Available distros to install:${RESET}"
  echo ""

  # Query distribution list directly, capturing output from log file synchronous session
  local start_lines=0
  if [ -f "$LOG_FILE" ]; then
    start_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
  fi

  run_with_spinner "Fetching distribution list" proot-distro list
  local exit_status=$?

  local raw_list_output=""
  if [ $exit_status -eq 0 ] && [ -f "$LOG_FILE" ]; then
    local total_lines
    total_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
    local new_lines=$((total_lines - start_lines))
    if [ $new_lines -gt 0 ]; then
      raw_list_output=$(tail -n $new_lines "$LOG_FILE")
    fi
  fi

  # Parse available distros from the raw list output
  local parsed=""
  if [ -n "$raw_list_output" ]; then
    parsed=$(echo "$raw_list_output" | while IFS= read -r line; do
      line=$(echo "$line" | sed 's/^[[:space:]]*//')
      [ -z "$line" ] && continue
      local a=""
      if [[ "$line" == *"|"* ]]; then
        a=$(echo "$line" | cut -d'|' -f1 | tr -d '[:space:]')
      elif [[ "$line" == *"(alias:"* ]]; then
        a=$(echo "$line" | sed 's/.*(alias:[[:space:]]*\([^)]*\)).*/\1/' | tr -d '[:space:]')
      elif [[ "$line" == "*"* ]]; then
        a=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*\([^[:space:]]*\).*/\1/' | tr -d '[:space:]')
      else
        a=$(echo "$line" | awk '{print $1}')
      fi
      if [[ "$a" =~ ^[a-z0-9-]+$ ]] && [[ ! "$a" =~ ^(supported|distributions|alias|---) ]]; then
        echo "$a"
      fi
    done)
  fi

  # Scan local plugin files
  local local_files=""
  local etc_dir="$PREFIX/etc/proot-distro"
  if [ -d "$etc_dir" ]; then
    local_files=$(ls "$etc_dir" 2>/dev/null | grep "\.sh$" | sed 's/\.sh$//')
  fi

  # Merge parsed and local files
  local available
  available=$(echo -e "${parsed}\n${local_files}" | grep -E "^[a-z0-9-]+$" | sort -u)

  # Fallback to hardcoded list only if no distros were detected from the system
  if [ -z "$available" ]; then
    available=$(echo -e "ubuntu\ndebian\nalpine\narchlinux\nfedora\nopensuse\nvoid\nkali\ngentoo\nmanjaro\nartix\ndeepin\nopenkylin\npardus\nadelie\nalmalinux\nchimera\nrocky\ntrisquel\noracle\ntermux" | sort -u)
  fi

  local options=()
  local i=1

  while IFS= read -r alias; do
    [ -z "$alias" ] && continue
    
    local parsed_name="" parsed_comment=""
    local line_num next_line line
    # Match the alias in the raw_list_output in-memory (instantaneous)
    line_num=$(echo "$raw_list_output" | grep -n -E "^[[:space:]]*\*[[:space:]]*${alias}([[:space:]]|\()" | cut -d: -f1 | head -n 1)
    if [ -n "$line_num" ]; then
      line=$(echo "$raw_list_output" | sed -n "${line_num}p")
      line=$(echo "$line" | sed 's/^[[:space:]]*//')
      
      # Try single-line format
      if [[ "$line" == *"|"* ]]; then
        parsed_name=$(echo "$line" | cut -d'|' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        parsed_comment=$(echo "$line" | cut -d'|' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      elif [[ "$line" == *"(alias:"* ]] && [[ "$line" == *" - "* || "$line" == *" ) "* ]]; then
        parsed_name=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*//;s/[[:space:]]*(alias:.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        parsed_comment=$(echo "$line" | sed 's/.*alias:[^)]*)//' | sed 's/^[[:space:]]*-//;s/^[[:space:]]*//;s/[[:space:]]*$//')
      fi
      
      # Try multi-line format
      if [ -z "$parsed_comment" ]; then
        next_line=$(echo "$raw_list_output" | sed -n "$((line_num + 1))p")
        if [[ "$next_line" == *"System:"* ]]; then
          parsed_comment=$(echo "$next_line" | sed 's/^[[:space:]]*System:[[:space:]]*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
          parsed_name=$(echo "$line" | sed 's/^[[:space:]]*\*[[:space:]]*//;s/[[:space:]]*(alias:.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        fi
      fi
    fi
    
    local meta
    meta=$(get_distro_meta "$alias" "$parsed_name" "$parsed_comment")
    local d_name
    d_name=$(echo "$meta" | cut -d'|' -f1)
    local d_desc
    d_desc=$(echo "$meta" | cut -d'|' -f2)
    local d_size
    d_size=$(echo "$meta" | cut -d'|' -f3)
    
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${alias}${RESET} (${d_name})"
    echo -e "      ${GRAY}${d_size}  ${d_desc}${RESET}"
    echo ""
    
    options+=("$alias")
    ((i++))
  done <<< "$available"

  # Add Custom OCI option
  echo -e "  ${BOLD}[$i]${RESET} ${WHITE}Custom${RESET} (Docker Hub OCI image)"
  echo -e "      ${GRAY}Search and install any custom OCI distribution from Docker Hub.${RESET}"
  echo ""
  options+=("custom")
  ((i++))

  echo ""
  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select distro to install [1-$((i-1))] (enter for default): ${RESET}")" choice
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$i" ]; then
      break
    fi
    print_error "Invalid option."
  done

  local distro="${options[$((choice - 1))]}"
  
  if [ "$distro" = "custom" ]; then
    local custom_res
    custom_res=$(run_custom_distro_search_flow)
    if [ -n "$custom_res" ]; then
      local alias_name image_name
      alias_name=$(echo "$custom_res" | cut -d'|' -f1)
      image_name=$(echo "$custom_res" | cut -d'|' -f2)
      
      config_set_distro_field "$alias_name" "oci_image" "$image_name"
      config_set_distro_field "$alias_name" "custom_distro" "1"
      
      if cmd_install "$alias_name" "$image_name"; then
        SELECTED_DISTRO="$alias_name"
      else
        SELECTED_DISTRO=""
      fi
    else
      install_new_distro_wizard "$auto_yes"
    fi
  else
    if cmd_install "$distro"; then
      SELECTED_DISTRO="$distro"
    else
      SELECTED_DISTRO=""
    fi
  fi
}

# -----------------------------------------------------------------------------
# Quick start: groot-desk start <distro> [display_id] [de] [-y]
# -----------------------------------------------------------------------------
cmd_start() {
  local distro="$1" display_or_id="$2" de_arg="$3" auto_yes="$4" no_repair="$5"

  check_proot_distro
  check_termux_x11 "$distro"

  if [ -z "$distro" ]; then
    run_wizard ""
    return
  fi

  # Resolve distro by name or alias
  local installed
  installed=$(get_installed_distros)

  if ! echo "$installed" | grep -qx "$distro"; then
    # Try matching partial or numbered id
    local matches
    matches=$(echo "$installed" | grep "$distro")
    local count
    count=$(echo "$matches" | grep -c .)
    if [ "$count" -eq 1 ]; then
      distro="$matches"
    elif [ "$count" -gt 1 ]; then
      print_warn "Multiple distros match '${distro}':"
      echo "$matches"
      print_info "Use a more specific name."
      exit 1
    else
      print_error "Distro '${distro}' is not installed."
      exit 1
    fi
  fi

  # Determine display
  local display
  if [[ "$display_or_id" =~ ^:[0-9]+$ ]]; then
    display="$display_or_id"
  else
    local v_only
    v_only=$(config_get_distro_field "${distro:-global}" "vnc_only")
    v_only="${v_only:-1}"
    local start_num=1
    if [ "$v_only" = "1" ]; then
      start_num=2
    fi
    display=$(next_display_number_from "$start_num")
  fi

  # Determine DE
  local de
  if [ -n "$de_arg" ] && [ -n "${DE_PACKAGE[$de_arg]}" ]; then
    de="$de_arg"
  else
    local last_de
    last_de=$(config_get_distro_field "$distro" "last_de")
    
    # If last_de is empty, scan distro container for any already installed DEs
    if [ -z "$last_de" ]; then
      local installed_des=()
      for de_opt in "${DE_LIST[@]}"; do
        if de_is_installed "$distro" "$de_opt"; then
          installed_des+=("$de_opt")
        fi
      done
      if [ ${#installed_des[@]} -gt 0 ]; then
        # Prioritize GNOME/XFCE/KDE in default selections if multiple are installed
        local preferred=""
        for p_de in gnome xfce4 kde lxqt mate budgie cinnamon openbox; do
          for i_de in "${installed_des[@]}"; do
            if [ "$i_de" = "$p_de" ]; then
              preferred="$i_de"
              break 2
            fi
          done
        done
        last_de="${preferred:-${installed_des[0]}}"
      fi
    fi

    if [ -n "$last_de" ]; then
      de="$last_de"
    else
      select_desktop_environment "$distro"
      de="$SELECTED_DE"
    fi
  fi

  install_desktop_environment "$distro" "$de" "$auto_yes"
  local saved_user
  saved_user=$(config_get_distro_field "$distro" "user")

  local started_triple=0
  if [ -z "$display_or_id" ]; then
    # Start Display :1 (Termux:X11 / VNC port 5900)
    print_step "Launching Termux:X11 session on display :1..."
    launch_desktop "$distro" "$de" "$saved_user" ":1" "$no_repair" "1" || true

    # Start Display :2 (Wireless / VNC port 5901)
    print_step "Launching Independent Wireless session on display :2..."
    launch_desktop "$distro" "$de" "$saved_user" ":2" "$no_repair" "1" || true

    # Start Display :3 (HDMI / VNC port 5902)
    print_step "Launching Independent HDMI session on display :3..."
    launch_desktop "$distro" "$de" "$saved_user" ":3" "$no_repair" "1" || true

    started_triple=1
    # Save display :2 as the dynamic config reference so status and stop can refer to it
    config_set_distro_field "$distro" "display" ":2"
  else
    launch_desktop "$distro" "$de" "$saved_user" "$display" "$no_repair" "0"
  fi

  if [ "$started_triple" = "1" ]; then
    # Auto-open local viewer if termux-x11 is installed
    if command -v termux-x11 &>/dev/null; then
      am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
    fi

    config_set_distro_field "$distro" "last_de" "$de"

    print_success "Multi-display session started successfully."
    echo ""
    print_box_top "${GREEN}${BOLD}"
    print_box_line "center" "${GREEN}${BOLD}" "${GREEN}${BOLD}" "Desktop is running!"
    print_box_sep "─" "${GREEN}${BOLD}"
    
    local ip_addr
    ip_addr=$(get_lan_ip)

    local res_d2 res_d3
    res_d2=$(config_get_distro_field "${distro:-global}" "resolution")
    if [ -z "$res_d2" ]; then
      res_d2=$(detect_display_resolution ":2")
    fi
    res_d3=$(detect_display_resolution ":3")

    print_box_line "left" "${GREEN}${BOLD}" "${WHITE}" "Multi-Display Session Active (Independent displays):"
