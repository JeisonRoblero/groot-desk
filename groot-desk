    echo -e "  ${GRAY}  ${DE_SIZE[$de]} - ${DE_DESC[$de]}${RESET}"
    echo ""
  done

  echo -e "${BOLD}Examples:${RESET}"
  echo -e "  ${GRAY}groot-desk install kali${RESET}"
  echo -e "  ${GRAY}groot-desk install mydebian debian:12${RESET}"
  echo -e "  ${GRAY}groot-desk install mykali kalilinux/kali-rolling:latest${RESET}"
  echo -e "  ${GRAY}groot-desk miracast ubuntu${RESET}"
  echo -e "  ${GRAY}groot-desk miracast 2${RESET}"
  echo -e "  ${GRAY}groot-desk start ubuntu${RESET}"
  echo -e "  ${GRAY}groot-desk start kali :2 xfce4${RESET}"
  echo -e "  ${GRAY}groot-desk start ubuntu -y${RESET}"
  echo -e "  ${GRAY}groot-desk mode kali cpu${RESET}"
  echo -e "  ${GRAY}groot-desk mode kali standalone${RESET}"
  echo -e "  ${GRAY}groot-desk stop kali${RESET}"
  echo -e "  ${GRAY}groot-desk reset kali${RESET}"
  echo -e "  ${GRAY}groot-desk remove-desk kali${RESET}"
  echo -e "  ${GRAY}groot-desk delete kali${RESET}"
  echo -e "  ${GRAY}groot-desk list${RESET}"
  echo ""
}

