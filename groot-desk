  esac
}

search_guest_de_packages() {
  local distro="$1" pm="$2" keyword="$3"
  case "$pm" in
    apt)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        apt-cache search \"$keyword\" 2>/dev/null | sed -E 's/^[[:space:]]*([^[:space:]]+)[[:space:]]+-[[:space:]]+(.*)$/\1|\2/'
      "
      ;;
    apk)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        apk search -v -d \"$keyword\" 2>/dev/null | sed -E 's/^([^ -]+)-[0-9][^ ]* - (.*)$/\1|\2/'
      "
      ;;
    pacman)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        pacman -Ss \"$keyword\" 2>/dev/null | awk '
          NR%2==1 {
            split(\$1, a, \"/\");
            pkg=a[2] ? a[2] : a[1];
          }
          NR%2==0 {
            sub(/^[ \t]+/, \"\");
            print pkg \"|\" \$0;
          }
        '
      "
      ;;
    dnf)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        dnf search \"$keyword\" 2>/dev/null | grep ' : ' | sed -E 's/^([^.]+)\.[^ ]+[[:space:]]*:[[:space:]]*(.*)$/\1|\2/'
      "
      ;;
    xbps)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        xbps-query -Rs \"$keyword\" 2>/dev/null | sed -E 's/^\[.\] ([^ -]+)-[0-9][^ ]* (.*)$/\1|\2/'
      "
      ;;
    emerge)
      proot-distro login "$distro" -- sh -c "
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        emerge --search \"$keyword\" 2>/dev/null | awk '
          /^\*/ { pkg=\$2; sub(/^.*\//, \"\", pkg); }
          /Description:/ { sub(/^.*Description:[ \t]*/, \"\"); print pkg \"|\" \$0; }
        '
      "
      ;;
  esac
}

load_custom_des_from_config() {
  if [ -f "$CONFIG_FILE" ] && command -v jq &>/dev/null; then
    local stored_des
    stored_des=$(jq -r '.distros | to_entries[] | .value.last_de // empty' "$CONFIG_FILE" 2>/dev/null | sort -u)
    for sde in $stored_des; do
      if [ -n "$sde" ] && [[ ! " ${DE_LIST[*]} " == *" $sde "* ]]; then
        DE_PACKAGE["$sde"]="$sde"
        DE_DESC["$sde"]="Custom desktop environment: $sde"
        DE_SIZE["$sde"]="unknown size"
        DE_GENERIC_PACKAGE["$sde"]="$sde"
        if [[ ! " ${DE_LIST[*]} " == *" $sde "* ]]; then
          DE_LIST+=("$sde")
        fi
      fi
    done
    local installed_pkg_keys
    installed_pkg_keys=$(jq -r '.distros | to_entries[] | .value | to_entries[] | select(.key | startswith("installed_pkg_")) | .key' "$CONFIG_FILE" 2>/dev/null | sort -u)
    for k in $installed_pkg_keys; do
      local sde="${k#installed_pkg_}"
      if [ -n "$sde" ] && [[ ! " ${DE_LIST[*]} " == *" $sde "* ]]; then
        DE_PACKAGE["$sde"]="$sde"
        DE_DESC["$sde"]="Custom desktop environment: $sde"
        DE_SIZE["$sde"]="unknown size"
        DE_GENERIC_PACKAGE["$sde"]="$sde"
        if [[ ! " ${DE_LIST[*]} " == *" $sde "* ]]; then
          DE_LIST+=("$sde")
        fi
      fi
    done
  fi
}

stub_distro_tools() {
  local distro="$1"
  local pm
  pm=$(get_distro_pkg_manager "$distro")
  if [ "$pm" = "apt" ]; then
    proot-distro login "$distro" -- bash -c '
      if [ -f /etc/apt/apt.conf.d/90_zsys_system_autosnapshot ]; then
        sed -i "s/^DPkg::Pre-Invoke/# DPkg::Pre-Invoke/g; s/^DPkg::Post-Invoke/# DPkg::Post-Invoke/g" /etc/apt/apt.conf.d/90_zsys_system_autosnapshot
      fi
      if [ ! -f /usr/sbin/policy-rc.d ]; then
        echo -e "#!/bin/sh\nexit 101" > /usr/sbin/policy-rc.d
        chmod +x /usr/sbin/policy-rc.d
        touch /usr/sbin/policy-rc.d.created_by_groot
      fi
      for cmd in updatedb updatedb.plocate systemctl invoke-rc.d update-rc.d service deb-systemd-invoke deb-systemd-helper initctl; do
        for dir in /usr/bin /usr/sbin /bin /sbin; do
          if [ -f "$dir/$cmd" ] && [ ! -f "$dir/$cmd.bak" ]; then
            mv "$dir/$cmd" "$dir/$cmd.bak"
            echo -e "#!/bin/sh\nexit 0" > "$dir/$cmd"
            chmod +x "$dir/$cmd"
          fi
        done
      done
      
      cat << "EOF" > /tmp/groot-run-with-dbus.sh
#!/bin/sh
# Start system bus
mkdir -p /run/dbus /var/run/dbus
rm -f /run/dbus/pid /var/run/dbus/pid
if [ -x /usr/bin/dbus-daemon ]; then
  /usr/bin/dbus-daemon --system --fork --nopidfile &>/dev/null
elif [ -x /bin/dbus-daemon ]; then
  /bin/dbus-daemon --system --fork --nopidfile &>/dev/null
fi

# Start session bus
if [ -x /usr/bin/dbus-launch ]; then
  eval $(/usr/bin/dbus-launch --sh-syntax)
  export DBUS_SESSION_BUS_ADDRESS
  export DBUS_SESSION_BUS_PID
elif [ -x /bin/dbus-launch ]; then
  eval $(/bin/dbus-launch --sh-syntax)
  export DBUS_SESSION_BUS_ADDRESS
  export DBUS_SESSION_BUS_PID
fi

# Run the command
"$@"
status=$?

# Cleanup
if [ -n "$DBUS_SESSION_BUS_PID" ]; then
  kill "$DBUS_SESSION_BUS_PID" &>/dev/null
fi
pkill -9 -f "dbus-daemon" &>/dev/null
rm -f /run/dbus/pid /var/run/dbus/pid /run/dbus/system_bus_socket /var/run/dbus/system_bus_socket

exit $status
EOF
      chmod +x /tmp/groot-run-with-dbus.sh
    ' &>/dev/null || true
  fi
}

restore_distro_tools() {
  local distro="$1"
  local pm
  pm=$(get_distro_pkg_manager "$distro")
  if [ "$pm" = "apt" ]; then
    proot-distro login "$distro" -- bash -c '
      rm -f /tmp/groot-run-with-dbus.sh
      if [ -f /usr/sbin/policy-rc.d.created_by_groot ]; then
        rm -f /usr/sbin/policy-rc.d /usr/sbin/policy-rc.d.created_by_groot
      fi
      for cmd in updatedb updatedb.plocate systemctl invoke-rc.d update-rc.d service deb-systemd-invoke deb-systemd-helper initctl; do
        for dir in /usr/bin /usr/sbin /bin /sbin; do
          if [ -f "$dir/$cmd.bak" ]; then
            mv "$dir/$cmd.bak" "$dir/$cmd"
          fi
        done
      done
    ' &>/dev/null || true
  fi
}

