verify_image_arm_compatibility() {
  local repo="$1"
  repo=$(echo "$repo" | tr -d '\r' | tr -d ' ')
  local url
  if [[ "$repo" != *"/"* ]]; then
    url="https://hub.docker.com/v2/repositories/library/${repo}/tags?page_size=15"
  else
    url="https://hub.docker.com/v2/repositories/${repo}/tags?page_size=15"
  fi
  
  local response
  response=$(curl -sS --connect-timeout 5 "$url" 2>/dev/null | tr -d '\r')
  if [ -n "$response" ] && echo "$response" | grep -qi -E '"architecture":"(arm64|arm)"'; then
    return 0
  else
    return 1
  fi
}

run_custom_distro_search_flow() {
  local query=""
  while true; do
    echo "" >/dev/tty
    read -rp "$(echo -e "${CYAN}Enter distribution name or Docker Hub search query (or C to cancel): ${RESET}")" query </dev/tty
    query=$(echo "$query" | tr -d '\r' | xargs)
    if [ -z "$query" ] || [ "$query" = "C" ] || [ "$query" = "c" ]; then
      return 0
    fi

    # Query Docker Hub Registry API
    local search_url="https://registry.hub.docker.com/v1/search?q=${query}&n=15"
    local raw_results
    raw_results=$(curl -sS --connect-timeout 5 "$search_url" 2>/dev/null | tr -d '\r')
    
    # Parse results using jq
    if [ -z "$raw_results" ] || ! echo "$raw_results" | jq -e '.results | length > 0' &>/dev/null; then
      echo -e "${RED}[error]${RESET} No matching distributions found for \"$query\" on Docker Hub." >/dev/tty
      continue
    fi

    echo "" >/dev/tty
    echo -e "${BOLD}${WHITE}Found matching distributions on Docker Hub:${RESET}" >/dev/tty
    echo "" >/dev/tty

    # Read names and descriptions
    local count=1
    local repo_names=()
    local repo_descs=()
    
    # We parse using jq to output name and description separated by "|"
    local parsed_results
    parsed_results=$(echo "$raw_results" | jq -r '.results[] | "\(.name)|\(.description // "")"' | tr -d '\r')
    
    while IFS="|" read -r name desc; do
      [ -z "$name" ] && continue
      name=$(echo "$name" | tr -d '\r' | tr -d ' ')
      repo_names+=("$name")
      repo_descs+=("$desc")
      
      local official_marker=""
      if [[ "$name" != *"/"* ]]; then
        official_marker=" ${GREEN}(official)${RESET}"
      fi
      
      echo -e "  ${BOLD}[$count]${RESET} ${WHITE}$name${RESET}${official_marker}" >/dev/tty
      [ -n "$desc" ] && echo -e "      ${GRAY}${desc:0:100}${RESET}" >/dev/tty
      echo "" >/dev/tty
      ((count++))
    done <<< "$parsed_results"

    local choice=""
    while true; do
      read -rp "$(echo -e "${CYAN}Select [1-$((count - 1))] to install (or C to cancel and search again): ${RESET}")" choice </dev/tty
      choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
      if [ -z "$choice" ] || [ "$choice" = "C" ] || [ "$choice" = "c" ]; then
        break
      fi
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$((count - 1))" ]; then
        local selected_repo="${repo_names[$((choice - 1))]}"
        selected_repo=$(echo "$selected_repo" | tr -d '\r' | tr -d ' ')
        
        # Verify ARM compatibility
        local check_status=0
        run_with_spinner "Verifying ARM architecture compatibility" verify_image_arm_compatibility "$selected_repo" >&2
        check_status=$?
        
        if [ $check_status -ne 0 ]; then
          echo "" >/dev/tty
          print_warn "Image '$selected_repo' does not appear to have an arm64 or arm build in its tags." >&2
          local proceed=""
          read -rp "$(echo -e "${YELLOW}Attempt to install anyway? [y/N]: ${RESET}")" proceed </dev/tty
          proceed=$(echo "$proceed" | tr -d '\r' | tr -d ' ')
          if [[ ! "$proceed" =~ ^[Yy]$ ]]; then
            continue
          fi
        fi

        # Choose a tag (default to latest or let user specify)
        local tag="latest"
        echo "" >/dev/tty
        read -rp "$(echo -e "${CYAN}Enter image tag (enter for default: latest): ${RESET}")" input_tag </dev/tty
        input_tag=$(echo "$input_tag" | tr -d '\r' | tr -d ' ')
        if [ -n "$input_tag" ]; then
          tag="$input_tag"
        fi

        local full_image="$selected_repo:$tag"

        # Ask user for a local alias name
        local alias_name=""
        local default_alias="${selected_repo#*/}" # e.g. "alpine" from "alpine" or "alpine/git"
        default_alias=$(echo "$default_alias" | tr -d '\r' | tr -d ' ')
        while [ -z "$alias_name" ]; do
          echo "" >/dev/tty
          read -rp "$(echo -e "${CYAN}Enter a local name for this distro (enter for default: $default_alias): ${RESET}")" alias_name </dev/tty
          alias_name=$(echo "$alias_name" | tr -d '\r' | tr -d ' ')
          alias_name="${alias_name:-$default_alias}"
          if [[ ! "$alias_name" =~ ^[a-z0-9-]+$ ]]; then
            echo -e "${RED}[error]${RESET} Local name must contain only lowercase letters, numbers, and hyphens." >/dev/tty
            alias_name=""
          fi
        done

        # Store details and return the configured image + alias details
        echo "$alias_name|$full_image"
        return 0
      fi
      echo -e "${RED}[error]${RESET} Invalid option. Enter a number between 1 and $((count - 1)) or C." >/dev/tty
    done
  done
}

run_custom_de_search_flow() {
  local distro="$1"
  local pm
  pm=$(get_distro_pkg_manager "$distro")

  local query=""
  while true; do
    echo "" >/dev/tty
    read -rp "$(echo -e "${CYAN}Enter desktop environment or package name to search for (or C to cancel): ${RESET}")" query </dev/tty
    query=$(echo "$query" | tr -d '\r' | xargs)
    if [ -z "$query" ] || [ "$query" = "C" ] || [ "$query" = "c" ]; then
      return 0
    fi

    run_with_spinner "Updating package database inside $distro" update_guest_repos "$distro" "$pm" >&2

    local search_results
    search_results=$(search_guest_de_packages "$distro" "$pm" "$query" | head -n 25)

    if [ -z "$search_results" ]; then
      echo -e "${RED}[error]${RESET} No matching packages found for \"$query\" inside $distro catalog." >/dev/tty
      continue
    fi

    echo "" >/dev/tty
    echo -e "${BOLD}${WHITE}Found matching packages in guest store:${RESET}" >/dev/tty
    echo "" >/dev/tty

    local count=1
    local pkgs=()
    local descs=()
    while IFS="|" read -r pkg desc; do
      [ -z "$pkg" ] && continue
      pkgs+=("$pkg")
      descs+=("$desc")
      echo -e "  ${BOLD}[$count]${RESET} ${WHITE}$pkg${RESET}" >/dev/tty
      echo -e "      ${GRAY}$desc${RESET}" >/dev/tty
      echo "" >/dev/tty
      ((count++))
    done <<< "$search_results"

    local choice=""
    while true; do
      read -rp "$(echo -e "${CYAN}Select [1-$((count - 1))] to install (or C to cancel and search again): ${RESET}")" choice </dev/tty
      choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
      if [ -z "$choice" ] || [ "$choice" = "C" ] || [ "$choice" = "c" ]; then
        break
      fi
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$((count - 1))" ]; then
        local selected_pkg="${pkgs[$((choice - 1))]}"
        
        DE_PACKAGE["$selected_pkg"]="$selected_pkg"
        DE_DESC["$selected_pkg"]="${descs[$((choice - 1))]}"
        DE_SIZE["$selected_pkg"]="unknown size"
        DE_GENERIC_PACKAGE["$selected_pkg"]="$selected_pkg"
        
        if [[ ! " ${DE_LIST[*]} " == *" $selected_pkg "* ]]; then
          DE_LIST+=("$selected_pkg")
        fi

        echo "$selected_pkg"
        return 0
      fi
      echo -e "${RED}[error]${RESET} Invalid option. Enter a number between 1 and $((count - 1)) or C." >/dev/tty
    done
  done
}

select_desktop_environment() {
  local distro="$1"
  local de
  echo "" >/dev/tty
  echo -e "${BOLD}${WHITE}Choose a desktop environment:${RESET}" >/dev/tty
  echo "" >/dev/tty

  local i=1
  for de in "${DE_LIST[@]}"; do
    local tag=""
    if [ -n "$distro" ] && de_is_installed "$distro" "$de"; then
      tag="  ${GREEN}(installed)${RESET}"
    elif [ -n "${DE_TAG[$de]}" ]; then
      tag="  ${GREEN}(${DE_TAG[$de]})${RESET}"
    fi
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${de}${RESET}${tag}" >/dev/tty
    echo -e "      ${GRAY}${DE_SIZE[$de]}  ${DE_DESC[$de]}${RESET}" >/dev/tty
    echo "" >/dev/tty
    ((i++))
  done

  # Add Custom option
  echo -e "  ${BOLD}[$i]${RESET} ${WHITE}Custom${RESET}" >/dev/tty
  echo -e "      ${GRAY}Search and install any package or desktop environment from repositories.${RESET}" >/dev/tty
  echo "" >/dev/tty

  # Find the recommended option to use as default, fallback to 1
  local default_choice=1
  local idx=1
  for de in "${DE_LIST[@]}"; do
    if [ "${DE_TAG[$de]}" = "Recommended" ]; then
      default_choice=$idx
      break
    fi
    ((idx++))
  done

  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select [1-$i] (enter for default/recommended): ${RESET}")" choice </dev/tty
    # Trim carriage returns and spaces to handle terminal anomalies
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-$default_choice}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
      if [ "$choice" -eq "$i" ]; then
        local custom_de=""
        custom_de=$(run_custom_de_search_flow "$distro")
        if [ -n "$custom_de" ]; then
          SELECTED_DE="$custom_de"
          return
        else
          select_desktop_environment "$distro"
          return
        fi
      else
        SELECTED_DE="${DE_LIST[$((choice - 1))]}"
        return
      fi
    fi
    echo -e "${RED}[error]${RESET} Invalid option. Enter a number between 1 and $i." >/dev/tty
  done
}

# -----------------------------------------------------------------------------
# Check if DE is installed inside a container
# -----------------------------------------------------------------------------
de_is_installed() {
  local distro="$1" de="$2"
  local cmd="${DE_STARTCMD[$de]}"
  if [ -z "$cmd" ]; then
    # Dynamically resolve startcmd from guest xsessions desktop files
    cmd=$(proot-distro login "$distro" -- sh -c "
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      for f in /usr/share/xsessions/*.desktop; do
        if [ -f \"\$f\" ]; then
          exec_line=\$(grep -i '^Exec=' \"\$f\" | head -n1 | cut -d= -f2-)
          if [ -n \"\$exec_line\" ]; then
            echo \"\$exec_line\" | sed 's/ %[a-zA-Z]//g' | xargs
            exit 0
          fi
        fi
      done
      exit 1
    " 2>/dev/null)
    cmd="${cmd:-$de}"
    DE_STARTCMD[$de]="$cmd"
  fi
  proot-distro login "$distro" -- sh -c "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin command -v $cmd || [ -f /usr/bin/$cmd ] || [ -f /usr/local/bin/$cmd ] || [ -f /bin/$cmd ] || [ -f /usr/sbin/$cmd ]" &>/dev/null
}

install_desktop_environment() {
  local distro="$1" de="$2" auto_yes="$3"
  ACTIVE_DISTRO="$distro"

  # Initialize desktop environment metadata for this specific distro
  init_de_metadata_for_distro "$distro"
  local pkg="${DE_PACKAGE[$de]}"
  local generic_pkg="${DE_GENERIC_PACKAGE[$de]}"
  local pm
  pm=$(get_distro_pkg_manager "$distro")

  # For apt-based unknown distros, probe which specific metapackage actually exists
  # before falling back to generics. This ensures the best available
  # distro-specific package is installed and can be cleanly removed.
  local custom_distro
  custom_distro=$(config_get_distro_field "$distro" "custom_distro")
  if [ "$pm" = "apt" ] && { [ "$pkg" = "$generic_pkg" ] || [ "${custom_distro}" = "1" ]; }; then
    print_step "Probing available desktop packages for ${de} in ${distro}..."
    local probe_candidates=""
    case "$de" in
      xfce4)    probe_candidates="kali-desktop-xfce xubuntu-desktop task-xfce-desktop xfce4" ;;
      lxqt)     probe_candidates="kali-desktop-lxqt lubuntu-desktop task-lxqt-desktop lxqt" ;;
      mate)     probe_candidates="kali-desktop-mate ubuntu-mate-desktop task-mate-desktop mate-desktop-environment" ;;
      kde)      probe_candidates="kali-desktop-kde kubuntu-desktop task-kde-desktop kde-plasma-desktop" ;;
      gnome)    probe_candidates="kali-desktop-gnome ubuntu-desktop task-gnome-desktop gnome-session-flashback" ;;
      budgie)   probe_candidates="ubuntu-budgie-desktop budgie-desktop" ;;
      cinnamon) probe_candidates="kali-desktop-cinnamon cinnamon-desktop-environment task-cinnamon-desktop cinnamon" ;;
      openbox)  probe_candidates="openbox" ;;
    esac
    local probed_pkg=""
    for candidate in $probe_candidates; do
      local found
      found=$(proot-distro login "$distro" -- bash -c \
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin apt-cache show '$candidate' 2>/dev/null | grep -c '^Package:'" 2>/dev/null || true)
      found="${found:-0}"
      if [ "$found" -gt 0 ] 2>/dev/null; then
        probed_pkg="$candidate"
        log "Probed: found $candidate for $de in $distro"
        break
      fi
    done
    if [ -n "$probed_pkg" ]; then
      pkg="$probed_pkg"
      print_success "Using package: ${pkg}"
    else
      log "Probe found nothing for $de in $distro, using generic: $pkg"
    fi
  fi

  # Record exactly which package is going to be installed so remove-desk
  # can cleanly purge it later without guessing
  config_set_distro_field "$distro" "installed_pkg_${de}" "$pkg"
  log "Recording install package for $de in $distro: $pkg"

  if de_is_installed "$distro" "$de"; then
    print_success "${de} is already installed in ${distro}."
    return 0
  fi

  if [ "$auto_yes" != "y" ]; then
    read -rp "$(echo -e "${YELLOW}${de} is not installed. Install it? [Y/n]: ${RESET}")" confirm
    confirm="${confirm:-Y}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      print_error "Cannot continue without a desktop environment."
      exit 1
    fi
  fi

  print_step "Installing ${de} inside ${distro}..."
  log "Installing DE: $de in distro: $distro"

  local start_log_lines=0
  if [ -f "$LOG_FILE" ]; then
    start_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
  fi

  local pm
  pm=$(get_distro_pkg_manager "$distro")
  local install_cmd=""

  run_with_spinner "Optimizing repository mirrors" optimize_distro_mirrors "$distro" "$pm"

  case "$pm" in
    apt)
      stub_distro_tools "$distro"
      # Force-clean cached package lists to ensure fresh, non-404 mirror updates on rolling-release distros
      run_with_spinner "Cleaning package index cache" proot-distro login "$distro" -- bash -c \
        "rm -rf /var/lib/apt/lists/* && env DEBIAN_FRONTEND=noninteractive apt-get clean"
      
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
      install_cmd="env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" -o APT::Solver=internal --fix-broken --fix-missing --allow-downgrades $pkg"
      ;;
    apk)
      run_with_spinner "Cleaning package index cache" proot-distro login "$distro" -- rm -rf /var/cache/apk/*
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- apk update
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="apk add --no-cache $pkg"
      ;;
    pacman)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- pacman -Sy --noconfirm
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="pacman -Syu --noconfirm --needed --overwrite '*' $pkg"
      ;;
    dnf)
      run_with_spinner "Cleaning package cache" proot-distro login "$distro" -- dnf clean all
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- dnf makecache
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="dnf install -y $pkg"
      ;;
    xbps)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- xbps-install -Sy
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="xbps-install -y $pkg"
      ;;
    emerge)
      run_with_spinner "Updating package lists inside ${distro}" proot-distro login "$distro" -- emerge --sync
      if [ $? -ne 0 ]; then
        print_error "Failed to update packages inside ${distro}."
        exit 1
      fi
      install_cmd="emerge --ask=n $pkg"
      ;;
  esac

  if [ "$pm" = "apt" ]; then
    run_with_spinner "Downloading and installing packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "$install_cmd"
  else
    run_with_spinner "Downloading and installing packages" proot-distro login "$distro" -- bash -c "$install_cmd"
  fi
  local status=$?

  local repair_attempted=0
  local generic_fallback_attempted=0

  if [ $status -ne 0 ]; then
    print_warn "Initial installation command failed with exit status $status. Running package database repair..."
    repair_attempted=1
    case "$pm" in
      apt)
        run_with_spinner "Clearing package manager locks" proot-distro login "$distro" -- rm -f /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>/dev/null
        run_with_spinner "Configuring dpkg database" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold
        run_with_spinner "Fixing broken dependencies" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive apt-get install -f -y -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades
        run_with_spinner "Upgrading base packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y --fix-broken -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
        local retry_cmd="${install_cmd}"
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "$retry_cmd"
        status=$?
        ;;
      pacman)
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- pacman -Syy --noconfirm
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$install_cmd"
        status=$?
        ;;
      dnf)
        run_with_spinner "Updating packages (retry)" proot-distro login "$distro" -- dnf clean all && dnf makecache
        local retry_cmd="${install_cmd} --skip-broken"
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$retry_cmd"
        status=$?
        ;;
      *)
        run_with_spinner "Retrying installation" proot-distro login "$distro" -- bash -c "$install_cmd"
        status=$?
        ;;
    esac
  fi

  # Auto-repair for "Success with missing files" case
  if [ $status -eq 0 ] && ! de_is_installed "$distro" "$de"; then
    print_warn "Package manager reported success, but desktop files are missing (broken package state). Attempting auto-repair..."
    log "Auto-repair triggered for $de in $distro"
    repair_attempted=1

    local purge_pkgs
    purge_pkgs=$(get_de_purge_packages "$distro" "$pm" "$de")

    case "$pm" in
      apt)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c \
          "to_purge=''; for pattern in $purge_pkgs; do pkgs=\$(dpkg-query -W -f='\${Package}\n' \"\$pattern\" 2>/dev/null | awk '{print \$1}'); if [ -n \"\$pkgs\" ]; then to_purge=\"\$to_purge \$pkgs\"; fi; done; if [ -n \"\$to_purge\" ]; then env DEBIAN_FRONTEND=noninteractive apt-get purge -y --allow-remove-essential \$to_purge; fi"
        run_with_spinner "Auto-removing packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y || true"
        run_with_spinner "Re-updating package lists" proot-distro login "$distro" -- env DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::http::No-Cache=true -o Acquire::http::Max-Age=0 || true
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y --reinstall -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" -o APT::Solver=internal --fix-broken --fix-missing --allow-downgrades $pkg
        status=$?
        ;;
      pacman)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- bash -c \
          "to_purge=''; for p in $purge_pkgs; do if pacman -Q \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; done; if [ -n \"\$to_purge\" ]; then pacman -Rns --noconfirm \$to_purge; fi"
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- pacman -Syu --noconfirm --needed --overwrite '*' "$pkg"
        status=$?
        ;;
      dnf)
        run_with_spinner "Purging broken package state" proot-distro login "$distro" -- bash -c \
          "to_purge=''; for p in $purge_pkgs; do if [[ \"\$p\" =~ ^@ ]]; then g=\"\${p#@}\"; if dnf group list installed \"\$g\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; else if dnf list installed \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; fi; done; if [ -n \"\$to_purge\" ]; then dnf remove -y \$to_purge; fi"
        run_with_spinner "Re-installing desktop packages" proot-distro login "$distro" -- dnf install -y --reinstall "$pkg"
        status=$?
        ;;
      *)
        status=1
        ;;
    esac
  fi

  # Fallback to generic packages if primary package failed to produce working desktop
  local generic_pkg="${DE_GENERIC_PACKAGE[$de]}"
  local needs_fallback=0
  if [ $status -ne 0 ]; then
    needs_fallback=1
  elif ! de_is_installed "$distro" "$de"; then
    needs_fallback=1
  fi

  if [ $needs_fallback -eq 1 ] && [ -n "$generic_pkg" ] && [ "$pkg" != "$generic_pkg" ]; then
    print_warn "Distro-specific package ($pkg) did not produce desktop binaries. Attempting to install generic package ($generic_pkg) as fallback..."
    log "Generic fallback triggered for $de in $distro: $generic_pkg"
    generic_fallback_attempted=1

    local fallback_cmd=""
    case "$pm" in
      apt)
        fallback_cmd="env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get install -y -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" -o APT::Solver=internal --fix-broken --fix-missing --allow-downgrades $generic_pkg"
        ;;
      apk)
        fallback_cmd="apk add --no-cache $generic_pkg"
        ;;
      pacman)
        fallback_cmd="pacman -Syu --noconfirm --needed --overwrite '*' $generic_pkg"
        ;;
      dnf)
        fallback_cmd="dnf install -y $generic_pkg"
        ;;
      xbps)
        fallback_cmd="xbps-install -y $generic_pkg"
        ;;
      emerge)
        fallback_cmd="emerge --ask=n $generic_pkg"
        ;;
    esac

    if [ -n "$fallback_cmd" ]; then
      if [ "$pm" = "apt" ]; then
        run_with_spinner "Installing fallback packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "$fallback_cmd"
      else
        run_with_spinner "Installing fallback packages" proot-distro login "$distro" -- bash -c "$fallback_cmd"
      fi
      status=$?
      
      if [ $status -ne 0 ] && [ "$pm" = "apt" ]; then
        run_with_spinner "Fixing broken dependencies" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive apt-get install -f -y -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades
        run_with_spinner "Upgrading base packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y --fix-broken -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades
        run_with_spinner "Retrying fallback packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh env DEBIAN_FRONTEND=noninteractive apt-get install -y --fix-broken --fix-missing -o APT::Solver=internal --allow-downgrades $generic_pkg
        status=$?
      fi
    fi
  fi

  if [ $status -eq 0 ] && de_is_installed "$distro" "$de"; then
    if [ $generic_fallback_attempted -eq 1 ]; then
      print_success "${de} installed successfully using generic fallback packages."
    elif [ $repair_attempted -eq 1 ]; then
      print_success "${de} installed successfully after database repair."
    else
      print_success "${de} installed successfully."
    fi
    log "DE installed: $de in $distro"
    restore_distro_tools "$distro"
    return 0
  else
    # Diagnostic reporting
    echo ""
    print_error "Installation of ${de} inside ${distro} failed."
    print_error "Diagnostic Information:"
    echo "    - Target Distro:       $distro"
    echo "    - Target Desktop:      $de"
    echo "    - Package Manager:     $pm"
    echo "    - Primary Package:     $pkg"
    echo "    - Fallback Package:    $generic_pkg"
    echo "    - Start Command Bin:   ${DE_STARTCMD[$de]}"
    echo "    - Repair Attempted:    $( [ $repair_attempted -eq 1 ] && echo 'Yes' || echo 'No' )"
    echo "    - Fallback Attempted:  $( [ $generic_fallback_attempted -eq 1 ] && echo 'Yes' || echo 'No' )"
    echo "    - Last Command Status: $status"
    echo "    - Binaries Installed:  $( de_is_installed "$distro" "$de" && echo 'Yes' || echo 'No' )"
    echo ""
    print_error "Recent installation logs from $LOG_FILE:"
    if [ -f "$LOG_FILE" ]; then
      local total_log_lines
      total_log_lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
      local delta_log_lines=$((total_log_lines - start_log_lines))
      if [ $delta_log_lines -gt 0 ]; then
        tail -n $delta_log_lines "$LOG_FILE" | tail -n 25 | sed 's/^/    /'
      else
        tail -n 25 "$LOG_FILE" | sed 's/^/    /'
      fi
    fi
    echo ""
    print_warn "Try running the update/installation commands manually inside the container to see the issue:"
    echo "    proot-distro login $distro"
    echo "    (then run package manager update and install commands)"
    echo ""
    restore_distro_tools "$distro"
    exit 1
  fi
}

SELECTED_USER=""

select_user() {
  local distro="$1" auto_yes="$2"

  if [ "$auto_yes" = "y" ]; then
    SELECTED_USER=""
    return
  fi

  print_step "Reading user accounts inside ${distro}..."
  # Get real users from container (uid >= 1000 or root)
  local raw_users
  raw_users=$(proot-distro login "$distro" -- bash -c "
    awk -F: '\$3 == 0 || \$3 >= 1000 {print \$1}' /etc/passwd 2>/dev/null | grep -v nobody
  " 2>/dev/null)

  local users=("root")
  while IFS= read -r u; do
    [ -z "$u" ] || [ "$u" = "root" ] && continue
    users+=("$u")
  done <<< "$raw_users"

  echo "" >/dev/tty
  echo -e "${BOLD}${WHITE}Select a user:${RESET}" >/dev/tty
  echo "" >/dev/tty

  local i=1
  for u in "${users[@]}"; do
    local tag=""
    [ "$i" -eq 1 ] && tag="  ${GRAY}(default)${RESET}"
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${u}${RESET}${tag}" >/dev/tty
    ((i++))
  done
  echo -e "  ${BOLD}[$i]${RESET} ${CYAN}Create a new user${RESET}" >/dev/tty
  echo "" >/dev/tty

  local choice=""
  while true; do
    read -rp "$(echo -e "${CYAN}Select [1-${i}] (enter for default): ${RESET}")" choice </dev/tty
    choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
      break
    fi
    echo -e "${RED}[error]${RESET} Invalid option." >/dev/tty
  done

  if [ "$choice" -eq "$i" ]; then
    # Create new user
    local username password
    read -rp "$(echo -e "${CYAN}New username [desktop_user]: ${RESET}")" username </dev/tty
    username="${username:-desktop_user}"
    read -rsp "$(echo -e "${CYAN}Password [desktop_pass]: ${RESET}")" password </dev/tty
    password="${password:-desktop_pass}"
    echo "" >/dev/tty

    run_with_spinner "Creating user ${username}" proot-distro login "$distro" -- bash -c "
      id '$username' &>/dev/null || useradd -m -s /bin/bash '$username'
      echo '$username:$password' | chpasswd
    "
    if [ $? -eq 0 ]; then
      print_success "User '${username}' created with password '${password}'."
      print_warn "Keep these credentials safe for desktop logins!"
    else
      print_error "Failed to create user ${username}."
      exit 1
    fi
    config_set_distro_field "$distro" "user" "$username"
    SELECTED_USER="$username"
  elif [ "$choice" -eq 1 ]; then
    # root selected
    SELECTED_USER=""
    config_set_distro_field "$distro" "user" ""
  else
    SELECTED_USER="${users[$((choice - 1))]}"
    config_set_distro_field "$distro" "user" "$SELECTED_USER"
  fi
}

