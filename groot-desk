cmd_show() {
  print_step "Opening Termux-X11 application on all displays..."
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 1 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 2 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  am start --display 3 --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
  print_success "Display refresh completed successfully."
}

# -----------------------------------------------------------------------------
# Install self as a command
# -----------------------------------------------------------------------------
self_install() {
  local self_path
  self_path=$(realpath "$0")
  local target="$PREFIX/bin/groot-desk"

  if [ "$self_path" != "$target" ]; then
    cp "$self_path" "$target"
    chmod +x "$target"
    print_success "groot-desk installed as a global command. Run it from anywhere with: groot-desk"
  fi
}

# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------
config_init
load_custom_des_from_config
self_install

COMMAND="${1:-wizard}"
shift || true

case "$COMMAND" in
  wizard|"")    run_wizard "" ;;
  install)      cmd_install "${1:-}" "${2:-}" ;;
  start)
    DISTRO="${1:-}"
    DISPLAY_ARG=""
    DE_ARG=""
    AUTO_YES=""
    NO_REPAIR_FLAG=""
    shift || true
    for arg in "$@"; do
      if [[ "$arg" =~ ^:[0-9]+$ ]]; then DISPLAY_ARG="$arg"
      elif [ "$arg" = "-y" ]; then AUTO_YES="y"
      elif [ "$arg" = "--no-repair" ]; then NO_REPAIR_FLAG="1"
      elif [ -n "${DE_PACKAGE[$arg]}" ] || [[ " ${DE_LIST[*]} " == *" $arg "* ]]; then DE_ARG="$arg"
      fi
    done
    if [ -z "$DISTRO" ]; then
      run_wizard "$AUTO_YES"
    else
      cmd_start "$DISTRO" "$DISPLAY_ARG" "$DE_ARG" "$AUTO_YES" "$NO_REPAIR_FLAG"
    fi
    ;;
  mode)
    DISTRO="${1:-}"
    VAL="${2:-}"
    if [ -z "$DISTRO" ]; then
      print_error "Specify a distribution. Example: groot-desk mode kali cpu"
      exit 1
    fi
    if [ -z "$VAL" ]; then
      local current_render current_vnc current_res
      current_render=$(config_get_distro_field "$DISTRO" "render_mode")
      current_render="${current_render:-cpu}"
      current_vnc=$(config_get_distro_field "$DISTRO" "vnc_only")
      current_vnc="${current_vnc:-1}"
      current_res=$(config_get_distro_field "$DISTRO" "resolution")
      current_res="${current_res:-1920x1080}"
      
      local vnc_desc="phone mirroring (hybrid) mode"
      if [ "$current_vnc" = "1" ]; then
        vnc_desc="standalone (VNC-only) mode"
      fi
      
      print_info "Current settings for ${DISTRO}:"
      echo -e "  Rendering preference:  ${GREEN}${current_render}${RESET} (default is cpu)"
      echo -e "  Connection mode:       ${GREEN}${vnc_desc}${RESET}"
      echo -e "  Standalone resolution: ${GREEN}${current_res}${RESET} (default is 1920x1080)"
      exit 0
    fi
    if [ "$VAL" = "cpu" ] || [ "$VAL" = "gpu" ]; then
      config_set_distro_field "$DISTRO" "render_mode" "$VAL"
      print_success "Rendering mode for ${DISTRO} set to: ${VAL}"
      log "Rendering mode for ${DISTRO} set to: ${VAL}"
    elif [ "$VAL" = "standalone" ] || [ "$VAL" = "vnc-only" ] || [ "$VAL" = "vnc_only" ]; then
      config_set_distro_field "$DISTRO" "vnc_only" "1"
      print_success "Connection mode for ${DISTRO} set to: standalone (VNC-only) mode"
      log "Connection mode for ${DISTRO} set to: standalone for distro: ${DISTRO}"
    elif [ "$VAL" = "phone" ] || [ "$VAL" = "hybrid" ]; then
      config_set_distro_field "$DISTRO" "vnc_only" "0"
      print_success "Connection mode for ${DISTRO} set to: phone mirroring (hybrid) mode"
      log "Connection mode for ${DISTRO} set to: hybrid for distro: ${DISTRO}"
    elif [[ "$VAL" =~ ^[0-9]+x[0-9]+$ ]]; then
      config_set_distro_field "$DISTRO" "resolution" "$VAL"
      print_success "Standalone resolution for ${DISTRO} set to: ${VAL}"
      log "Standalone resolution for ${DISTRO} set to: ${VAL}"
    else
      print_error "Invalid parameter: ${VAL}. Valid options are: 'cpu', 'gpu', 'standalone'/'phone', or a custom resolution like '1920x1080'."
      exit 1
    fi
    ;;
  stop)         cmd_stop "${1:-}" ;;
  show)         cmd_show ;;
  restart)      cmd_restart "${1:-}" ;;
  status)       cmd_status ;;
  list)         cmd_list ;;
  logs)         cmd_logs ;;
  kill)         cmd_kill "${1:-}" ;;
  reset)        cmd_reset "${1:-}" ;;
  remove-desk)  cmd_remove_desk "${1:-}" ;;
  miracast)     cmd_miracast "${1:-}" "${2:-}" "${3:-}" ;;
  delete)       cmd_delete "${1:-}" ;;
  uninstall)    cmd_uninstall ;;
  help|--help|-h) cmd_help ;;
  *)
    print_error "Unknown command: ${COMMAND}"
    cmd_help
    exit 1
    ;;
esac
