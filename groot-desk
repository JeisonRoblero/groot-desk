# -----------------------------------------------------------------------------
# Stop sessions
# -----------------------------------------------------------------------------
cmd_stop() {
  local target="$1"

  # Release wake lock
  if command -v termux-wake-unlock &>/dev/null; then
    termux-wake-unlock
  fi

  if [ -z "$target" ]; then
    run_with_spinner "Stopping all sessions" bash -c "
      pgrep -f 'proot' | while read -r pid; do
        if [ -n \"\$pid\" ] && ! cat \"/proc/\$pid/cmdline\" 2>/dev/null | tr '\\0' ' ' | grep -q 'groot-desk'; then
          kill -9 \"\$pid\" 2>/dev/null || true
        fi
      done
      pkill -9 -f termux-x11 2>/dev/null || true
      pkill -9 -f Xwayland 2>/dev/null || true
      pkill -9 -f Xvfb 2>/dev/null || true
      pkill -9 -f x11vnc 2>/dev/null || true
      rm -f /tmp/.X11-unix/X* \${TMPDIR}/.X11-unix/X* 2>/dev/null
      rm -f /tmp/.X*-lock \${TMPDIR}/.X*-lock 2>/dev/null
      rm -f /tmp/.tX*-lock \${TMPDIR}/.tX*-lock 2>/dev/null
    "
    log "All sessions stopped."
  else
    run_with_spinner "Stopping session for ${target}" bash -c "
      # Find all active displays for this distro before killing the processes
      (pgrep -f 'proot-distro login.*${target}' || pgrep -f 'proot.*${target}') | while read -r pid; do
        if [ -n \"\$pid\" ]; then
          local disp
          disp=\$(cat \"/proc/\$pid/cmdline\" 2>/dev/null | tr '\\0' ' ' | grep -Eo 'DISPLAY=:[0-9]+|DISPLAY= :[0-9]+' | grep -Eo ':[0-9]+')
          if [ -n \"\$disp\" ]; then
            echo \"\$disp\"
          fi
        fi
      done | sort -u | while read -r display; do
        if [ -n \"\$display\" ]; then
          pkill -9 -f \"termux-x11.*\$display\" 2>/dev/null || true
          pkill -9 -f \"Xwayland.*\$display\" 2>/dev/null || true
          pkill -9 -f \"Xvfb.*\$display\" 2>/dev/null || true
          pkill -9 -f \"x11vnc.*\$display\" 2>/dev/null || true
          local d_num=\"\${display#*:}\"
          rm -f \"/tmp/.X11-unix/X\${d_num}\" \"\${TMPDIR}/.X11-unix/X\${d_num}\" 2>/dev/null
          rm -f \"/tmp/.X\${d_num}-lock\" \"\${TMPDIR}/.X\${d_num}-lock\" 2>/dev/null
          rm -f \"/tmp/.tX\${d_num}-lock\" \"\${TMPDIR}/.tX\${d_num}-lock\" 2>/dev/null
        fi
      done
      
      pgrep -f 'proot.*${target}' | while read -r pid; do
        if [ -n \"\$pid\" ] && ! cat \"/proc/\$pid/cmdline\" 2>/dev/null | tr '\\0' ' ' | grep -q 'groot-desk'; then
          kill -9 \"\$pid\" 2>/dev/null || true
        fi
      done
    "
    log "Session stopped for distro: $target"
  fi
}

# -----------------------------------------------------------------------------
# Restart
# -----------------------------------------------------------------------------
cmd_restart() {
  local distro="$1"
  cmd_stop "$distro"
  sleep 1
  cmd_start "$distro"
}

# -----------------------------------------------------------------------------
# Status
# -----------------------------------------------------------------------------
cmd_status() {
  check_proot_distro

  echo ""
  echo -e "${BOLD}${WHITE}Active Desktop Sessions (configured):${RESET}"
  echo ""

  local found=0
  local installed
  installed=$(get_installed_distros)

  while IFS= read -r d; do
    [ -z "$d" ] && continue
    local de user
    de=$(config_get_distro_field "$d" "last_de")
    user=$(config_get_distro_field "$d" "user")

     local display_num
     for display_num in {1..10}; do
       local is_running=0
        if pgrep -f "termux-x11.*:${display_num}" &>/dev/null; then
          if pgrep -f "proot" | while read -r pid; do
            local cmdline
            cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
            if [[ "$cmdline" =~ "${d}" ]] && [[ "$cmdline" =~ "DISPLAY=:${display_num}" || "$cmdline" =~ "DISPLAY= :${display_num}" || "$cmdline" =~ "DISPLAY=envDISPLAY=:${display_num}" || "$cmdline" =~ "DISPLAY=x11DISPLAY=:${display_num}" ]]; then
              echo "yes"
              break
            fi
          done | grep -q "yes"; then
            is_running=1
          fi
          # Fallback: if display server is running and container for this distro is active, associate them
          if [ "$is_running" -eq 0 ]; then
            if pgrep -f "proot" | while read -r pid; do
              local cmdline
              cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
              if [[ "$cmdline" =~ "${d}" ]]; then
                echo "yes"
                break
              fi
            done | grep -q "yes"; then
              is_running=1
            fi
          fi
        elif pgrep -f "Xvfb.*:${display_num}" &>/dev/null; then
          if pgrep -f "proot" | while read -r pid; do
            local cmdline
            cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
            if [[ "$cmdline" =~ "${d}" ]] && [[ "$cmdline" =~ "DISPLAY=:${display_num}" || "$cmdline" =~ "DISPLAY= :${display_num}" || "$cmdline" =~ "DISPLAY=envDISPLAY=:${display_num}" || "$cmdline" =~ "DISPLAY=x11DISPLAY=:${display_num}" ]]; then
              echo "yes"
              break
            fi
          done | grep -q "yes"; then
            is_running=2
          fi
          # Fallback: if display server is running and container for this distro is active, associate them
          if [ "$is_running" -eq 0 ]; then
            if pgrep -f "proot" | while read -r pid; do
              local cmdline
              cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
              if [[ "$cmdline" =~ "${d}" ]]; then
                echo "yes"
                break
              fi
            done | grep -q "yes"; then
              is_running=2
            fi
          fi
        fi
       
       if [ "$is_running" -ne 0 ]; then
         local vnc_port=$((5899 + display_num))
         local current_ip
         current_ip=$(get_lan_ip)
         local mode_lbl="independent"
         if [ "$display_num" -eq 1 ]; then
           mode_lbl="Termux:X11 (local/mirror)"
         elif [ "$display_num" -eq 2 ]; then
           mode_lbl="Independent Wireless"
         elif [ "$display_num" -eq 3 ]; then
           mode_lbl="Independent HDMI"
         fi
        echo -e "  ${GREEN}[running]${RESET} Distro: ${WHITE}${d}${RESET} | Desktop: ${CYAN}${de}${RESET} | Display: ${YELLOW}:${display_num}${RESET} | Mode: ${BLUE}${mode_lbl}${RESET}"
        echo -e "            Wireless VNC Address: ${BOLD}${GREEN}${current_ip}:${vnc_port}${RESET}"
        found=1
      fi
    done
  done <<< "$installed"

  if [ $found -eq 0 ]; then
    echo -e "  ${GRAY}No configured desktop sessions are running.${RESET}"
  fi

  echo ""
  echo -e "${BOLD}${WHITE}Running Background Processes:${RESET}"
  echo ""

  local proc_found=0

  # Scan Termux-X11 processes
  local x11_pids
  x11_pids=$(pgrep -f "termux-x11" 2>/dev/null)
  if [ -n "$x11_pids" ]; then
    echo -e "  ${CYAN}Termux-X11 Servers:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$x11_pids"
  fi

  # Scan Xvfb processes
  local xvfb_pids
  xvfb_pids=$(pgrep -f "Xvfb" 2>/dev/null)
  if [ -n "$xvfb_pids" ]; then
    echo -e "  ${CYAN}Xvfb Virtual Servers:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$xvfb_pids"
  fi

  # Scan PulseAudio processes
  local pulse_pids
  pulse_pids=$(pgrep -f "pulseaudio" 2>/dev/null)
  if [ -n "$pulse_pids" ]; then
    echo -e "  ${CYAN}PulseAudio Daemons:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$pulse_pids"
  fi

  # Scan proot-distro login processes
  local proot_pids
  proot_pids=$(pgrep -x "proot" 2>/dev/null || pgrep -f "proot-distro login" 2>/dev/null)
  if [ -n "$proot_pids" ]; then
    echo -e "  ${CYAN}PRoot Container Sessions:${RESET}"
    while read -r pid; do
      [ -z "$pid" ] && continue
      local cmdline
      cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
      echo -e "    - PID: ${WHITE}$pid${RESET} | Cmd: ${GRAY}$cmdline${RESET}"
      proc_found=1
    done <<< "$proot_pids"
  fi

  if [ $proc_found -eq 0 ]; then
    echo -e "  ${GRAY}No background display or container processes found.${RESET}"
  fi
  echo ""
}

cmd_kill() {
  local target="$1"
  if [ -z "$target" ]; then
    print_error "Specify a PID, display ID (e.g. :1), distro name, or 'all' to kill. Example: groot-desk kill :1"
    exit 1
  fi

  if [ "$target" = "all" ]; then
    cmd_stop ""
    return
  fi

  if [[ "$target" =~ ^[0-9]+$ ]]; then
    if kill -0 "$target" 2>/dev/null; then
      run_with_spinner "Killing process $target" kill -9 "$target"
      print_success "Process $target terminated."
    else
      print_error "Process $target not found or access denied."
      exit 1
    fi
    return
  fi

  if [[ "$target" =~ ^:[0-9]+$ ]]; then
    local xpid
    xpid=$(pgrep -f "termux-x11.*${target}" 2>/dev/null)
    if [ -n "$xpid" ]; then
      run_with_spinner "Killing display server ${target} (PID ${xpid})" kill -9 $xpid
    fi
    rm -f "/tmp/.X11-unix/X${target#*:}" "${TMPDIR}/.X11-unix/X${target#*:}" 2>/dev/null

    local found_distro=""
    local installed
    installed=$(get_installed_distros)
    while IFS= read -r d; do
      [ -z "$d" ] && continue
      local d_disp
      d_disp=$(config_get_distro_field "$d" "display")
      if [ "$d_disp" = "$target" ]; then
        found_distro="$d"
        break
      fi
    done <<< "$installed"

    if [ -n "$found_distro" ]; then
      cmd_stop "$found_distro"
    else
      pgrep -f "proot" | while read -r pid; do
        if [ -n "$pid" ] && cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' | grep -q -E "DISPLAY=${target}|DISPLAY= ${target}"; then
          kill -9 "$pid" 2>/dev/null || true
        fi
      done
      print_success "Sessions on display ${target} killed."
    fi
    return
  fi

  local installed
  installed=$(get_installed_distros)
  if echo "$installed" | grep -qx "$target"; then
    cmd_stop "$target"
  else
    print_error "Identifier '${target}' is not a valid PID, display ID, distro name, or 'all'."
    exit 1
  fi
}

