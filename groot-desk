declare -A DE_PACKAGE DE_STARTCMD DE_SIZE DE_DESC DE_TAG DE_GENERIC_PACKAGE
DE_LIST=(xfce4 lxqt mate kde gnome budgie cinnamon openbox)

get_distro_pkg_manager() {
  local distro="$1"
  local clean_path="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  if proot-distro login "$distro" -- sh -c "$clean_path command -v apt-get" &>/dev/null; then
    echo "apt"
  elif proot-distro login "$distro" -- sh -c "$clean_path command -v apk" &>/dev/null; then
    echo "apk"
  elif proot-distro login "$distro" -- sh -c "$clean_path command -v pacman" &>/dev/null; then
    echo "pacman"
  elif proot-distro login "$distro" -- sh -c "$clean_path command -v dnf" &>/dev/null; then
    echo "dnf"
  elif proot-distro login "$distro" -- sh -c "$clean_path command -v xbps-install" &>/dev/null; then
    echo "xbps"
  elif proot-distro login "$distro" -- sh -c "$clean_path command -v emerge" &>/dev/null; then
    echo "emerge"
  else
    case "$distro" in
      ubuntu*|debian*|kali*|deepin*|openkylin*|pardus*|trisquel*) echo "apt" ;;
      alpine*|adelie*|chimera*) echo "apk" ;;
      archlinux*|manjaro*|artix*) echo "pacman" ;;
      fedora*|almalinux*|rocky*|oracle*) echo "dnf" ;;
      void*) echo "xbps" ;;
      gentoo*) echo "emerge" ;;
      *) echo "apt" ;;
    esac
  fi
}

update_guest_repos() {
  local distro="$1" pm="$2"
  case "$pm" in
    apt)
      proot-distro login "$distro" -- sh -c "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; apt-get update -y" &>/dev/null || true
      ;;
    apk)
      proot-distro login "$distro" -- sh -c "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; apk update" &>/dev/null || true
      ;;
    pacman)
      proot-distro login "$distro" -- sh -c "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; pacman -Sy --noconfirm" &>/dev/null || true
      ;;
    dnf)
      proot-distro login "$distro" -- sh -c "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; dnf makecache" &>/dev/null || true
      ;;
    xbps)
      proot-distro login "$distro" -- sh -c "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; xbps-install -Sy" &>/dev/null || true
