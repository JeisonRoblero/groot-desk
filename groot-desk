#!/data/data/com.termux/files/usr/bin/bash

# =============================================================================
# groot-desk - Linux desktop manager for Termux
# =============================================================================

VERSION="1.0.1"
CONFIG_DIR="$HOME/.config/groot-desk"
CONFIG_FILE="$CONFIG_DIR/config.json"
LOG_FILE="$CONFIG_DIR/groot-desk.log"

# Define default Termux prefix if not set
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

is_proot_distro_v5() {
  # 1. Feature check: quiet mode -q is unique to modern v5.0+ list subcommand
  if proot-distro list -q &>/dev/null; then
    return 0
  fi
  # 2. Command check: OCI/image help terms in install subcommand help output
  if proot-distro install --help 2>&1 | grep -q -i -E "(image|registry|docker|oci)"; then
    return 0
  fi
  # 3. Shebang check: absolute path interpreter inspection
  local pd_path
  pd_path=$(command -v proot-distro 2>/dev/null)
  if [ -n "$pd_path" ] && [ -f "$pd_path" ]; then
    if head -n 1 "$pd_path" 2>/dev/null | grep -q -i "python"; then
      return 0
    fi
  fi
  return 1
}


# -----------------------------------------------------------------------------
# Colors
# -----------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# -----------------------------------------------------------------------------
# Print helpers
# -----------------------------------------------------------------------------
print_separator() {
  local char="${1:-═}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  [ "$cols" -gt 60 ] && cols=60
  local line=""
  local i
  for ((i=0; i<cols; i++)); do
    line+="$char"
  done
  echo "$line"
}

print_wrapped() {
  local indent="$1"
  local color="$2"
  local text="$3"
  local reset="${4:-$RESET}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 80)
  [ "$cols" -gt 60 ] && cols=60
  local plain_indent
  plain_indent=$(echo -e "$indent" | sed 's/\x1b\[[0-9;]*m//g')
  local max_w=$((cols - ${#plain_indent}))
  [ $max_w -lt 20 ] && max_w=20
  if command -v fold &>/dev/null; then
    echo "$text" | fold -s -w "$max_w" | while read -r line; do
      echo -e "${indent}${color}${line}${reset}"
    done
  else
    local words=($text)
    local line=""
    for word in "${words[@]}"; do
      if [ $((${#line} + ${#word} + 1)) -gt $max_w ]; then
        echo -e "${indent}${color}${line}${reset}"
        line="$word"
      else
        if [ -z "$line" ]; then
          line="$word"
        else
          line="$line $word"
        fi
      fi
    done
    [ -n "$line" ] && echo -e "${indent}${color}${line}${reset}"
  fi
}

print_box_top() {
  local color="$1"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="═"
  done
  echo -e "${color}╔${line}╗${RESET}"
}

print_box_bottom() {
  local color="$1"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="═"
  done
  echo -e "${color}╚${line}╝${RESET}"
}

print_box_sep() {
  local char="${1:-─}"
  local color="${2}"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local line=""
  local i
  for ((i=0; i<box_w-2; i++)); do
    line+="$char"
  done
  echo -e "${color}╠${line}╣${RESET}"
}

print_box_line() {
  local align="$1"
  local border_color="$2"
  local text_color="$3"
  local text="$4"
  local cols
  cols=$(tput cols 2>/dev/null || echo 50)
  local box_w=$cols
  [ "$box_w" -gt 60 ] && box_w=60
  [ "$box_w" -lt 40 ] && box_w=40
  local content_w=$((box_w - 2))
  local plain_text
  plain_text=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
  if [ ${#plain_text} -le $content_w ]; then
    local pad=$((content_w - ${#plain_text}))
    local pad_l=0
    local pad_r=0
    if [ "$align" = "center" ]; then
      pad_l=$((pad / 2))
      pad_r=$((pad - pad_l))
    else
      pad_l=2
      pad_r=$((pad - pad_l))
    fi
    local spaces_l=""
    local spaces_r=""
    local i
    for ((i=0; i<pad_l; i++)); do spaces_l+=" "; done
    for ((i=0; i<pad_r; i++)); do spaces_r+=" "; done
    echo -e "${border_color}║${RESET}${spaces_l}${text_color}${text}${RESET}${spaces_r}${border_color}║${RESET}"
  else
    local max_w=$((content_w - 4))
    echo "$text" | fold -s -w "$max_w" | while read -r line; do
      [ -z "$line" ] && continue
      local plain_line
      plain_line=$(echo -e "$line" | sed 's/\x1b\[[0-9;]*m//g')
      local pad=$((content_w - ${#plain_line}))
      local pad_l=0
      local pad_r=0
      if [ "$align" = "center" ]; then
        pad_l=$((pad / 2))
        pad_r=$((pad - pad_l))
      else
        pad_l=2
        pad_r=$((pad - pad_l))
      fi
      local spaces_l=""
      local spaces_r=""
      local i
      for ((i=0; i<pad_l; i++)); do spaces_l+=" "; done
      for ((i=0; i<pad_r; i++)); do spaces_r+=" "; done
      echo -e "${border_color}║${RESET}${spaces_l}${text_color}${line}${RESET}${spaces_r}${border_color}║${RESET}"
    done
  fi
}

print_header() {
  echo ""
  print_box_top "${BOLD}${CYAN}"
  print_box_line "center" "${BOLD}${CYAN}" "${BOLD}${CYAN}" "groot-desk v${VERSION}"
  print_box_line "center" "${BOLD}${CYAN}" "${GRAY}" "Linux Desktop Session Manager"
  print_box_sep "═" "${BOLD}${CYAN}"
  print_box_line "center" "${BOLD}${CYAN}" "${GRAY}" "To see all commands run: groot-desk help"
  print_box_bottom "${BOLD}${CYAN}"
  echo ""
}

print_success() { echo -e "${GREEN}[ok]${RESET} $1"; log "SUCCESS: $1"; }
print_error()   { echo -e "${RED}[error]${RESET} $1"; log "ERROR: $1"; }
print_warn()    { echo -e "${YELLOW}[warn]${RESET} $1"; log "WARN: $1"; }
print_info()    { echo -e "${BLUE}[info]${RESET} $1"; log "INFO: $1"; }
print_step()    { echo -e "${WHITE}[....] $1${RESET}"; }
print_gray()    { echo -e "${GRAY}$1${RESET}"; }

cleanup() {
  # Re-enable line wrapping in case it was disabled
  printf "\033[?7h" 2>/dev/null
  echo ""
  print_warn "Interrupted."
  # Kill X11
  kill -9 $(pgrep -f "termux.x11") 2>/dev/null
  # Kill PulseAudio
  pkill -f "pulseaudio" 2>/dev/null
  # Restore stubbed icon cache scripts if backup exists
  if [ -n "${ACTIVE_DISTRO}" ]; then
    proot-distro login "${ACTIVE_DISTRO}" -- bash -c '
      rm -f /tmp/groot-run-with-dbus.sh
      [ -f /usr/sbin/update-icon-caches.bak ] && mv /usr/sbin/update-icon-caches.bak /usr/sbin/update-icon-caches
      [ -f /usr/bin/gtk-update-icon-cache.bak ] && mv /usr/bin/gtk-update-icon-cache.bak /usr/bin/gtk-update-icon-cache
      if [ -f /usr/sbin/policy-rc.d.created_by_groot ]; then
        rm -f /usr/sbin/policy-rc.d /usr/sbin/policy-rc.d.created_by_groot
      fi
      for cmd in updatedb updatedb.plocate systemctl invoke-rc.d update-rc.d service deb-systemd-invoke deb-systemd-helper initctl; do
        for dir in /usr/bin /usr/sbin /bin /sbin; do
          [ -f "$dir/$cmd.bak" ] && mv "$dir/$cmd.bak" "$dir/$cmd"
        done
      done
    ' &>/dev/null || true
  fi
  # Kill any running proot sessions spawned by the script to release lock files
  pkill -f "proot-distro" 2>/dev/null
  exit 1
}
trap cleanup INT TERM

# Spinner for long-running processes
run_with_spinner() {
  local message="$1"
  shift

  local tmp_log
  tmp_log=$(mktemp)

  # Run the command in the background, redirecting output to the temporary log file
  "$@" >> "$tmp_log" 2>&1 &
  local pid=$!

  local delay=0.08
  local spinner
  local has_utf8=0
  if [[ "${LANG}" =~ UTF-8 || "${LANG}" =~ utf8 || "${LC_ALL}" =~ UTF-8 || "${LC_CTYPE}" =~ UTF-8 ]]; then
    has_utf8=1
  elif command -v locale &>/dev/null && [[ "$(locale charmap 2>/dev/null)" == "UTF-8" ]]; then
    has_utf8=1
  fi

  if [ $has_utf8 -eq 1 ]; then
    spinner=( "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" )
  else
    spinner=( "/" "-" "\\" "|" )
  fi
  local i=0
  
  # Hide cursor
  tput civis 2>/dev/null || printf "\033[?25l"

  local display_msg="$message"
  local last_lines=0

  while kill -0 "$pid" 2>/dev/null; do
    if [ -f "$tmp_log" ]; then
      local total_lines
      total_lines=$(wc -l < "$tmp_log" 2>/dev/null || echo 0)
      local delta=$((total_lines - last_lines))
      
      if [ $delta -gt 0 ]; then
        local chunk
        chunk=$(tail -n $delta "$tmp_log" 2>/dev/null)
        last_lines=$total_lines
        
        local last_match
        last_match=$(echo "$chunk" | grep -E -i "Get:[0-9]+|Setting up|Configuring|Installing|Unpacking|Removing|Purging|Unmerging|\[[-# ]+\][[:space:]]+[0-9]+%|^[[:space:]]*\[\*\][[:space:]]+" | tail -n 1)
        if [ -n "$last_match" ]; then
          if [[ "$last_match" =~ (Removing|Purging|Unmerging|removing|purging|unmerging) ]]; then
            local clean_line
            clean_line=$(echo "$last_match" | sed -E 's/^[[:space:]>]*\([0-9]+\/[0-9]+\)[[:space:]]*//; s/^>>>[[:space:]]*//; s/^[[:space:]]*//')
            if [[ "$clean_line" =~ ^(Removing|removing|Purging|purging|Unmerging|unmerging):?[[:space:]]+(configuration[[:space:]]+files[[:space:]]+for[[:space:]]+)?([^[:space:]]+) ]]; then
              local rm_pkg="${BASH_REMATCH[3]}"
              rm_pkg=$(echo "$rm_pkg" | tr -d '():,')
              if [ -n "$rm_pkg" ]; then
                [ ${#rm_pkg} -gt 15 ] && rm_pkg="${rm_pkg:0:12}..."
                display_msg="Remv: $rm_pkg"
              fi
            fi
          elif [[ "$last_match" =~ (Setting[[:space:]]+up|Configuring|Installing|Unpacking) ]]; then
            local action="${BASH_REMATCH[1]}"
            local current_pkg=""
            if [ "$action" = "Setting up" ]; then
              current_pkg=$(echo "$last_match" | awk '{print $3}')
            else
              current_pkg=$(echo "$last_match" | awk '{print $2}')
            fi
            current_pkg=$(echo "$current_pkg" | tr -d '():,')
            if [ -n "$current_pkg" ]; then
              [ ${#current_pkg} -gt 15 ] && current_pkg="${current_pkg:0:12}..."
              case "$action" in
                "Setting up"|"Configuring") display_msg="Conf: $current_pkg" ;;
                "Unpacking")                 display_msg="Unpk: $current_pkg" ;;
                "Installing")                display_msg="Inst: $current_pkg" ;;
              esac
            fi
          elif [[ "$last_match" =~ Get:[0-9]+ ]]; then
            local get_id
            get_id=$(echo "$last_match" | awk '{print $1}')
            local field5
            field5=$(echo "$last_match" | awk '{print $5}')
            if [ -n "$field5" ] && [[ ! "$field5" =~ ^\[ && ! "$field5" =~ ^[0-9] ]]; then
              [ ${#field5} -gt 15 ] && field5="${field5:0:12}..."
              display_msg="Down: $field5"
            else
              local get_url
              get_url=$(echo "$last_match" | awk '{print $2}' | cut -d/ -f3 | cut -d. -f1-2)
              display_msg="Upd: $get_id $get_url"
            fi
          elif [[ "$last_match" =~ \[([-# ]+)\][[:space:]]+([0-9]+%) ]]; then
            local pct="${BASH_REMATCH[2]}"
            local sz=""
            if [[ "$last_match" =~ ([0-9.]+[[:space:]]+(MiB|KiB|GiB|B)) ]]; then
              sz=" (${BASH_REMATCH[1]})"
            fi
            display_msg="Downloading: ${pct}${sz}"
          elif [[ "$last_match" =~ ^[[:space:]]*\[\*\][[:space:]]+(.*) ]]; then
            local info_msg="${BASH_REMATCH[1]}"
            if [[ ! "$info_msg" =~ ^\[ ]]; then
              [ ${#info_msg} -gt 25 ] && info_msg="${info_msg:0:22}..."
              display_msg="$info_msg"
            fi
          fi
        fi
      fi
    fi

    local cols
    cols=$(tput cols 2>/dev/null || echo 80)
    local max_len=$((cols - 6))
    [ "$max_len" -lt 20 ] && max_len=20

    # Truncate final message to prevent wrapping on narrow mobile screens
    if [ ${#display_msg} -gt $max_len ]; then
      display_msg="${display_msg:0:$((max_len - 3))}..."
    fi

    local display_line
    display_line=$(printf "%s %s..." "${spinner[i]}" "$display_msg")
    printf "\r%-*s" $((cols - 1)) "$display_line"
    
    i=$(( (i + 1) % ${#spinner[@]} ))
    sleep $delay
  done

  # Show cursor
  tput cnorm 2>/dev/null || printf "\033[?25h"
  
  # Completely wipe the progress line with spaces to avoid terminal bleed
  local cols
  cols=$(tput cols 2>/dev/null || echo 80)
  printf "\r%-*s\r" $((cols - 1)) ""

  wait "$pid"
  local status=$?

  # Append temporary session logs to the global log file and clean up
  if [ -f "$tmp_log" ]; then
    cat "$tmp_log" >> "$LOG_FILE"
    rm -f "$tmp_log"
  fi

  if [ $status -eq 0 ]; then
    print_success "$message done."
  else
    print_error "$message failed. Recent logs:"
    if [ -f "$LOG_FILE" ]; then
      tail -n 10 "$LOG_FILE" | sed 's/^/    /'
    fi
  fi
  return $status
}

# -----------------------------------------------------------------------------
# Config helpers (JSON via jq)
# -----------------------------------------------------------------------------
config_init() {
  mkdir -p "$CONFIG_DIR"
  touch "$LOG_FILE"

  # Validate and initialize/reset config file if missing, empty, or corrupted JSON
  if [ ! -f "$CONFIG_FILE" ] || [ ! -s "$CONFIG_FILE" ] || ! command -v jq &>/dev/null || ! jq . "$CONFIG_FILE" &>/dev/null; then
    echo '{"distros":{}}' > "$CONFIG_FILE"
  fi

  # Ensure jq is installed
  if ! command -v jq &>/dev/null; then
    print_warn "jq is required for configuration management but is not installed."
    print_step "Installing jq..."
    if pkg install jq -y >> "$LOG_FILE" 2>&1; then
      print_success "jq installed successfully."
    else
      print_error "Failed to install jq. Check internet connection or run: pkg install jq"
      exit 1
    fi
  fi
}

config_get_distro_field() {
  local distro="$1" field="$2"
  if [ ! -f "$CONFIG_FILE" ]; then
    echo ""
    return
  fi
  jq -r ".distros[\"${distro}\"][\"${field}\"] // \"\"" "$CONFIG_FILE" 2>/dev/null
}

config_set_distro_field() {
  local distro="$1" field="$2" value="$3"
  [ -z "$distro" ] && return
  local tmpfile
  tmpfile=$(mktemp)
  if jq ".distros[\"${distro}\"][\"${field}\"] = \"${value}\"" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
    mv "$tmpfile" "$CONFIG_FILE"
  else
    rm -f "$tmpfile"
    log "ERROR: Failed to write to config file using jq."
  fi
}

next_display_number_from() {
  local start_d="${1:-1}"
  local d="$start_d"
  while true; do
    if ! pgrep -f "termux-x11.*:$d" &>/dev/null && ! pgrep -f "Xvfb.*:$d" &>/dev/null; then
      # Clean up any stale sockets since no process is running on this port
      rm -f "/tmp/.X11-unix/X$d" "${TMPDIR}/.X11-unix/X$d" 2>/dev/null
      echo ":$d"
      return
    fi
    ((d++))
  done
}

next_display_number() {
  next_display_number_from 1
}

start_termux_x11_server() {
  local display="$1" distro="$2"
  export XDG_RUNTIME_DIR=${TMPDIR}
  
  # Clean up any stale display lock and socket files
  local d_num="${display#*:}"
  chmod -R 777 "/tmp/.X11-unix" "${TMPDIR}/.X11-unix" 2>/dev/null || true
  rm -f "/tmp/.X11-unix/X${d_num}" "${TMPDIR}/.X11-unix/X${d_num}" 2>/dev/null
  rm -f "/tmp/.X${d_num}-lock" "${TMPDIR}/.X${d_num}-lock" 2>/dev/null
  rm -f "/tmp/.tX${d_num}-lock" "${TMPDIR}/.tX${d_num}-lock" 2>/dev/null
  
  local v_only
  v_only=$(config_get_distro_field "${distro:-global}" "vnc_only")
  v_only="${v_only:-1}"
  
  # Force virtual Xvfb mode for any display other than :1.
  # For Display :1, always run standard Termux:X11 if the binary is present.
  if [ "$d_num" -ne 1 ] || ! command -v termux-x11 &>/dev/null; then
    # Run in virtual frame buffer (Xvfb) mode - zero phone APK dependencies
    if ! command -v Xvfb &>/dev/null; then
      run_with_spinner "Installing Xvfb virtual frame buffer" bash -c "pkg install x11-repo -y && apt-get update -y && pkg install xorg-server-xvfb -y"
    fi
    local custom_res
    custom_res=$(config_get_distro_field "${distro:-global}" "resolution")
    if [ -z "$custom_res" ] || [ "$d_num" -eq 3 ]; then
      custom_res=$(detect_display_resolution "$display")
    fi
    Xvfb "$display" -screen 0 "${custom_res}x24" >> "$LOG_FILE" 2>&1 &
    disown $! 2>/dev/null || true
    sleep 1.5
  else
    # Run in standard Termux-X11 mode
    termux-x11 "$display" >> "$LOG_FILE" 2>&1 &
    disown $! 2>/dev/null || true
    am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity &>/dev/null || true
    sleep 2.0
  fi
}

disable_phantom_killer() {
  local sdk_ver
  sdk_ver=$(getprop ro.build.version.sdk 2>/dev/null || echo 0)
  if [ -n "$sdk_ver" ] && [ "$sdk_ver" -ge 31 ]; then
    # Try ROOT (su)
    if command -v su &>/dev/null; then
      if su -c "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    # Try Shizuku (rish)
    if command -v rish &>/dev/null; then
      if rish -c "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    # Try Local Network ADB
    if command -v adb &>/dev/null; then
      if adb shell "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" &>/dev/null; then
        return 0
      fi
    fi
    return 1
  fi
  return 0
}

detect_display_resolution() {
  local target_display="$1"

  # Dynamically adapt to external monitor/widescreen resolutions if detected
  if command -v dumpsys &>/dev/null; then
    local displays
    displays=$(dumpsys display 2>/dev/null)
    if [ -n "$displays" ]; then
      local ext_w="" ext_h=""
      
      # Try format: " 1920 x 1080," or " 1920x1080 "
      local match
      match=$(echo "$displays" | grep -Eo '[0-9]+\s*x\s*[0-9]+' | tr -d ' ' | sort -u)
      while read -r r; do
        [ -z "$r" ] && continue
        local w="${r%x*}"
        local h="${r#*x}"
        if [ "$w" -gt "$h" ] && [ "$w" -ge 1280 ]; then
          ext_w="$w"
          ext_h="$h"
        fi
      done <<< "$match"
      
      # Try format: "width=1920, height=1080"
      if [ -z "$ext_w" ]; then
        match=$(echo "$displays" | grep -Eo 'width=[0-9]+,\s*height=[0-9]+' | tr -d ' ' | sort -u)
        while read -r r; do
          [ -z "$r" ] && continue
          local w
          w=$(echo "$r" | grep -Eo 'width=[0-9]+' | cut -d= -f2)
          local h
          h=$(echo "$r" | grep -Eo 'height=[0-9]+' | cut -d= -f2)
          if [ "$w" -gt "$h" ] && [ "$w" -ge 1280 ]; then
            ext_w="$w"
            ext_h="$h"
          fi
        done <<< "$match"
      fi
      
      if [ -n "$ext_w" ]; then
        echo "${ext_w}x${ext_h}"
        return 0
      fi
    fi
  fi

  # Default fallback resolution if no displays are connected or detected
  echo "1920x1080"
}

get_lan_ip() {
  local ip_addr=""
  
  # 1. Specifically search Wi-Fi and Hotspot interfaces first (wlan0, wlan1, ap0) using both tools
  for iface in wlan0 wlan1 ap0; do
    if command -v ifconfig &>/dev/null; then
      ip_addr=$(ifconfig "$iface" 2>/dev/null | grep -Eo 'inet (addr:)?([0-9]*\.){3}[0-9]*' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '127.0.0.1' | head -n 1)
      if [ -n "$ip_addr" ]; then
        echo "$ip_addr"
        return 0
      fi
    fi
    ip_addr=$(ip addr show "$iface" 2>/dev/null | grep -E "inet " | awk '{print $2}' | cut -d/ -f1 | head -n 1)
    if [ -n "$ip_addr" ] && [ "$ip_addr" != "127.0.0.1" ]; then
      echo "$ip_addr"
      return 0
    fi
  done

  # 2. Specifically look for standard local Wi-Fi ranges (192.168.x.x) across any non-cellular interface
  if command -v ifconfig &>/dev/null; then
    ip_addr=$(ifconfig 2>/dev/null | grep -v -E "rmnet|ccmni|wwan|lte" | grep -Eo 'inet (addr:)?192\.168\.[0-9]*\.[0-9]*' | grep -Eo '[0-9.]+' | head -n 1)
    if [ -n "$ip_addr" ]; then
      echo "$ip_addr"
      return 0
    fi
  fi
  ip_addr=$(ip addr show 2>/dev/null | grep -v -E "rmnet|ccmni|wwan|lte" | grep -E "inet 192\.168\." | awk '{print $2}' | cut -d/ -f1 | head -n 1)
  if [ -n "$ip_addr" ]; then
    echo "$ip_addr"
    return 0
  fi

  # 3. Check route to a public IP but ensure it is not a cellular route if possible
  ip_addr=$(ip route get 1.1.1.1 2>/dev/null | grep -v -E "rmnet|ccmni|wwan|lte" | grep -o -E "src [0-9.]+" | cut -d' ' -f2)
  if [ -n "$ip_addr" ] && [ "$ip_addr" != "127.0.0.1" ]; then
    echo "$ip_addr"
    return 0
  fi

  # 4. Fallback to general ip addr show excluding cellular interfaces
  ip_addr=$(ip addr show 2>/dev/null | grep -v -E "rmnet|ccmni|wwan|lte" | grep -E "inet " | grep -v "127.0.0.1" | head -n 1 | awk '{print $2}' | cut -d/ -f1)
  if [ -n "$ip_addr" ]; then
    echo "$ip_addr"
    return 0
  fi
  
  echo "127.0.0.1"
}

