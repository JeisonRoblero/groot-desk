probe_gpu() {
  local gpu_model=""
  if [ -f "/sys/class/kgsl/kgsl-3d0/gpu_model" ]; then
    gpu_model=$(cat /sys/class/kgsl/kgsl-3d0/gpu_model 2>/dev/null)
  fi
  if [ -z "$gpu_model" ] && command -v getprop &>/dev/null; then
    gpu_model=$(getprop ro.hardware 2>/dev/null)
  fi
  if [ -z "$gpu_model" ]; then
    gpu_model="Generic/Unknown GPU"
  fi
  echo "$gpu_model"
}

ensure_host_virglrenderer() {
