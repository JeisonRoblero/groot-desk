    echo -e "  ${BOLD}[${i}]${RESET} ${WHITE}${d}${RESET}"
    [ -n "$last_de" ]  && echo -e "      ${GRAY}Last desktop: ${last_de}${RESET}"
    [ -n "$display" ]  && echo -e "      ${GRAY}Last display: ${display}${RESET}"
    [ -n "$user" ]     && echo -e "      ${GRAY}User: ${user}${RESET}"
    echo ""
    ((i++))
  done <<< "$installed"
}

# -----------------------------------------------------------------------------
# Install a distribution via command line
# -----------------------------------------------------------------------------
cmd_install() {
  local distro="$1"
  local oci_image="${2:-}"  # optional: custom OCI image e.g. "ubuntu:24.04" or "kalilinux/kali-rolling"

  # Check if standard Arch Linux is requested on ARM64 under PRoot Distro version 5
  if [ "$distro" = "archlinux" ] && [ -z "$oci_image" ]; then
    if is_proot_distro_v5; then
      local system_arch
      system_arch=$(uname -m)
      if [[ "$system_arch" == "aarch64" || "$system_arch" == "arm64" ]]; then
        oci_image="menci/archlinuxarm"
        log "Overriding standard archlinux with arm64 compatible OCI image: $oci_image"
      fi
    fi
  fi

  if [ -z "$distro" ]; then
    print_error "Specify a distribution to install. Example: groot-desk install kali"
    print_info  "For custom distros: groot-desk install myname ubuntu:24.04"
    exit 1
  fi

  # If a custom OCI image is passed, v5 is required
  if [ -n "$oci_image" ]; then
    REQUIRE_PROOT_V5=1
  fi
  check_proot_distro

  # Check if already installed
  local installed
  installed=$(get_installed_distros)
  if echo "$installed" | grep -qx "$distro"; then
    print_warn "${distro} is already installed."
    return 0
  fi

  local available
  available=$(get_available_distros)
  local is_known=0
  echo "$available" | grep -qx "$distro" && is_known=1

  # If not a known distro and no OCI image supplied, prompt for OCI image
  if [ $is_known -eq 0 ] && [ -z "$oci_image" ]; then
    if ! is_proot_distro_v5; then
      print_error "Distribution '${distro}' is not in the supported list and proot-distro v5 is required for custom installs."
      print_info "Supported distros:"
      echo "$available" | sed 's/^/  /'
      return 1
    fi
    echo ""
    print_warn "Distribution '${distro}' is not in the known list."
    print_info "Any Docker Hub image can be installed using its image:tag format. Examples:"
    echo -e "  ${GRAY}ubuntu:24.04       debian:12          alpine:3.23${RESET}"
    echo -e "  ${GRAY}fedora:44          kalilinux/kali-rolling    manjarolinux/base${RESET}"
    print_info "Find images at: https://hub.docker.com"
    echo ""
    read -rp "$(echo -e "${CYAN}Enter OCI image for '${distro}' (or leave blank to cancel): ${RESET}")" oci_image
    oci_image=$(echo "$oci_image" | tr -d ' ')
    if [ -z "$oci_image" ]; then
      print_info "Cancelled."
      return 1
    fi
    # Store the OCI image in config so remove-desk and other commands know it is custom
    config_set_distro_field "$distro" "oci_image" "$oci_image"
    config_set_distro_field "$distro" "custom_distro" "1"
  fi

  if [ -z "$oci_image" ] && [ $is_known -eq 1 ]; then
    # Standard installation of a known distribution using its built-in recipe
    print_step "Installing ${distro} (this may take a few minutes)..."
    log "Installing distro: $distro using built-in recipe"
    # Disable line wrapping to prevent progress bar wrapping
    printf "\033[?7l"
    proot-distro install "$distro"
    local install_status=$?
    # Re-enable line wrapping
    printf "\033[?7h"
    if [ $install_status -eq 0 ]; then
      print_success "${distro} installed successfully."
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      return 1
    fi
  else
    # Custom OCI image installation (requires proot-distro v5)
    if ! is_proot_distro_v5; then
      print_error "Custom distro installs require proot-distro v5. Run: pkg upgrade proot-distro"
      return 1
    fi
    if [ -z "$oci_image" ]; then
      # Resolve known distros to their OCI images if no override provided (for custom name installs)
      case "$distro" in
        kali)      oci_image="kalilinux/kali-rolling" ;;
        void)      oci_image="voidlinux/voidlinux" ;;
        artix)     oci_image="artixlinux/artixlinux" ;;
        gentoo)    oci_image="gentoo/stage3" ;;
        rocky)     oci_image="rockylinux/rockylinux" ;;
        manjaro)   oci_image="manjaronetwork/manjaro" ;;
        oracle)    oci_image="oraclelinux" ;;
        *)         oci_image="$distro" ;;
      esac
    fi
    print_step "Installing ${distro} from OCI image '${oci_image}' (this may take a few minutes)..."
    log "Installing distro: $distro using image: $oci_image"
    # Disable line wrapping to prevent progress bar wrapping
    printf "\033[?7l"
    proot-distro install --name "$distro" "$oci_image"
    local install_status=$?
    # Re-enable line wrapping
    printf "\033[?7h"
    if [ $install_status -eq 0 ]; then
      print_success "${distro} installed successfully."
      [ -n "$oci_image" ] && config_set_distro_field "$distro" "oci_image" "$oci_image"
    else
      print_error "Failed to install ${distro}. Check $LOG_FILE for details."
      return 1
    fi
  fi
}

# -----------------------------------------------------------------------------
# Uninstall groot-desk itself (not the distros)
# -----------------------------------------------------------------------------
cmd_uninstall() {
  echo ""
  print_warn "This will remove groot-desk and its configurations. Installed distros will NOT be deleted."
  read -rp "$(echo -e "${YELLOW}Continue? [y/N]: ${RESET}")" confirm
  confirm="${confirm:-N}"
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Cancelled."
    return
  fi

  rm -rf "$CONFIG_DIR"
  rm -f "$PREFIX/bin/groot-desk"
  print_success "groot-desk removed. Installed distros remain intact."
  log "groot-desk uninstalled."
}

# -----------------------------------------------------------------------------
# Uninstall desktop environments from inside the distro
# -----------------------------------------------------------------------------
cmd_remove_desk() {
  local distro="$1"
  ACTIVE_DISTRO="$distro"
  local de
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to remove the desktop from. Example: groot-desk remove-de kali"
    exit 1
  fi

  # Check if installed
  local installed
  installed=$(get_installed_distros)
  if ! echo "$installed" | grep -qx "$distro"; then
    print_error "Distro '${distro}' is not installed."
    exit 1
  fi

  init_de_metadata_for_distro "$distro"
  local last_de
  last_de=$(config_get_distro_field "$distro" "last_de")

  # Always list desktop environments and let user select which one to remove
  echo -e "${WHITE}Choose which desktop environment to remove from ${distro}:${RESET}"
  echo ""
  local i=1
  local default_choice=""
  for de in "${DE_LIST[@]}"; do
    local status_str=""
    if de_is_installed "$distro" "$de"; then
      status_str=" ${GREEN}(installed)${RESET}"
    fi
    local default_marker=""
    if [ "$de" = "$last_de" ]; then
      default_marker=" ${GRAY}[last used]${RESET}"
      default_choice="$de"
    fi
    echo -e "  ${BOLD}[$i]${RESET} ${WHITE}${de}${RESET}${status_str}${default_marker}"
    ((i++))
  done
  echo ""

  local choice=""
  local prompt_lbl="Select [1-${#DE_LIST[@]}]: "
  if [ -n "$default_choice" ]; then
    prompt_lbl="Select [1-${#DE_LIST[@]}] (enter for ${default_choice}): "
  fi

  read -rp "$(echo -e "${CYAN}${prompt_lbl}${RESET}")" choice
  choice=$(echo "$choice" | tr -d '\r' | tr -d ' ')
  if [ -z "$choice" ] && [ -n "$default_choice" ]; then
    last_de="$default_choice"
  elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#DE_LIST[@]}" ]; then
    last_de="${DE_LIST[$((choice - 1))]}"
  else
    print_error "Invalid selection."
    exit 1
  fi

  local was_installed=0
  if de_is_installed "$distro" "$last_de"; then
    was_installed=1
  fi

  if [ $was_installed -eq 0 ]; then
    print_warn "Desktop environment '${last_de}' does not appear to be fully installed inside ${distro}."
    read -rp "$(echo -e "${YELLOW}Attempt to purge any package remnants for ${last_de}? [y/N]: ${RESET}")" confirm
    confirm="${confirm:-N}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      print_info "Cancelled."
      return
    fi
  else
    print_warn "This will attempt to uninstall ${last_de} and its dependencies from ${distro}."
    read -rp "$(echo -e "${YELLOW}Continue? [y/N]: ${RESET}")" confirm
    confirm="${confirm:-N}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      print_info "Cancelled."
      return
    fi
  fi

  cmd_stop "$distro"

  local pm
  pm=$(get_distro_pkg_manager "$distro")
  local remove_cmd=""

  local purge_pkgs
  purge_pkgs=$(get_de_purge_packages "$distro" "$pm" "$last_de")

  case "$pm" in
    apt)
      remove_cmd="to_purge=''
      for pattern in $purge_pkgs; do
        pkgs=\$(dpkg-query -W -f='\${Package} \${Status}\n' \"\$pattern\" 2>/dev/null | grep -E 'install ok installed|half-installed|triggers-awaited|unpacked' | awk '{print \$1}')
        if [ -n \"\$pkgs\" ]; then
          to_purge=\"\$to_purge \$pkgs\"
        fi
      done
      if [ -n \"\$to_purge\" ]; then
        for pkg in \$to_purge; do
          for script in prerm postrm; do
            f=\"/var/lib/dpkg/info/\${pkg}.\${script}\"
            if [ -f \"\$f\" ]; then
              sed -i 's|^#!/bin/sh|#!/bin/sh\nexit 0|; s|^#!/bin/bash|#!/bin/bash\nexit 0|' \"\$f\"
            fi
            for f_ma in /var/lib/dpkg/info/\${pkg}:*.\${script}; do
              if [ -f \"\$f_ma\" ]; then
                sed -i 's|^#!/bin/sh|#!/bin/sh\nexit 0|; s|^#!/bin/bash|#!/bin/bash\nexit 0|' \"\$f_ma\"
              fi
            done
          done
        done
        env DEBIAN_FRONTEND=noninteractive dpkg --purge \$to_purge
        env DEBIAN_FRONTEND=noninteractive apt-get install -f -y -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades
        env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -o APT::Get::AutomaticRemove=1
      fi"
      ;;
    apk)
      remove_cmd="apk del $purge_pkgs || true"
      ;;
    pacman)
      remove_cmd="to_purge=''; for p in $purge_pkgs; do if pacman -Q \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; done; if [ -n \"\$to_purge\" ]; then pacman -Rns --noconfirm \$to_purge; fi"
      ;;
    dnf)
      remove_cmd="to_purge=''; for p in $purge_pkgs; do if [[ \"\$p\" =~ ^@ ]]; then g=\"\${p#@}\"; if dnf group list installed \"\$g\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; else if dnf list installed \"\$p\" &>/dev/null; then to_purge=\"\$to_purge \$p\"; fi; fi; done; if [ -n \"\$to_purge\" ]; then dnf remove -y \$to_purge; fi"
      ;;
    xbps)
      remove_cmd="xbps-remove -Rfy $purge_pkgs 2>/dev/null || true"
      ;;
    emerge)
      remove_cmd="emerge --depclean $purge_pkgs 2>/dev/null || true"
      ;;
  esac

  print_step "Uninstalling packages inside ${distro}..."
  log "Removing DE package matching: $purge_pkgs from $distro"
  
  stub_distro_tools "$distro"

  local uninstall_status=0
  if [ "$pm" = "apt" ]; then
    run_with_spinner "Uninstalling desktop packages" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "$remove_cmd" || uninstall_status=$?
  else
    run_with_spinner "Uninstalling desktop packages" proot-distro login "$distro" -- bash -c "$remove_cmd" || uninstall_status=$?
  fi

  restore_distro_tools "$distro"

  if [ $uninstall_status -ne 0 ]; then
    print_error "Failed to uninstall desktop environment packages."
    exit 1
  fi
  
  # Verification: check if DE binary is gone, retry with full dpkg force-purge if not
  local uninstall_ok=0
  if ! de_is_installed "$distro" "$last_de"; then
    if [ $was_installed -eq 1 ]; then
      print_success "Desktop environment '${last_de}' removed from ${distro}."
    else
      print_success "Purged package remnants for '${last_de}' from ${distro}."
    fi
    config_set_distro_field "$distro" "last_de" ""
    config_set_distro_field "$distro" "installed_pkg_${last_de}" ""
    uninstall_ok=1
  else
    print_warn "Some remnants of '${last_de}' were not removed automatically. Running second-pass force cleanup..."
    log "Second-pass cleanup triggered for $last_de in $distro"

    if [ "$pm" = "apt" ]; then
      local retry_purge_pkgs
      retry_purge_pkgs=$(get_de_purge_packages "$distro" "$pm" "$last_de")
      local retry_cmd="to_purge=''
      for pattern in $retry_purge_pkgs; do
        pkgs=\$(dpkg-query -W -f='\${Package} \${Status}\n' \"\$pattern\" 2>/dev/null | grep -E 'install ok|half-installed|triggers-awaited|unpacked' | awk '{print \$1}')
        if [ -n \"\$pkgs\" ]; then
          to_purge=\"\$to_purge \$pkgs\"
        fi
      done
      if [ -n \"\$to_purge\" ]; then
        for pkg in \$to_purge; do
          for script in prerm postrm; do
            f=\"/var/lib/dpkg/info/\${pkg}.\${script}\"
            [ -f \"\$f\" ] && sed -i 's|^#!/bin/sh|#!/bin/sh\nexit 0|; s|^#!/bin/bash|#!/bin/bash\nexit 0|' \"\$f\"
            for f_ma in /var/lib/dpkg/info/\${pkg}:*.\${script}; do
              [ -f \"\$f_ma\" ] && sed -i 's|^#!/bin/sh|#!/bin/sh\nexit 0|; s|^#!/bin/bash|#!/bin/bash\nexit 0|' \"\$f_ma\"
            done
          done
        done
        env DEBIAN_FRONTEND=noninteractive dpkg --purge --force-all \$to_purge
        env DEBIAN_FRONTEND=noninteractive apt-get install -f -y -o APT::Solver=internal -o APT::Get::AutomaticRemove=0 -o APT::Get::HideAutoRemove=1 --allow-downgrades || true
        env DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -o APT::Get::AutomaticRemove=1 || true
      fi
      local startcmd=\"\${DE_STARTCMD[$last_de]}\"
      rm -f \"/usr/bin/\$startcmd\" \"/usr/local/bin/\$startcmd\" \"/bin/\$startcmd\" 2>/dev/null || true"
      stub_distro_tools "$distro"
      run_with_spinner "Second-pass force removal" proot-distro login "$distro" -- /tmp/groot-run-with-dbus.sh bash -c "$retry_cmd" || true
      restore_distro_tools "$distro"
    else
      local startcmd="${DE_STARTCMD[$last_de]}"
      proot-distro login "$distro" -- rm -f "/usr/bin/$startcmd" "/usr/local/bin/$startcmd" "/bin/$startcmd" 2>/dev/null || true
    fi

    if ! de_is_installed "$distro" "$last_de"; then
      if [ $was_installed -eq 1 ]; then
        print_success "Desktop environment '${last_de}' removed from ${distro} after second-pass cleanup."
      else
        print_success "Purged package remnants for '${last_de}' from ${distro} after second-pass cleanup."
      fi
      config_set_distro_field "$distro" "last_de" ""
      config_set_distro_field "$distro" "installed_pkg_${last_de}" ""
      uninstall_ok=1
    else
      print_error "Failed to completely remove '${last_de}' after two passes. Manual cleanup may be required."
      log "Double-pass removal failed for $last_de in $distro"
      exit 1
    fi
  fi

  if [ $uninstall_ok -eq 1 ]; then
    run_with_spinner "Cleaning up package cache and temporary user cache files" proot-distro login "$distro" -- bash -c "
      case '$pm' in
        apt)    env DEBIAN_FRONTEND=noninteractive apt-get clean &>/dev/null || true ;;
        apk)    apk cache clean &>/dev/null || true ;;
        pacman) pacman -Sc --noconfirm &>/dev/null || true ;;
        dnf)    dnf clean all &>/dev/null || true ;;
        xbps)   xbps-remove -Oy &>/dev/null || true ;;
      esac
      case '$last_de' in
        xfce4)    rm -f /usr/share/xsessions/xfce.desktop 2>/dev/null || true ;;
        lxqt)     rm -f /usr/share/xsessions/lxqt.desktop 2>/dev/null || true ;;
        mate)     rm -f /usr/share/xsessions/mate.desktop 2>/dev/null || true ;;
        kde)      rm -f /usr/share/xsessions/plasma.desktop 2>/dev/null || true ;;
        gnome)    
          rm -f /usr/share/xsessions/gnome.desktop /usr/share/xsessions/gnome-flashback-*.desktop 2>/dev/null || true
          rm -f /etc/skel/.config/autostart/plank.desktop /root/.config/autostart/plank.desktop 2>/dev/null || true
          if [ -d /home ]; then
            for u in /home/*; do
              [ -d "\$u" ] && rm -f "\$u/.config/autostart/plank.desktop" 2>/dev/null || true
            done
          fi
          ;;
        budgie)   rm -f /usr/share/xsessions/budgie-desktop.desktop 2>/dev/null || true ;;
        cinnamon) rm -f /usr/share/xsessions/cinnamon*.desktop 2>/dev/null || true ;;
        openbox)  rm -f /usr/share/xsessions/openbox.desktop 2>/dev/null || true ;;
      esac
      rm -rf /root/.cache 2>/dev/null || true
      if [ -d /home ]; then
        for u in /home/*; do
          [ -d \"\$u\" ] && rm -rf \"\$u/.cache\" 2>/dev/null || true
        done
      fi
    "
  fi
}

# -----------------------------------------------------------------------------
# Reset configuration settings for a distro
# -----------------------------------------------------------------------------
cmd_reset() {
  local distro="$1"
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to reset. Example: groot-desk reset kali"
    exit 1
  fi

  cmd_stop "$distro"

  if [ -f "$CONFIG_FILE" ]; then
    local tmpfile
    tmpfile=$(mktemp)
    if jq "del(.distros[\"${distro}\"])" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
      mv "$tmpfile" "$CONFIG_FILE"
      print_success "Reset configurations for ${distro}."
      log "Configurations reset for distro: $distro"
    else
      rm -f "$tmpfile"
      print_error "Failed to reset configurations for ${distro}."
      exit 1
    fi
  fi
}

# -----------------------------------------------------------------------------
# Delete distro completely with configurations
# -----------------------------------------------------------------------------
cmd_delete() {
  local distro="$1"
  if [ -z "$distro" ]; then
    print_error "Specify a distribution to delete. Example: groot-desk delete kali"
    exit 1
  fi

  print_warn "This will completely delete the ${distro} container, desktop environments, and all settings."
  read -rp "$(echo -e "${YELLOW}Confirm absolute deletion? [y/N]: ${RESET}")" confirm
  confirm="${confirm:-N}"
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Cancelled."
    return
  fi

  cmd_stop "$distro"

  # Remove configurations from config.json
  if [ -f "$CONFIG_FILE" ]; then
    local tmpfile
    tmpfile=$(mktemp)
    if jq "del(.distros[\"${distro}\"])" "$CONFIG_FILE" > "$tmpfile" 2>/dev/null; then
      mv "$tmpfile" "$CONFIG_FILE"
      log "Configurations wiped for distro: $distro"
    else
      rm -f "$tmpfile"
    fi
  fi

  # Uninstall container filesystem
  print_step "Removing container filesystem for ${distro}..."
  if proot-distro remove "$distro"; then
    print_success "Distribution ${distro} and its configurations deleted successfully."
    log "Distribution and configurations deleted for distro: $distro"
  else
    print_error "Failed to uninstall distribution ${distro} from proot-distro."
    exit 1
  fi
}

