# -----------------------------------------------------------------------------
# Miracast wireless display streaming with UIBC support
# -----------------------------------------------------------------------------
cmd_miracast() {
  local arg1="${1:-}"
  local arg2="${2:-}"
  local arg3="${3:-}"

  check_proot_distro

  # Case 1: No arguments or invalid sub-command -> show help and guidelines
  if [ -z "$arg1" ]; then
    print_error "Specify a target to connect via Miracast."
    echo ""
    echo -e "${BOLD}Usage:${RESET}"
    echo -e "  ${CYAN}groot-desk miracast <display_number>${RESET}"
    echo -e "      Share a currently running display via Miracast (choose 1, 2, or 3)."
    echo -e "      Example: groot-desk miracast 2"
    echo ""
    echo -e "  ${CYAN}groot-desk miracast <distro>${RESET}"
    echo -e "      Start a session and share it (defaults: last DE, wireless display)."
    echo -e "      Example: groot-desk miracast ubuntu"
    echo ""
    echo -e "  ${CYAN}groot-desk miracast <distro> <de> <display_number>${RESET}"
    echo -e "      Start a specific session and share it."
    echo -e "      Example: groot-desk miracast ubuntu xfce4 2"
    echo ""
    exit 1
  fi

  local target_port=""
  local distro=""
  local de=""
  local display=""

  # Check if first argument is a display number, port, or IP:Port format
  # Examples: 1, 2, 3, :1, :2, :3, 5900, 5901, 5902, 192.168.1.10:5901
  if [[ "$arg1" =~ :[0-9]+$ || "$arg1" =~ ^[0-9]+$ || "$arg1" =~ ^:[0-9]+$ ]]; then
    # Parse display number or port
    if [[ "$arg1" =~ :([0-9]+)$ ]]; then
      target_port="${BASH_REMATCH[1]}"
    else
      target_port="$arg1"
    fi
    
    # Strip colon if it was just :1, :2, :3
    target_port="${target_port#:}"

    # Map target_port to display number
    if [ "$target_port" = "5900" ] || [ "$target_port" = "1" ]; then
      display=":1"
    elif [ "$target_port" = "5901" ] || [ "$target_port" = "2" ]; then
      display=":2"
    elif [ "$target_port" = "5902" ] || [ "$target_port" = "3" ]; then
      display=":3"
    else
      print_error "Invalid display number or port: $target_port. Choose 1, 2, or 3."
      exit 1
    fi
    
    print_step "Locating active session running on display $display..."
    
    # Locate active distro on this display
    local found_distro=""
    local installed
    installed=$(get_installed_distros)
    
    local pids
    pids=$(pgrep -x "proot" 2>/dev/null || pgrep -f "proot" 2>/dev/null || true)
    if [ -n "$pids" ]; then
      # First pass: try exact display matching in cmdline
      while read -r pid; do
        [ -z "$pid" ] && continue
        local cmdline
        cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
        [ -z "$cmdline" ] && continue
        
        # Check if the process environment has the correct display
        if [[ "$cmdline" =~ "DISPLAY=${display}" || "$cmdline" =~ "DISPLAY= ${display}" || "$cmdline" =~ "DISPLAY=envDISPLAY=${display}" || "$cmdline" =~ "DISPLAY=x11DISPLAY=${display}" ]]; then
          while read -r d; do
            [ -z "$d" ] && continue
            if [[ "$cmdline" =~ "${d}" ]]; then
              found_distro="$d"
              break 2
            fi
          done <<< "$installed"
        fi
      done <<< "$pids"
      
      # Second pass: if display matching is inconclusive but the display port is active, fallback to any active proot distro
      if [ -z "$found_distro" ]; then
        if pgrep -f "termux-x11.*$display" &>/dev/null || pgrep -f "Xvfb.*$display" &>/dev/null; then
          while read -r pid; do
            [ -z "$pid" ] && continue
            local cmdline
            cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)
            [ -z "$cmdline" ] && continue
            
            while read -r d; do
              [ -z "$d" ] && continue
              if [[ "$cmdline" =~ "${d}" ]]; then
                found_distro="$d"
                break 2
              fi
            done <<< "$installed"
          done <<< "$pids"
        fi
      fi
    fi
    
    if [ -z "$found_distro" ]; then
      print_warn "No active background session was found running on display $display."
      print_info "To start a new session, run: groot-desk miracast <distro>"
      exit 1
    fi
    distro="$found_distro"
    
  else
    # Case 2: First argument is a distro name
    distro="$arg1"
    local installed
    installed=$(get_installed_distros)
    if ! echo "$installed" | grep -qx "$distro"; then
      print_error "Distribution '$distro' is not installed."
      print_info "Installed distributions:"
      echo "$installed" | sed 's/^/  /'
      exit 1
    fi

    # Read defaults
    de="$arg2"
    if [ -z "$de" ]; then
      de=$(config_get_distro_field "$distro" "last_de")
      de="${de:-xfce4}"
    fi

    display="$arg3"
    if [ -z "$display" ]; then
      display=":2" # default is wireless display (VNC port 5901)
    fi

    # Format display to :N format
    if [[ "$display" =~ ^[0-9]+$ ]]; then
      display=":$display"
    fi
    if [[ ! "$display" =~ ^:[1-3]$ ]]; then
      # Maybe they passed a VNC port like 5901
      if [ "$display" = "5900" ]; then display=":1"
      elif [ "$display" = "5901" ]; then display=":2"
      elif [ "$display" = "5902" ]; then display=":3"
      else
        print_error "Invalid display option: $display. Choose :1 (5900), :2 (5901), or :3 (5902)"
        exit 1
      fi
    fi

    # Start the desktop session if not already running on this display
    local d_num="${display#*:}"
    if ! pgrep -f "termux-x11.*$display" &>/dev/null && ! pgrep -f "Xvfb.*$display" &>/dev/null; then
      print_step "Starting session for $distro using $de on display $display..."
      cmd_start "$distro" "$display" "$de" "y" ""
    else
      print_info "Session for $distro is already running on display $display."
    fi
  fi

  # Now trigger Miracast connection flow and show technical parameters
  print_step "Preparing Miracast connection for display $display..."
  echo ""
  print_separator "═"
  echo -e "${BOLD}${WHITE} 📶 WIRELESS DISPLAY / MIRACAST CASTING${RESET}"
  print_separator "─"
  print_wrapped "  " "${WHITE}" "The system is launching the native Android wireless display casting panel."
  echo ""
  print_wrapped "  " "${GRAY}" "1. Make sure the Miracast sink (TV, external monitor, or cast target) is active."
  print_wrapped "  " "${GRAY}" "2. When the Android Cast Settings panel opens, select the target display device."
  print_wrapped "  " "${GRAY}" "3. Desktop display $display will project instantly."
  print_separator "═"
  echo ""

  # Launch casting settings
  if ! am start --user 0 -a android.settings.CAST_SETTINGS >> "$LOG_FILE" 2>&1; then
    if ! am start --user 0 -n com.android.settings/.wfd.WifiDisplaySettings >> "$LOG_FILE" 2>&1; then
      print_error "Failed to launch Android wireless display settings automatically."
      print_info "Open Android Settings manually and go to: Connection & Sharing -> Cast or Wireless Display."
      exit 1
    fi
  fi
  print_success "Wireless display settings launched."
}

