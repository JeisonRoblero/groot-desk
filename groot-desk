check_proot_distro() {
  if ! command -v proot-distro &>/dev/null; then
    print_warn "proot-distro is not installed."
    run_with_spinner "Installing proot-distro" pkg install proot-distro -y
    if [ $? -ne 0 ]; then
      print_error "Failed to install proot-distro. Run: pkg install proot-distro"
      exit 1
    fi
  fi

  # For custom OCI distro installs, v5 is required
  # Check if caller flagged that v5 is needed
  if [ "${REQUIRE_PROOT_V5:-0}" = "1" ] && ! is_proot_distro_v5; then
    print_warn "proot-distro v5 or later is required to install custom distributions."
    read -rp "$(echo -e "${YELLOW}Upgrade proot-distro to v5 now? [Y/n]: ${RESET}")" confirm
    confirm="${confirm:-Y}"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      print_error "Cannot continue without proot-distro v5. Run: pkg upgrade proot-distro"
      exit 1
    fi
    run_with_spinner "Upgrading proot-distro" pkg install proot-distro -y
    if [ $? -ne 0 ]; then
      print_error "Failed to upgrade proot-distro. Run: pkg upgrade proot-distro"
      exit 1
    fi
    if ! is_proot_distro_v5; then
      print_error "proot-distro v5 still not detected after upgrade. Run: pkg upgrade proot-distro"
      exit 1
    fi
    print_success "proot-distro upgraded to v5 successfully."
  fi
}

