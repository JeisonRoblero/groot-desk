            if [ -f /etc/apt/apt.conf.d/90_zsys_system_autosnapshot ]; then
              sed -i 's/^DPkg::Pre-Invoke/# DPkg::Pre-Invoke/g; s/^DPkg::Post-Invoke/# DPkg::Post-Invoke/g' /etc/apt/apt.conf.d/90_zsys_system_autosnapshot
            fi
